// ============================================================================
// LES EXTRAS v3 — Schéma Prisma
// Marketplace médico-social : FREELANCE × ESTABLISHMENT
// Multi-comptes (Account) + sous-comptes (Membership) + invitations
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITÉ & MULTI-COMPTES
// ---------------------------------------------------------------------------

/// Une personne physique (identité de connexion).
model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  firstName           String?
  lastName            String?
  phone               String?
  avatarUrl           String?
  /// Photo de profil déposée (prioritaire sur avatarUrl quand elle existe).
  avatarFileId        String?
  avatarFile          FileAsset? @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  /// Rôle global plateforme (pas le rôle DANS un compte).
  role                GlobalRole @default(USER)
  status              UserStatus @default(PENDING)
  emailVerified       Boolean    @default(false)
  onboardingStep      Int        @default(0)
  /// Connexion LinkedIn (partage d'articles). Jeton conservé côté serveur
  /// uniquement, jamais exposé au navigateur.
  linkedinUrn         String?
  linkedinAccessToken String?
  linkedinExpiresAt   DateTime?
  linkedinName        String?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  profile                   Profile?
  memberships               Membership[]
  sentInvitations           Invitation[]              @relation("InvitationInviter")
  ownedAccounts             Account[]                 @relation("AccountOwner")
  documents                 Document[]
  uploadedFiles             FileAsset[]               @relation("FileUploader")
  notifications             Notification[]
  supportTickets            SupportTicket[]           @relation("SupportAuteur")
  supportMessages           SupportMessage[]          @relation("SupportMessageAuteur")
  rendezVous                RendezVous[]              @relation("RendezVousAuteur")
  messages                  Message[]
  reviewsAuthored           Review[]                  @relation("ReviewAuthor")
  reviewsReceived           Review[]                  @relation("ReviewTarget")
  availabilities            Availability[]
  shiftsAssigned            Shift[]                   @relation("ShiftFreelance")
  authoredArticles          Article[]                 @relation("ArticleAuthor")
  sessionsTrained           FormationSession[]        @relation("SessionTrainer")
  inscriptions              Inscription[]             @relation("InscriptionLearner")
  tutoratsGiven             Tutorat[]                 @relation("TutoratTutor")
  complianceDocuments       ComplianceDocument[]
  qualifications            Qualification[]
  experiences               Experience[]
  auditLogs                 AuditLog[]                @relation("AuditActor")
  /// Rendez-vous hebdomadaire du lundi. Activé par défaut, désactivable en un
  /// clic : un e-mail non désiré coûte plus cher qu'un e-mail non envoyé.
  hebdoOptIn                Boolean                   @default(true)
  /// COURRIEL DE NOTIFICATION (09/09/2026).
  /// Les notifications qui appellent une action ou qui rassurent sont doublees
  /// d'un courriel. Personne n'ouvre tous les jours une plateforme qu'il
  /// n'utilise pas encore : sans cela, une demande recue restait invisible
  /// jusqu'a la prochaine visite. Desactivable en un clic, comme le lundi.
  notifMailOptIn            Boolean                   @default(true)
  /// E-mail d'activation du lendemain de l'inscription (ActivationScheduler).
  /// Non nul = la décision d'envoyer (ou de s'abstenir) a été prise : elle ne
  /// se reprend jamais, ce message n'existe qu'une fois dans la vie du compte.
  activationMailAt          DateTime?
  /// TUNNEL D'ACCUEIL (TunnelScheduler, 03/09/2026).
  /// Numéro du dernier message envoyé, de 0 (aucun) à la longueur de la
  /// séquence. C'est un COMPTEUR, pas une date : il rend l'envoi idempotent
  /// même si le planificateur passe deux fois, et il survit à un décalage
  /// (une panne d'un jour reprend là où la séquence s'était arrêtée, elle ne
  /// saute pas un message).
  tunnelEtape               Int                       @default(0)
  /// Date du dernier message du tunnel. C'est elle qui espace la séquence :
  /// on n'écrit jamais deux fois dans le même intervalle, quoi qu'il arrive.
  tunnelDernierAt           DateTime?
  retours                   RetourExperience[]
  alertesRecherche          AlerteRecherche[]
  favorites                 Favorite[]
  assistantDocuments        AssistantDocument[]
  /// Générations LEX imputées à cette personne (journal de /confiance-lex).
  creditLedger              CreditLedger[]
  tramesMaison              TrameMaison[]
  lexPreferences            LexPreference[]
  pushSubscriptions         PushSubscription[]
  leaveRequests             LeaveRequest[]            @relation("LeaveUser")
  contratsCDD               ContratCDD[]              @relation("ContratSalarie")
  /// Ajouts au vivier effectues par cette personne.
  ajoutsAuVivier            PoolMember[]              @relation("PoolAjoutePar")
  /// Signatures electroniques apposees par cette personne.
  signatures                Signature[]               @relation("SignatureSignataire")
  /// Demandes de rattachement à un établissement envoyées par cette personne
  /// (compte « salarié » créé en solo, en attente de confirmation).
  attachmentRequestsSent    AttachmentRequest[]       @relation("AttachmentRequester")
  /// Demandes de rattachement tranchées (acceptées/refusées) par cette personne.
  attachmentRequestsDecided AttachmentRequest[]       @relation("AttachmentDecider")
  /// Services d'établissement créés par cette personne.
  servicesCrees             OrgUnit[]                 @relation("OrgUnitCreateur")
  /// Rattachements dont cette personne a vérifié l'appartenance au service.
  rattachementsVerifies     Membership[]              @relation("MembershipVerificateur")
  /// Demandes de niveau tranchées par cette personne (Direction, Les Extras).
  demandesNiveauDecidees    DemandeNiveau[]           @relation("DemandeNiveauDecideur")
  /// Demandes portant sur un service (rejoindre, signaler) émises par elle.
  demandesServiceEmises     DemandeService[]          @relation("DemandeServiceDemandeur")
  /// Demandes portant sur un service tranchées par elle.
  demandesServiceDecidees   DemandeService[]          @relation("DemandeServiceDecideur")
  /// Fils de discussion auxquels cette personne participe.
  participations            ConversationParticipant[]
  /// Fils de discussion ouverts par cette personne.
  conversationsOuvertes     Conversation[]            @relation("ConversationCreateur")
  /// Messages signalés par cette personne.
  messagesSignales          Message[]                 @relation("MessageSignaleur")

  @@index([email])
  @@index([role, status])
}

/// Données étendues d'un utilisateur (surtout côté FREELANCE).
model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio        String?
  job        String? // Éducateur spécialisé, Moniteur-éducateur, EJE, AES...
  skills     String[] @default([])
  siret      String?
  diplomaUrl String?
  city       String?
  postalCode String?
  radiusKm   Int?     @default(30)
  hourlyRate Decimal? @db.Decimal(8, 2)
  available  Boolean  @default(true)
  /// LIENS PUBLICS DE L'INTERVENANT (09/09/2026).
  /// Site, LinkedIn, Instagram, page Facebook, chaine YouTube, TikTok : ce qui
  /// permet a un etablissement de VOIR le travail avant de reserver. Liste
  /// libre plutot qu'une colonne par reseau : les reseaux changent, la
  /// colonne resterait. Facultatif, comme tout le reste du profil.
  liens      String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Un COMPTE (tenant). Soit une organisation ESTABLISHMENT (ex: une MECS),
/// soit le compte individuel d'un FREELANCE. Peut avoir plusieurs membres.
model Account {
  id                      String         @id @default(cuid())
  name                    String
  type                    AccountType
  /// Validation hierarchique : si active, une mission publiee par un MANAGER
  /// attend l'approbation d'un OWNER/ADMIN avant diffusion.
  validationMissions      Boolean        @default(false)
  /// Parrainage : compte intervenant qui a invite celui-ci (fige a l'inscription).
  parrainAccountId        String?
  /// Profil SALARIE, choisi a l'inscription et fige ensuite.
  ///
  /// La tuile « Salarie » existait a l'ecran mais ne survivait pas au clic :
  /// elle creait un compte FREELANCE ordinaire et le drapeau restait dans
  /// l'etat React. Le compte etait donc, en droits, celui d'un independant.
  ///
  /// Un salarie n'exerce pas pour son compte : il travaille pour une maison.
  /// Tant qu'aucun etablissement ne l'a rattache, son compte n'ouvre que LEX
  /// et sa demande de rattachement (`AttachmentRequest`). Le rattachement se
  /// fait par Membership, et une meme adresse peut en avoir plusieurs.
  profilSalarie           Boolean        @default(false)
  slug                    String         @unique
  /// Attribution — d'où vient ce compte. Renseigné une fois, à l'inscription,
  /// et jamais modifié ensuite : c'est la campagne qui a amené la personne.
  /// utm_source, sinon domaine référent, sinon « direct ».
  source                  String?
  /// utm_medium : cpc, social, email, referral...
  sourceMedium            String?
  /// utm_campaign : nom de l'annonce, pour comparer deux créations.
  sourceCampaign          String?
  /// Page d'arrivée : sait-on vers quoi l'annonce pointait.
  sourceLanding           String?
  /// STRUCTURE DE RATTACHEMENT — l'entité juridique qui possède cet
  /// établissement (association, fondation, mairie, groupe). Déclarative :
  /// le compte dit à quelle structure il appartient, comme on déclare son
  /// employeur sur un réseau professionnel. Facultative, et elle le reste :
  /// un intervenant indépendant n'en a pas, une petite association est sa
  /// propre structure.
  structureId             String?
  structure               Structure?     @relation(fields: [structureId], references: [id], onDelete: SetNull)
  // Coordonnées structure
  legalName               String?
  siret                   String?
  address                 String?
  city                    String?
  postalCode              String?
  phone                   String?
  /// Mention de TVA à afficher sur les factures émises par ce compte (ex.
  /// « TVA non applicable, art. 293 B du CGI » ou « TVA 20 % — n° FR... »).
  /// Laissé vide, la mention par défaut (non assujetti) reste affichée : elle
  /// est vraie pour la grande majorité des comptes (auto-entrepreneurs en
  /// franchise en base, association ADéPA), mais un émetteur assujetti à la
  /// TVA doit pouvoir la corriger lui-même plutôt que de laisser un taux faux.
  vatMention              String?
  /// Coordonnées bancaires de l'émetteur, imprimées dans la section
  /// « Règlement » de ses factures. Le produit annonce un règlement par
  /// virement, mais aucun champ ne portait l'IBAN : la facture partait donc
  /// sans le moyen de la payer.
  ///
  /// FACULTATIFS, et ils doivent le rester : la plateforme n'a pas à exiger
  /// un IBAN de tous ses comptes. Un établissement qui ne fait que recevoir
  /// des factures n'en a pas besoin, un intervenant peut préférer joindre son
  /// RIB par un autre canal, et les comptes déjà en base n'en ont pas. Quand
  /// l'IBAN est vide, le bloc « Règlement » ne l'affiche simplement pas — on
  /// n'invente jamais de coordonnées, et surtout pas celles d'un tiers.
  ///
  /// Donnée à diffusion maîtrisée : ne l'exposer que dans les réponses déjà
  /// réservées aux parties de la facture (émetteur, payeur, administration),
  /// jamais dans le catalogue public ni dans une liste de comptes.
  iban                    String?
  /// BIC de la banque. Facultatif même quand l'IBAN est renseigné : il n'est
  /// plus exigé pour un virement SEPA à l'intérieur de l'Espace européen.
  bic                     String?
  /// Adresse de contact publique du compte. Pour un compte intervenant créé
  /// depuis un poste salarié, c'est OBLIGATOIREMENT un contact personnel : les
  /// sollicitations d'activité indépendante ne doivent jamais arriver sur la
  /// messagerie de l'employeur.
  contactEmail            String?
  logoUrl                 String?
  // Crédits LEX : un crédit = une génération (voir CreditsService).
  credits                 Int            @default(0)
  /// Accès LEX illimité accordé à la main (exonération de crédits).
  isMember                Boolean        @default(false)
  /// Essai Découverte : recharge quotidienne gratuite jusqu'à cette date.
  /// Non nul = l'essai a été utilisé (il ne se réclame qu'une fois).
  lexTrialEndsAt          DateTime?
  /// Taux de commission ADéPA appliqué aux prestations externes de ce compte
  /// (null = taux par défaut de la plateforme). Modèle prestataire : ADéPA
  /// facture l'établissement, l'intervenant facture ADéPA.
  commissionRate          Decimal?       @db.Decimal(5, 4)
  /// Solde de points de fidélité (10 points = 1 € de réduction).
  points                  Int            @default(0)
  /// LE COMPTE STRIPE DE CET ORGANISME (Stripe Connect).
  ///
  /// Tant qu'il est vide, une vente est encaissée sur le compte Stripe de la
  /// plateforme : c'est le fonctionnement historique, et il reste valable
  /// pour ADéPA elle-même. Dès qu'un organisme relie le sien, l'argent de ses
  /// ventes lui est viré directement — la plateforme ne le détient jamais.
  stripeCompteId          String?
  /// Vrai seulement quand Stripe déclare le compte capable d'encaisser. On ne
  /// le déduit jamais de la seule existence de l'identifiant : un dossier
  /// commencé et abandonné laisse un compte créé mais inutilisable.
  stripeComptePret        Boolean        @default(false)
  /// Ce que la plateforme retient sur chaque vente encaissée pour ce compte,
  /// en pour cent. À zéro, rien n'est retenu — et les frais du prestataire de
  /// paiement restent alors à la charge de la plateforme.
  commissionVentePourcent Int            @default(0)
  ownerId                 String
  owner                   User           @relation("AccountOwner", fields: [ownerId], references: [id])
  articles                Article[]      @relation("AccountArticles")
  loyaltyPoints           LoyaltyPoint[]
  ideas                   Idea[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  /// Date d'envoi de l'ENQUÊTE de satisfaction « première mise en ligne ».
  /// Non nul = déjà partie, on ne redemande pas. Voir `enquete.scheduler.ts` :
  /// c'est un verrou, pas un calendrier — il est posé AVANT l'envoi.
  enqueteAtelierAt DateTime?
  retours          RetourExperience[]
  alertesRecherche AlerteRecherche[]

  /// CE QUE LA PERSONNE VEUT FAIRE ICI, déclaré à l'inscription.
  ///
  /// Ce n'est pas une statistique : ces cases décident de ce que le compte
  /// voit — les demandes qui lui arrivent, les alertes, les rubriques de son
  /// espace — et elles décident du MONTAGE sur lequel il peut s'engager.
  ///
  /// ⚠ VIDE VEUT DIRE « PAS ENCORE DÉCLARÉ », PAS « RIEN ». Tous les comptes
  /// créés avant cette liste l'ont vide : aucune règle ne doit refuser quoi
  /// que ce soit sur une liste vide, sinon on ferme le produit à tout le
  /// monde d'un coup. On ne restreint que sur un choix explicitement fait.
  interets      Interet[]
  disponibilite DisponibiliteRenfort?

  memberships                   Membership[]
  invitations                   Invitation[]
  reliefMissions                ReliefMission[]      @relation("MissionAccount")
  leaveRequests                 LeaveRequest[]
  services                      Service[]            @relation("ServiceAccount")
  bookings                      Booking[]
  invoices                      Invoice[]
  /// Les factures adressees a ce compte (formation, prestation) sans qu'il en
  /// soit l'emetteur.
  facturesAPayer                Invoice[]            @relation("InvoicePayer")
  creditLedger                  CreditLedger[]
  shifts                        Shift[]
  formationsOwned               Formation[]          @relation("FormationOwner")
  sessionsHosted                FormationSession[]   @relation("SessionHost")
  inscriptionsPaid              Inscription[]        @relation("InscriptionPayer")
  qualiopiProofs                QualiopiProof[]      @relation("QualiopiOf")
  complianceDocuments           ComplianceDocument[]
  orgUnits                      OrgUnit[]
  auditLogs                     AuditLog[]           @relation("AuditAccount")
  /// Le vivier de cet etablissement : les intervenants qu'il veut revoir.
  vivier                        PoolMember[]         @relation("PoolEtablissement")
  /// Les etablissements qui ont place cet intervenant dans leur vivier.
  vivierDe                      PoolMember[]         @relation("PoolIntervenant")
  /// Les regles de temps de travail lues dans SA convention collective.
  parametresTemps               ParametresTemps?
  /// Demandes de signature electronique emises par ce compte.
  signatures                    Signature[]          @relation("SignatureCompte")
  /// Les missions que ce compte intervenant s'est engage a prendre.
  engagements                   MissionEngagement[]  @relation("EngagementIntervenant")
  /// Les modeles d'ecrits appris dans ce compte.
  tramesMaison                  TrameMaison[]
  lexPreferences                LexPreference[]
  lexMots                       LexMot[]
  lexPseudonymes                LexPseudonyme[]
  uploadedFiles                 FileAsset[]          @relation("FileAccount")
  creditPurchases               CreditPurchase[]
  subscription                  Subscription?
  quotesAsClient                Quote[]              @relation("QuoteClient")
  quotesAsProvider              Quote[]              @relation("QuoteProvider")
  assistantDocuments            AssistantDocument[]
  contratsCDD                   ContratCDD[]
  /// Demandes envoyées par CE compte pour se rattacher à un établissement
  /// (compte individuel « salarié » créé en solo, côté freelance en attendant).
  attachmentRequestsAsRequester AttachmentRequest[]  @relation("AttachmentRequesterAccount")
  /// Demandes de rattachement reçues par CET établissement (à approuver/refuser).
  attachmentRequestsReceived    AttachmentRequest[]  @relation("AttachmentTarget")
  organisation                  Organisation?
  /// Piloter mon academie : la fiche de l'organisme de formation.
  academie                      Academie?
  /// Les formulaires que le compte compose lui-meme (les deux espaces).
  formulaires                   Formulaire[]
  /// L'ecole en ligne de l'academie : les cours, ce qui se vend, qui apprend.
  cours                         Cours[]              @relation("CoursCompte")
  packs                         PackCours[]
  codesPromo                    CodePromo[]
  ventesCours                   VenteCours[]
  classesVirtuelles             ClasseVirtuelle[]
  ecoleEnLigne                  EcoleEnLigne?
  affilies                      Affilie[]
  /// La boutique de l'association : ce qu'elle vend en dehors des formations.
  boutique                      Boutique?
  produitsBoutique              ProduitBoutique[]
  commandesBoutique             CommandeBoutique[]
  /// Les ateliers payes en ligne sur les fiches de cet intervenant.
  reservationsAteliers          ReservationAtelier[]
  supportTickets                SupportTicket[]
  rendezVous                    RendezVous[]
  /// Les fils de discussion rattachés à ce compte (interne, service, demande).
  conversations                 Conversation[]
  /// Demandes portant sur un service de cet établissement.
  demandesService               DemandeService[]

  /// ARCHIVÉ — le compte existe, il ne se voit plus.
  ///
  /// ⚠⚠ C'EST L'ALTERNATIVE À LA SUPPRESSION, ET C'EST POUR ÇA QU'ELLE EXISTE.
  /// Il n'y avait aucun moyen de retirer un compte de la vue sans le détruire :
  /// comptes de test des audits, doublons homonymes, second compte d'une même
  /// association. La seule sortie était `DELETE /admin/accounts/:id`, qui
  /// supprime en cascade les fiches, les missions, les réservations ET LES
  /// FACTURES — or une facture émise ne se supprime pas (art. 242 nonies A,
  /// ann. II du CGI).
  ///
  /// Archiver retire le compte des recherches et de la vitrine publique, et
  /// rien d'autre : les données restent, l'opération se défait d'un clic.
  ///
  /// ⚠ CE N'EST PAS UNE SUSPENSION D'ACCÈS. Un compte archivé dont quelqu'un a
  /// encore le mot de passe se connecte normalement — archiver répond à « on ne
  /// veut plus le voir », pas à « on ne veut plus qu'il entre ». Confondre les
  /// deux ferait mettre dehors, sans le vouloir, l'équipe d'un établissement
  /// qu'on voulait seulement sortir d'un annuaire.
  archivedAt DateTime?

  /// SUPPRIMER, C'EST ARCHIVER TROIS MOIS — décision de Siham, 16/09/2026.
  ///
  /// ⚠⚠ `DELETE /admin/accounts/:id` NE DÉTRUIT PLUS RIEN LE JOUR OÙ ON CLIQUE.
  /// Il archive le compte (il disparaît des recherches, de l'annuaire, de la
  /// vitrine et de la place de marché) et pose ici la date à laquelle il sera
  /// réellement supprimé. Pendant tout ce délai, « Rétablir » annule les deux
  /// et le compte revient exactement comme il était.
  ///
  /// Ce que cela répare : la suppression était immédiate et définitive, sur un
  /// bouton qu'on clique en croyant ranger. Trois mois, c'est le temps qu'il
  /// faut pour que quelqu'un s'aperçoive qu'un compte manque.
  ///
  /// ⚠ NULL NE VEUT PAS DIRE « JAMAIS SUPPRIMÉ » : il veut dire « aucune
  /// suppression programmée ». Un compte simplement archivé a `archivedAt`
  /// rempli et ce champ nul — il reste indéfiniment, c'est le cas des comptes
  /// de test et des doublons.
  suppressionPrevueLe DateTime?

  /// POURQUOI L'ÉCHÉANCE N'A PAS PU ÊTRE EXÉCUTÉE.
  ///
  /// ⚠⚠ UN COMPTE QUI A ÉMIS UNE FACTURE OU SIGNÉ UN CDD NE PEUT PAS ÊTRE
  /// SUPPRIMÉ, ET AUCUN DÉLAI N'Y CHANGE RIEN. `Invoice` et `ContratCDD` sont
  /// en `onDelete: Cascade` : détruire le compte détruirait les documents. Or
  /// une facture émise se conserve (art. 242 nonies A, ann. II du CGI ; art.
  /// L123-22 du code de commerce : dix ans) et un contrat de travail aussi.
  ///
  /// Le planificateur écrit donc ici, en toutes lettres, ce qui l'a arrêté —
  /// « 3 facture(s) émise(s) » — et l'écran d'administration l'affiche. Sans
  /// cette phrase, le compte resterait indéfiniment « à supprimer » sans que
  /// personne ne sache pourquoi, et quelqu'un finirait par forcer.
  suppressionMotifBlocage String?

  @@index([type])
  @@index([slug])
  @@index([source])
  @@index([structureId])
  @@index([archivedAt])
  /// Le planificateur balaie sur cette colonne, une fois par jour.
  @@index([suppressionPrevueLe])
}

/// Unité / service d'un établissement (repris de Symfony : Service/unités).
/// Ex. « Internat », « Pôle jour », « SESSAD ». Rattache membres et missions.
model OrgUnit {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  /// CLÉ D'UNICITÉ, pas un libellé : minuscules, accents retirés, ponctuation
  /// et espaces supprimés. Dans un même établissement il ne peut pas y avoir
  /// deux services du même nom — et sans normalisation, « SESSAD », « Sessad »
  /// et « S.E.S.S.A.D. » passeraient tous les trois. Le nom affiché reste
  /// `name`, avec sa casse et ses accents.
  nomNormalise String    @default("")
  description  String?
  /// Qui a créé ce service. Sert à router une demande de rattachement quand
  /// un second arrivant tombe sur un nom déjà pris.
  creeParId    String?
  creePar      User?     @relation("OrgUnitCreateur", fields: [creeParId], references: [id], onDelete: SetNull)
  /// Service archivé : il ne se propose plus à la création ni à l'invitation,
  /// mais il n'est pas supprimé — son historique reste lisible.
  archiveLe    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships        Membership[]
  missions           ReliefMission[]
  shifts             Shift[]
  invitations        Invitation[]
  membres            MembershipService[]
  servicesInvitation InvitationService[]
  demandes           DemandeService[]
  conversations      Conversation[]

  @@unique([accountId, nomNormalise])
  @@index([accountId])
}

/// SOUS-COMPTE : rattachement d'un User à un Account avec un rôle interne.
///
/// NIVEAU DE RESPONSABILITÉ ET VISIBILITÉ (16/09/2026)
/// ---------------------------------------------------
/// Une règle, une seule, gouverne ce que chacun voit :
///
///   je vois les gens que j'ai fait venir  →  aucune validation
///   je vois des gens que je n'ai pas fait venir  →  validation
///
/// Un chef de service qui arrive seul n'attend donc personne : il crée ses
/// services, il invite son équipe, il ne voit qu'elle. Un imposteur qui se
/// déclarerait responsable ne pourrait constituer un périmètre qu'avec des
/// gens ayant accepté son invitation — il ne prend rien, il reçoit.
///
/// Seul le niveau DIRECTION échappe à cette règle, parce qu'il donne la vue
/// sur des équipes constituées par d'autres, avant lui. C'est le seul qui
/// passe par une validation (Les Extras, ou une Direction déjà en place).
model Membership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      AccountRole      @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  /// Service principal de rattachement. Conservé pour tout l'existant (plannings,
  /// missions, invitations) ; le rattachement multiple et l'encadrement de
  /// plusieurs services passent par `services` (MembershipService).
  orgUnitId String?
  orgUnit   OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  /// NIVEAU DÉCLARÉ. Il ne produit aucun droit à lui seul.
  niveau       NiveauResponsabilite @default(SALARIE)
  /// Vrai quand le niveau a été validé. Obligatoire pour que DIRECTION ouvre
  /// quoi que ce soit ; sans validation, une Direction déclarée voit
  /// exactement ce que voit un salarié : elle-même.
  niveauValide Boolean              @default(false)
  /// Intitulé de poste, libre : « Chef de service éducatif », « Coordinatrice ».
  poste        String?
  cadre        Boolean              @default(false)

  /// VÉRIFIÉ = LE RATTACHEMENT, JAMAIS LE TITRE.
  /// Ce drapeau dit « cette personne est bien dans ce service », parce qu'elle
  /// y a été invitée ou validée. Il ne dit rien du poste qu'elle déclare : un
  /// collègue qui invite quelqu'un ne le nomme pas directeur. L'organigramme
  /// doit afficher les deux séparément, sous peine de faire passer une
  /// vérification d'appartenance pour une validation de titre.
  verifie             Boolean              @default(false)
  origineVerification OrigineVerification?
  verifieParId        String?
  verifiePar          User?                @relation("MembershipVerificateur", fields: [verifieParId], references: [id], onDelete: SetNull)
  verifieLe           DateTime?

  /// QUI A FAIT VENIR CETTE PERSONNE. C'est la source de la visibilité : le
  /// périmètre d'un invité est toujours inclus dans celui de son invitant, et
  /// ne peut jamais en sortir.
  parrainMembershipId String?
  parrain             Membership?  @relation("MembershipParrainage", fields: [parrainMembershipId], references: [id], onDelete: SetNull)
  invites             Membership[] @relation("MembershipParrainage")

  /// Droits accordés à l'unité, en plus de ce que donne le niveau.
  /// On ne délègue que ce que l'on détient, et seulement sur son périmètre.
  capacites Capacite[]

  /// Retrait de l'organigramme. La personne garde tout le reste du produit :
  /// certaines ont de vraies raisons de ne pas figurer dans un annuaire, et
  /// une seule mauvaise histoire coûte plus cher que quelques absents.
  masqueOrganigramme Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services       MembershipService[]
  demandesNiveau DemandeNiveau[]

  @@unique([userId, accountId])
  @@index([accountId, role])
  @@index([accountId, niveau])
  @@index([parrainMembershipId])
}

/// RATTACHEMENT D'UN MEMBRE À UN SERVICE, avec la portée.
///
/// Deux choses différentes que `Membership.orgUnitId` seul ne savait pas dire :
/// « je travaille dans ce service » et « j'encadre ce service ». Un
/// coordinateur peut être rattaché au Pôle jour et encadrer le Pôle jour ET
/// le SESSAD — c'est ce que la table rend possible.
model MembershipService {
  id           String        @id @default(cuid())
  membershipId String
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  orgUnitId    String
  orgUnit      OrgUnit       @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  portee       PorteeService @default(RATTACHEMENT)
  createdAt    DateTime      @default(now())

  @@unique([membershipId, orgUnitId, portee])
  @@index([orgUnitId, portee])
}

/// INVITATION à rejoindre un compte (par email), avec rôle cible + token.
model Invitation {
  id          String               @id @default(cuid())
  email       String
  accountId   String
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role        AccountRole          @default(MEMBER)
  /// SERVICE d'affectation, choisi au moment de l'invitation.
  /// Sans lui, un nouvel arrivant n'apparaissait dans le planning d'aucun chef
  /// de service tant qu'un responsable ne pensait pas à le rattacher à la main
  /// — ce que personne ne fait, parce que rien ne le rappelle.
  orgUnitId   String?
  orgUnit     OrgUnit?             @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  /// Niveau proposé à la personne invitée. Un invitant ne peut jamais proposer
  /// plus haut que le sien.
  niveau      NiveauResponsabilite @default(SALARIE)
  /// Droits accordés avec l'invitation, pris dans ceux de l'invitant.
  capacites   Capacite[]
  /// Mot d'accompagnement, affiché dans le courriel d'invitation.
  message     String?
  token       String               @unique @default(cuid())
  status      InvitationStatus     @default(PENDING)
  invitedById String
  invitedBy   User                 @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime             @default(now())

  services InvitationService[]

  @@unique([email, accountId])
  @@index([token])
  @@index([status])
}

/// Les services portés par une invitation, avec leur portée : on peut inviter
/// quelqu'un à travailler dans un service ET à en encadrer un autre.
model InvitationService {
  id           String        @id @default(cuid())
  invitationId String
  invitation   Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  orgUnitId    String
  orgUnit      OrgUnit       @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  portee       PorteeService @default(RATTACHEMENT)

  @@unique([invitationId, orgUnitId, portee])
  @@index([orgUnitId])
}

/// DEMANDE DE RATTACHEMENT : le sens inverse de Invitation. Une personne
/// s'inscrit seule en tant que « salarié » (compte requesterAccount de type
/// FREELANCE, mêmes droits qu'un intervenant tant que rien n'est confirmé),
/// puis demande à rejoindre un établissement qu'elle choisit elle-même.
/// L'établissement voit la demande côté Équipe et l'accepte ou la refuse.
/// À l'acceptation : création d'un Membership (rôle MEMBER) sur le compte
/// établissement — la personne garde aussi son compte individuel, comme pour
/// n'importe quel multi-compte de la plateforme.
model AttachmentRequest {
  id String @id @default(cuid())

  requesterUserId String
  requesterUser   User   @relation("AttachmentRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  /// Le compte FREELANCE personnel de la personne qui demande — pas un
  /// compte établissement : on ne rattache pas un établissement à un autre.
  requesterAccountId String
  requesterAccount   Account @relation("AttachmentRequesterAccount", fields: [requesterAccountId], references: [id], onDelete: Cascade)

  establishmentAccountId String
  establishmentAccount   Account @relation("AttachmentTarget", fields: [establishmentAccountId], references: [id], onDelete: Cascade)

  /// Mot court, facultatif, affiché à l'établissement (« Je suis moniteur-éducateur à l'internat depuis 2022 »).
  message String?

  status AttachmentRequestStatus @default(PENDING)

  decidedById String?
  decidedBy   User?     @relation("AttachmentDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une demande en attente à la fois vers un même établissement : renvoyer un
  // doublon écrase la précédente plutôt que d'empiler des lignes identiques.
  @@unique([requesterAccountId, establishmentAccountId])
  @@index([establishmentAccountId, status])
  @@index([requesterUserId])
}

enum AttachmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// STRUCTURE → ÉTABLISSEMENT → SERVICE  (16/09/2026)
// ---------------------------------------------------------------------------
//
// Trois niveaux, aucun obligatoire. Un compte DÉCLARE son appartenance, comme
// on déclare son employeur sur un réseau professionnel : rien n'est validé en
// amont, parce qu'une validation en amont fait chuter les inscriptions et que
// personne ici n'a les moyens humains de valider chaque salarié qui arrive.
//
// Ce qui rend l'ouverture tenable, ce n'est pas le contrôle à l'entrée, c'est
// que déclarer ne donne rien : la visibilité vient du lien d'invitation, pas
// du niveau déclaré. Voir la note sur le modèle Membership.

/// L'ENTITÉ JURIDIQUE qui possède un ou plusieurs établissements : association,
/// fondation, mairie, groupe. Retrouvée dans l'annuaire public des entreprises
/// quand c'est possible (recherche-entreprises.api.gouv.fr, déjà utilisé côté
/// association), saisie à la main sinon.
model Structure {
  id             String   @id @default(cuid())
  nom            String
  /// Clé de rapprochement, pas un libellé : deux structures ne peuvent pas la
  /// partager. Voir OrgUnit.nomNormalise pour la règle.
  nomNormalise   String   @unique
  /// Numéro SIREN à 9 chiffres quand la structure vient de l'annuaire public.
  siren          String?  @unique
  /// SIRET du siège, 14 chiffres — les 9 du SIREN suivis des 5 du siège.
  ///
  /// ⚠ IL N'EST PAS UNIQUE, ET C'EST VOLONTAIRE. Le SIREN l'est déjà, et
  /// c'est lui qui dédoublonne. Poser une seconde contrainte d'unicité ferait
  /// échouer une saisie manuelle maladroite par une erreur de base illisible,
  /// là où le rapprochement par SIREN a déjà fait le travail.
  ///
  /// C'est ce numéro-là qui s'imprime sur les factures d'un intervenant : une
  /// facture porte le SIRET de l'établissement qui émet, pas le SIREN.
  siret          String?
  formeJuridique String?
  adresse        String?
  ville          String?
  codePostal     String?
  /// Vrai quand la fiche provient de l'annuaire public et n'a pas été saisie
  /// à la main. Une structure saisie à la main reste parfaitement utilisable :
  /// beaucoup de petites structures ne se trouvent pas dans l'annuaire.
  verifiee       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comptes Account[]

  @@index([nomNormalise])
}

/// CE QU'UNE PERSONNE VIENT FAIRE — déclaré, jamais deviné.
///
/// ⚠ LES DEUX DERNIÈRES VALEURS SONT DEUX MONTAGES JURIDIQUES DIFFÉRENTS, ET
/// C'EST TOUTE LA RAISON DE CETTE ÉNUMÉRATION.
///
/// Remplacer quelqu'un sur un poste, dans le planning d'un établissement, ne
/// se fait qu'en CDD : le Conseil d'État l'a tranché le 11/02/2025 (n° 491128,
/// affaire Mediflash) et la LFSS 2025 a resserré l'intérim en ESSMS. Un
/// indépendant qui facturerait un remplacement de poste, c'est une
/// requalification pour lui et un risque de travail dissimulé pour la maison.
///
/// Intervenir EN PLUS, sur un besoin nommé — un enfant à accompagner sur ses
/// sorties, un groupe qui décroche, un suivi individuel à mettre en place —
/// est une prestation ordinaire, facturée par la structure de l'intervenant.
/// C'est le « renfort personnalisé », et il emprunte les rails des ateliers
/// (fiche, devis, contrat de prestation), pas ceux du CDD.
enum Interet {
  /// Proposer des ateliers au catalogue.
  ATELIERS
  /// Proposer des formations.
  FORMATIONS
  /// Être contacté pour des vacations de remplacement, en CDD salarié.
  RENFORT_CDD
  /// Intervenir en renfort personnalisé, facturé par sa structure.
  RENFORT_PERSONNALISE
}

/// LE VIVIER OUVERT — les personnes qui se déclarent disponibles.
///
/// ⚠ CE N'EST PAS `PoolMember`, ET LES DEUX NE DOIVENT PAS ÊTRE FONDUS.
/// `PoolMember` est le carnet d'adresses d'UN établissement : les gens qu'il a
/// déjà fait venir, et c'est lui qui alimente le palier RESERVED de la cascade
/// de diffusion. Celui-ci est l'inverse : il est alimenté par les personnes
/// elles-mêmes et il est visible d'établissements qui ne les connaissent pas.
/// Les mélanger remplirait « mes intervenants » de gens jamais rencontrés et
/// casserait le ciblage.
///
/// ⚠ `actif` EST UN CONSENTEMENT, PAS UN RÉGLAGE D'AFFICHAGE. Quelqu'un qui
/// cherche du travail ne doit pas découvrir qu'il est listé : la case est
/// décochée par défaut, et la décocher retire la ligne de la liste tout de
/// suite.
///
/// ⚠ LES COORDONNÉES NE SONT PAS ICI, ET N'ONT RIEN À Y FAIRE. Un
/// établissement voit un profil et écrit par la messagerie ; les coordonnées
/// s'ouvrent quand la demande est confirmée (voir `conversations/masquage.ts`).
/// Une liste de personnes avec leurs numéros s'aspire en une après-midi.
model DisponibiliteRenfort {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Consentement explicite à figurer dans la liste. Faux = invisible.
  actif        Boolean   @default(false)
  /// Les montages sur lesquels la personne accepte d'intervenir. Une liste
  /// vide avec `actif` vrai n'a pas de sens : le service la refuse.
  montages     Interet[]
  /// Métier déclaré, tel que la personne l'écrit. Sert au filtre.
  metier       String?
  /// Départements où elle peut se déplacer (codes INSEE, voir territoires.ts).
  departements String[]  @default([])
  /// Deux ou trois lignes libres. Ce n'est pas un CV.
  presentation String?
  /// À partir de quand elle est disponible, si ce n'est pas tout de suite.
  aPartirDu    DateTime?

  /// ⚠ LA FRAÎCHEUR EST CE QUI FAIT VIVRE OU MOURIR CETTE LISTE.
  ///
  /// Une disponibilité vieille de huit mois fait perdre son temps à
  /// l'établissement, et il n'y revient pas. `confirmeeLe` est la dernière
  /// fois où la personne a dit « toujours dispo » ; passé le délai,
  /// `enVeille` passe à vrai et la ligne sort de la liste sans être
  /// supprimée — elle revient d'un clic.
  confirmeeLe DateTime  @default(now())
  enVeille    Boolean   @default(false)
  /// Verrou de relance : posé AVANT l'envoi, comme partout ailleurs. Un
  /// doublon dans une boîte coûte plus cher qu'un message manquant.
  relanceeLe  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif, enVeille])
  @@index([confirmeeLe])
}

/// DEMANDE DE NIVEAU — le seul passage par Les Extras.
///
/// Un responsable n'en a pas besoin : son périmètre est celui qu'il a
/// constitué lui-même, par invitation. Seule la DIRECTION en passe par ici,
/// parce qu'elle seule gagne la vue sur des équipes qu'elle n'a pas
/// constituées — celles des chefs de service arrivés avant elle.
model DemandeNiveau {
  id            String               @id @default(cuid())
  membershipId  String
  membership    Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  niveauDemande NiveauResponsabilite
  /// Ce que la personne avance : poste, rattachement, courriel professionnel.
  justification String?
  statut        StatutDemande        @default(EN_ATTENTE)
  decideParId   String?
  decidePar     User?                @relation("DemandeNiveauDecideur", fields: [decideParId], references: [id], onDelete: SetNull)
  decideLe      DateTime?
  motifRefus    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  /// Une demande à la fois : renvoyer écrase plutôt que d'empiler.
  @@unique([membershipId])
  @@index([statut])
}

/// DEMANDE PORTANT SUR UN SERVICE.
///
/// Elle naît du contrôle de doublon : un second arrivant tape « SESSAD » dans
/// un établissement où ce nom existe déjà. Trois sorties lui sont offertes —
/// rejoindre (REJOINDRE, tranché par celui qui a créé le service), préciser
/// son nom (aucune demande, il crée « SESSAD Melun »), ou signaler aux Extras
/// (SIGNALEMENT) quand le service existant est obsolète, mal nommé, ou créé
/// par quelqu'un qui est parti. Sans cette troisième sortie, un service créé
/// par erreur bloquerait son nom pour toujours.
model DemandeService {
  id          String              @id @default(cuid())
  orgUnitId   String
  orgUnit     OrgUnit             @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  demandeurId String
  demandeur   User                @relation("DemandeServiceDemandeur", fields: [demandeurId], references: [id], onDelete: Cascade)
  motif       MotifDemandeService
  message     String?
  statut      StatutDemande       @default(EN_ATTENTE)
  decideParId String?
  decidePar   User?               @relation("DemandeServiceDecideur", fields: [decideParId], references: [id], onDelete: SetNull)
  decideLe    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([orgUnitId, statut])
  @@index([accountId, statut])
  @@index([motif, statut])
}

/// Direction (directeur, directeur adjoint, pilote des opérations) ·
/// Responsable (chef de service, coordinateur) · Salarié.
enum NiveauResponsabilite {
  DIRECTION
  RESPONSABLE
  SALARIE
}

/// « Je travaille dans ce service » n'est pas « j'encadre ce service ».
enum PorteeService {
  RATTACHEMENT
  ENCADREMENT
}

/// Par qui le rattachement a été vérifié. Affiché à l'utilisateur, parce que
/// ces trois origines n'ont pas le même poids et qu'il doit pouvoir le lire.
enum OrigineVerification {
  /// La personne a accepté une invitation : c'est son invitant qui l'atteste.
  INVITATION
  RESPONSABLE
  DIRECTION
  LES_EXTRAS
}

/// Droits délégués à l'unité. On ne délègue que ce que l'on détient, et
/// seulement sur son propre périmètre : la délégation se propage de proche en
/// proche mais ne peut jamais en sortir.
enum Capacite {
  /// Réserver un intervenant directement, au lieu de seulement demander un
  /// devis. Il n'y a AUCUN paiement direct sur la plateforme : ce droit
  /// n'engage pas d'argent, il dit qui peut engager l'établissement.
  RESERVER_DIRECT
  DEMANDER_DEVIS
  DEMANDER_RENFORT_INTERNE
  OUVRIR_RENFORT_CDD
  GERER_PLANNING
  VALIDER_INSCRIPTIONS
  VOIR_FACTURES
  SIGNER_CONVENTIONS
  INVITER_MEMBRES
  /// Publier sur l'Édublog au nom de l'établissement.
  PUBLIER_ARTICLE
  /// Publier une actualité de l'établissement.
  PUBLIER_ACTUALITE
  /// Publier une fiche atelier au catalogue.
  PUBLIER_ATELIER
  /// ⚠ LE DROIT LE PLUS SENSIBLE DU PRODUIT. Le coffre-fort de conformité
  /// contient des pièces d'identité, des casiers judiciaires et des diplômes.
  /// Il n'avait aucun droit déclaré : il était donc ouvert à qui avait le rôle
  /// applicatif, sans que personne ne l'ait jamais dit ni accordé.
  VOIR_CONFORMITE
  /// Dépenser les générations LEX de l'établissement (offre LEX Équipe, 1 000
  /// générations partagées). C'est la SEULE chose qui coûte de l'argent sur la
  /// plateforme : savoir qui peut la consommer n'est pas un détail.
  UTILISER_CREDITS_LEX
}

enum StatutDemande {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum MotifDemandeService {
  REJOINDRE
  SIGNALEMENT
}

// ---------------------------------------------------------------------------
// MARKETPLACE — SOS RENFORT (missions) & ATELIERS (services)
// ---------------------------------------------------------------------------

/// Mission de renfort/remplacement publiée par un ESTABLISHMENT.
model ReliefMission {
  id                        String            @id @default(cuid())
  accountId                 String
  account                   Account           @relation("MissionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  title                     String
  description               String
  category                  MissionCategory   @default(RENFORT)
  categoryId                String?
  categoryRef               Category?         @relation("MissionCategoryRef", fields: [categoryId], references: [id], onDelete: SetNull)
  job                       String? // métier recherché
  startDate                 DateTime
  endDate                   DateTime?
  startTime                 String? // "09h00"
  endTime                   String? // "17h00"
  city                      String?
  postalCode                String?
  /// Coordonnees geocodees depuis le code postal (geo.api.gouv.fr) —
  /// permettent le filtre « a moins de X km » sur la marketplace.
  latitude                  Float?
  longitude                 Float?
  hourlyRate                Decimal?          @db.Decimal(8, 2)
  headcount                 Int               @default(1)
  emergency                 Boolean           @default(false) // mission urgente (renfort de dernière minute)
  attachmentUrl             String? // ancien mode : adresse web saisie à la main
  attachmentId              String? // nouveau mode : fichier déposé
  attachment                FileAsset?        @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  orgUnitId                 String? // unité/service concerné
  orgUnit                   OrgUnit?          @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  status                    MissionStatus     @default(DRAFT)
  /// Validation hierarchique : publication demandee par un MANAGER, en
  /// attente d'approbation par un OWNER/ADMIN du compte.
  attenteValidation         Boolean           @default(false)
  /// Mission recurrente : 'HEBDO' -> le planificateur cree et publie
  /// automatiquement l'occurrence de la semaine suivante.
  recurrence                String?
  /// Diffusion en cascade : SALARIES -> RESERVED -> PUBLIC
  visibility                MissionVisibility @default(PUBLIC)
  /// Mode d'attribution choisi par l'établissement à la publication.
  modeAttribution           ModeAttribution   @default(AUTOMATIQUE)
  /// Destinataires de l'offre. RESEAU = cascade normale ; toute autre valeur
  /// verrouille la diffusion (pas d'élargissement, pas de marketplace).
  cibleDiffusion            CibleDiffusion    @default(RESEAU)
  /// Cible SELECTION : identifiants des SALARIÉS (User.id) désignés.
  destinatairesSalaries     String[]          @default([])
  /// Cible SELECTION : identifiants des COMPTES intervenants désignés.
  destinatairesIntervenants String[]          @default([])
  publishedAt               DateTime?
  /// Diffusion ciblée en vagues (voir MissionsService.broadcastToMatched).
  /// 0 = pas encore diffusée · 1 = les profils les plus proches · 2 = élargie
  /// · 3 = tout le réseau. On sollicite peu de monde à la fois, à dessein :
  /// un envoi de masse dilue la responsabilité et personne ne répond.
  diffusionVague            Int               @default(0)
  /// Horodatage de la dernière vague, pour savoir quand déclencher la suivante.
  derniereVagueAt           DateTime?
  /// « Mission garantie » : date à laquelle l'alerte de relance manuelle a été
  /// envoyée (non nul = déjà alerté, l'alerte ne part qu'une fois).
  alerteNonPourvueAt        DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  bookings      Booking[]
  engagements   MissionEngagement[]
  reviews       Review[]            @relation("MissionReviews")
  conversations Conversation[]
  shifts        Shift[]
  quotes        Quote[]
  contratsCDD   ContratCDD[]

  @@index([status, visibility])
  @@index([accountId])
  @@index([startDate])
}

/// Atelier / service proposé par un FREELANCE.
model Service {
  id              String             @id @default(cuid())
  /// Adresse lisible de la fiche publique : `/ateliers/atelier-psycho-boxe`
  /// au lieu de `/ateliers/cms3it0g70015lt1wyr4sbhqr`. Le mot-clé le plus fort
  /// de la fiche n'était nulle part dans son adresse, et l'adresse était
  /// impartageable telle quelle.
  ///
  /// NULLABLE À DESSEIN : l'identifiant continue de résoudre la fiche, pour
  /// toujours. Une fiche sans slug s'affiche exactement comme avant — rien ne
  /// dépend de ce champ pour fonctionner. En PostgreSQL, une contrainte
  /// d'unicité laisse passer autant de NULL qu'on veut.
  slug            String?            @unique
  accountId       String
  account         Account            @relation("ServiceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        ServiceCategory    @default(ATELIER)
  categoryId      String?
  categoryRef     Category?          @relation("ServiceCategoryRef", fields: [categoryId], references: [id], onDelete: SetNull)
  duration        String? // "2H" — libellé libre historique
  /// Durée normalisée en minutes (480 = 8 h) — sert au tri et aux filtres.
  durationMinutes Int?
  maxParticipants Int?
  /// COLLECTIF (un atelier) ou INDIVIDUEL (un renfort personnalisé).
  ///
  /// ⚠ LE RENFORT PERSONNALISÉ N'EST PAS UN QUATRIÈME OBJET DU PRODUIT :
  /// c'est un atelier à une personne. Il emprunte exactement les mêmes rails
  /// — fiche, demande de devis, contrat de prestation, facture émise par la
  /// structure de l'intervenant — et c'est précisément ce qui le distingue du
  /// remplacement de poste, qui passe, lui, par `ReliefMission` et se conclut
  /// en CDD. Un seul champ sépare les deux catalogues ; deux modèles
  /// parallèles auraient fini par diverger.
  format          FormatIntervention @default(COLLECTIF)
  publicTarget    String? // "Adultes en situation de handicap"
  /// Publics visés, en liste (Adolescent, Enfant, Handicap, Sénior…).
  publicTargets   String[]           @default([])
  /// Matériel nécessaire et prérequis, tels qu'annoncés à l'établissement.
  material        String?
  prerequisites   String?
  /// Contenu pédagogique structuré (modèle des fiches les-extras.fr).
  objectives      String?
  methodology     String?
  evaluation      String?
  /// Questions fréquentes : [{ question, answer }].
  faq             Json?
  /// Galerie : URLs (fichier déposé /api/files/... ou image externe).
  images          String[]           @default([])
  /// Options facturables en supplément : [{ label, price }].
  priceExtras     Json?
  /// Mise en avant sur la marketplace et validation par l'équipe.
  featured        Boolean            @default(false)
  verified        Boolean            @default(false)
  /// Compteur de consultations de la fiche.
  views           Int                @default(0)
  /// Identifiant d'origine (import du catalogue historique) : clé d'idempotence.
  /// Index simple et non unique : une contrainte UNIQUE bloquerait `prisma db push`
  /// au démarrage du conteneur (avertissement de perte de données). L'unicité est
  /// garantie applicativement par le `findFirst` de AdminService.importCatalog().
  sourceId        String?
  /// Repères affichés sur la fiche (modèle les-extras.fr).
  /// Nombre de demandes reçues : sert la preuve sociale « X demandes / semaine ».
  requestsCount   Int                @default(0)
  /// Créneaux horaires proposés à la réservation : ["9h-12h", "14h-17h"].
  timeSlots       String[]           @default([])
  /// Formation couverte par la certification Qualiopi d'ADéPA (finançable OPCO).
  qualiopi        Boolean            @default(false)
  price           Decimal?           @db.Decimal(10, 2)
  /// Coût en crédits d'une réservation de cet atelier par un établissement.
  creditCost      Int                @default(1)
  city            String?
  /// LES DÉPARTEMENTS RÉELLEMENT COUVERTS, en codes INSEE ("77", "91"…).
  ///
  /// ⚠ `city` est un champ de texte libre, et le filtre du catalogue s'appuyait
  /// dessus avec un `contains`. Mesuré le 4/09/2026 : « Île-de-France » rendait
  /// 10 fiches, « Ile de France » 3, « Créteil » ZÉRO — la même région écrite de
  /// deux façons, et aucune requête ne rendait les dix-sept. Seize fiches sur
  /// dix-sept mettaient d'ailleurs une RÉGION dans un champ nommé « ville ».
  ///
  /// Ce tableau est la liste fermée qui remplace le texte libre au filtrage.
  /// `city` reste, parce qu'il dit une autre chose — la ville de base de
  /// l'intervenant — et parce qu'effacer une donnée saisie à la main ne se fait
  /// pas. Voir `src/common/territoires.ts` pour le référentiel et la lecture.
  departements    String[]           @default([])
  /// PAIEMENT EN LIGNE DE CET ATELIER, active par l'intervenant lui-meme.
  ///
  /// Faux par defaut, et il faut quatre choses pour le passer a vrai : un
  /// compte d'encaissement relie et pret, un SIRET declare, un prix, et une
  /// politique d'annulation ecrite. Voir `ServicesService.reglerPaiement()`.
  ///
  /// Le devis et la facture ne bougent pas : cette option AJOUTE un chemin,
  /// elle n'en remplace aucun.
  paiementEnLigne Boolean            @default(false)
  /// CE QUI SE PASSE SI ON ANNULE, ecrit par l'intervenant, affiche AVANT le
  /// bouton de paiement. Obligatoire pour encaisser en ligne : on ne prend pas
  /// l'argent de quelqu'un sans lui avoir dit a quelles conditions il le
  /// recupere.
  annulationTexte String?
  status          ServiceStatus      @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  bookings     Booking[]
  quotes       Quote[]
  reviews      Review[]             @relation("ServiceReviews")
  favorites    Favorite[]
  reservations ReservationAtelier[]

  @@index([status])
  @@index([accountId])
  @@index([sourceId])
}

/// Réservation : relie un FREELANCE à une mission OU un service.
/// Devis : chiffrage d'une prestation (atelier, formation, renfort) demandé
/// par un établissement à un intervenant. Accepté -> réservation + contrat.
model Quote {
  id                String         @id @default(cuid())
  reference         String         @unique
  /// Établissement demandeur.
  clientAccountId   String
  clientAccount     Account        @relation("QuoteClient", fields: [clientAccountId], references: [id], onDelete: Cascade)
  /// Intervenant qui chiffre.
  providerAccountId String
  providerAccount   Account        @relation("QuoteProvider", fields: [providerAccountId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  missionId         String?
  mission           ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  title             String
  /// Besoin exprimé par l'établissement.
  request           String?
  /// Message / conditions de l'intervenant.
  message           String?
  /// Lignes du devis : [{ label, quantity, unitPrice }] (JSON pour rester souple).
  lines             Json?
  amount            Decimal?       @db.Decimal(10, 2)
  /// Totaux figes au moment de l'envoi. `amount` reste le TTC : tous les
  /// ecrans et le calcul de la reservation le lisent deja sous ce sens, et un
  /// devis dont le total change de signification au milieu de sa vie n'est
  /// plus opposable. Ces deux champs-ci ajoutent le detail que la loi attend
  /// d'un devis chiffre : le hors taxes et la taxe, separement.
  ///
  /// Nuls sur les devis anterieurs a cette version : la TVA y valait zero
  /// pour tout le monde (franchise en base, art. 293 B du CGI), donc le HT
  /// egalait le TTC et l'information n'est pas perdue, seulement implicite.
  totalHt           Decimal?       @db.Decimal(10, 2)
  totalTva          Decimal?       @db.Decimal(10, 2)
  /// IDENTITE DES DEUX PARTIES, RECOPIEE A L'ENVOI.
  ///
  /// Un devis engage celui qui l'emet et celui qui ecrit « bon pour accord »
  /// dessous. Tant que le document se reconstruisait a la lecture depuis les
  /// profils courants, corriger une raison sociale ou un SIRET reecrivait
  /// retroactivement un devis deja accepte — et faisait mentir l'empreinte de
  /// la signature. On fige donc, au moment ou le devis part : raison sociale,
  /// adresse, SIRET, mention de TVA, contact, pour l'emetteur et pour le
  /// client. Forme : { provider: {...}, client: {...} }.
  partiesSnapshot   Json?
  /// « BON POUR ACCORD » : qui a accepte, et a quel titre.
  ///
  /// Un devis accepte par « l'etablissement » n'est pas signe : une personne
  /// physique engage la structure, et c'est son nom et sa qualite qui rendent
  /// l'acceptation opposable. On les releve au moment du clic.
  acceptedByName    String?
  acceptedByRole    String?
  status            QuoteStatus    @default(REQUESTED)
  /// Date d'intervention souhaitée / retenue.
  scheduledAt       DateTime?
  validUntil        DateTime?
  sentAt            DateTime?
  decidedAt         DateTime?
  refusalReason     String?
  /// LE DEVIS SIGNÉ, DÉPOSÉ PAR LE DEMANDEUR : ce dépôt vaut acceptation.
  /// Papier signé puis scanné ou photographié ; aucune signature électronique
  /// n'est demandée. Nul sur les devis acceptés avant cette version.
  signedFileId      String?
  signedFile        FileAsset?     @relation("QuoteSigned", fields: [signedFileId], references: [id], onDelete: SetNull)
  signedAt          DateTime?
  /// Réservation créée à l'acceptation (contrat + facturation en aval).
  bookingId         String?        @unique
  booking           Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  conversations Conversation[]

  @@index([clientAccountId])
  @@index([providerAccountId])
  @@index([status])
  @@index([signedFileId])
}

enum QuoteStatus {
  REQUESTED
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
}

/// Comment le client a dit vouloir régler, au moment de réserver.
///
/// Une fiche accepte la carte ou non ; le virement sur facture est toujours
/// possible. Le choix est enregistré ici pour que l’intervenant et la
/// facturation sachent quoi attendre — et pour que personne ne relance par
/// carte quelqu’un qui a dit « sur facture ». Nul sur les réservations
/// antérieures : elles n’ont rien dit, on ne leur invente pas de réponse.
enum ModePaiement {
  CARTE
  VIREMENT
}

model Booking {
  id                    String         @id @default(cuid())
  // Le compte à l'origine de la réservation (établissement ou freelance selon flux)
  accountId             String
  account               Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  missionId             String?
  mission               ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  serviceId             String?
  service               Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  status                BookingStatus  @default(REQUESTED)
  scheduledAt           DateTime?
  /// Nombre de participants annonce a la demande. L'intervenant en a besoin
  /// pour dire oui ou non : un atelier prevu pour huit ne se tient pas a vingt.
  participants          Int?
  /// Precisions ecrites par le demandeur : public accueilli, objectifs,
  /// contraintes. Sans ce champ, le formulaire les jetait a la poubelle.
  requestNote           String?
  modePaiement  ModePaiement?
  /// Date de fin effective : ouvre la fenetre d'ajustement de 72 h du pointage.
  completedAt           DateTime?
  totalAmount           Decimal?       @db.Decimal(10, 2)
  cancelReason          String?
  // Signature du contrat de mission (double signature établissement + freelance).
  signedFreelanceAt     DateTime?
  signedEstablishmentAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  reviews       Review[]
  invoice       Invoice?
  quote         Quote?
  shift         Shift?
  timeEntries   TimeEntry[]
  engagement    MissionEngagement?
  conversations Conversation[]
  visios        Visioconsultation[]

  @@index([status])
  @@index([missionId])
  @@index([serviceId])
  /// ⚠ L'INDEX QUI MANQUAIT — 16/09/2026.
  ///
  /// `findAllByAccount` filtre sur
  /// `OR: [{accountId}, {mission:{accountId}}, {service:{accountId}}]` : c'est
  /// la requête de `/dashboard/reservations`, l'écran le plus ouvert du
  /// produit. Les deux derniers membres passaient par `missionId` et
  /// `serviceId`, indexés ; le PREMIER faisait un parcours complet de la table,
  /// à chaque ouverture, et cette table grossit à chaque réservation.
  ///
  /// `[accountId, status]` plutôt que `accountId` seul : l'écran demande
  /// presque toujours un état (« à traiter », « à venir », « terminées »), et
  /// un index composite sert les deux cas — le filtre sur le compte seul
  /// utilise sa première colonne.
  @@index([accountId, status])
}

/// Pointage : temps travaillé déclaré par le freelance sur une mission (Booking),
/// validé par l'établissement. Repris de Symfony (entité Period). Base de la facturation.
model TimeEntry {
  id        String          @id @default(cuid())
  bookingId String
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  note      String?
  status    TimeEntryStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([bookingId])
  @@index([status])
}

enum TimeEntryStatus {
  PENDING
  VALIDATED
  REJECTED
}

// ---------------------------------------------------------------------------
// MESSAGERIE / AVIS / NOTIFS / FACTURES / DOCUMENTS
// ---------------------------------------------------------------------------

/// MESSAGERIE (16/09/2026 — version complète)
///
/// Un fil ne flotte jamais : il porte toujours son CONTEXTE. C'est ce qui
/// distingue les quatre usages, et c'est surtout ce qui protège le modèle
/// économique — un fil avec un INTERVENANT n'existe pas sans une demande
/// (devis, réservation, atelier). Sans ce garde-fou, le catalogue devient un
/// carnet d'adresses : le premier échange sert à donner un numéro, et la
/// réservation se fait ailleurs. C'est comme ça que meurent les places de
/// marché.
model Conversation {
  id    String           @id @default(cuid())
  type  TypeConversation @default(MISSION)
  /// Objet du fil, affiché en tête de liste.
  sujet String?

  // --- Les ancrages possibles. Au moins un, sauf pour un fil interne. ---
  missionId String?
  mission   ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  /// L'établissement dont relève ce fil (interne, service, demande émise).
  accountId String?
  account   Account?       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Le service concerné, pour un fil d'équipe.
  orgUnitId String?
  orgUnit   OrgUnit?       @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  /// La demande qui autorise un fil avec un intervenant.
  quoteId   String?
  quote     Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  bookingId String?
  booking   Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// Fil clos : lisible, plus alimentable. On n'efface pas un échange.
  fermee           Boolean   @default(false)
  /// Date du dernier message, dénormalisée pour trier la liste sans agréger.
  dernierMessageAt DateTime?

  createdById String?
  createdBy   User?   @relation("ConversationCreateur", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages     Message[]
  participants ConversationParticipant[]

  @@index([missionId])
  @@index([accountId, type])
  @@index([orgUnitId])
  @@index([dernierMessageAt])
}

/// QUI est dans le fil, et jusqu'où il l'a lu.
///
/// Les non-lus se comptent ici et nulle part ailleurs : `Message.readAt` ne
/// savait dire que « lu » ou « non lu » pour tout le monde à la fois, ce qui
/// est faux dès qu'un fil compte trois personnes.
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Date du dernier message lu. Null = rien lu.
  luJusquA       DateTime?
  /// Notifications par courriel pour ce fil.
  notifications  Boolean      @default(true)
  /// Quitté le fil : ne reçoit plus rien et ne voit plus la suite. L'historique
  /// déjà lu reste lisible — on ne réécrit pas le passé.
  quitteLe       DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, quitteLe])
}

model Message {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId            String
  sender              User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body                String
  type                TypeMessage  @default(TEXTE)
  /// Conservé pour l'existant ; les non-lus se lisent désormais sur
  /// ConversationParticipant.luJusquA.
  readAt              DateTime?
  /// Vrai quand des coordonnées ont été retirées du corps avant enregistrement
  /// (fil avec un intervenant, demande non confirmée). On le dit à l'auteur
  /// plutôt que de laisser croire que son message est parti tel quel.
  coordonneesMasquees Boolean      @default(false)
  modifieLe           DateTime?
  /// Message retiré par son auteur : le corps est vidé, la ligne reste.
  supprimeLe          DateTime?
  signaleLe           DateTime?
  signaleParId        String?
  signalePar          User?        @relation("MessageSignaleur", fields: [signaleParId], references: [id], onDelete: SetNull)
  motifSignalement    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  pieces MessagePiece[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([signaleLe])
}

/// Pièce jointe d'un message. Passe par FileAsset, comme tout le reste.
model MessagePiece {
  id          String    @id @default(cuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAssetId String
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([messageId, fileAssetId])
  @@index([fileAssetId])
}

enum TypeConversation {
  /// Historique : fil attaché à une mission de renfort.
  MISSION
  /// Entre membres d'un même établissement.
  INTERNE
  /// Fil d'équipe d'un service.
  SERVICE
  /// Établissement ↔ intervenant. Exige une demande.
  INTERVENANT
  /// Avec Les Extras.
  SUPPORT
}

enum TypeMessage {
  TEXTE
  /// Écrit par la plateforme : arrivée d'un participant, fil clos, demande
  /// acceptée. Ne s'édite pas et ne se supprime pas.
  SYSTEME
}

/// AVIS déposé après une réservation. Chaque partie (établissement ET
/// intervenant) peut déposer le sien : la contrainte d'unicité porte donc sur
/// le couple (réservation, auteur) et non sur la seule réservation.
model Review {
  id        String         @id @default(cuid())
  bookingId String
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User           @relation("ReviewTarget", fields: [targetId], references: [id])
  /// Prestation notée, déduite de la réservation à la création de l'avis.
  /// Sur une marketplace, la note portée par l'offre pèse plus dans la décision
  /// d'achat que celle du vendeur : deux ateliers d'un même intervenant ne
  /// doivent pas partager la même note.
  serviceId String?
  service   Service?       @relation("ServiceReviews", fields: [serviceId], references: [id], onDelete: SetNull)
  missionId String?
  mission   ReliefMission? @relation("MissionReviews", fields: [missionId], references: [id], onDelete: SetNull)
  rating    Int // 1..5
  comment   String?
  createdAt DateTime       @default(now())

  @@index([targetId])
  @@index([bookingId])
  @@index([serviceId])
  @@index([missionId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Invoice {
  id              String        @id @default(cuid())
  /// L'ÉMETTEUR : le compte qui facture. C'est lui qui apparaît en tête du
  /// document, lui seul peut émettre ou annuler, et c'est son identification
  /// (raison sociale, SIRET) qui engage juridiquement la facture.
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// LE PAYEUR, quand il n'est pas déductible de la réservation — cas des
  /// inscriptions en formation, où l'association facture un établissement sans
  /// qu'aucun Booking ne les relie. Sans ce champ, l'établissement ne voyait
  /// jamais la facture qui lui était pourtant adressée, et le bouton « Payer
  /// en ligne » lui restait inatteignable.
  payerAccountId  String?
  payer           Account?      @relation("InvoicePayer", fields: [payerAccountId], references: [id], onDelete: SetNull)
  bookingId       String?       @unique
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  /// Numéro de séquence, unique PAR ÉMETTEUR (pas globalement) : l'article 242
  /// nonies A de l'annexe II au CGI impose une séquence chronologique continue
  /// et sans rupture PROPRE À CHAQUE ÉMETTEUR. Une séquence globale partagée
  /// entre tous les comptes de la plateforme (ancien comportement) mélangeait
  /// les numéros de personnes morales distinctes — non conforme.
  number          String
  amount          Decimal       @db.Decimal(10, 2)
  status          InvoiceStatus @default(DRAFT)
  /// IDENTITE DES DEUX PARTIES, RECOPIEE A L'EMISSION.
  ///
  /// Une facture emise est une piece comptable : son contenu ne bouge plus.
  /// Or le document etait reconstruit a chaque telechargement depuis les
  /// profils courants — corriger une raison sociale, une adresse ou un IBAN
  /// reecrivait donc retroactivement une facture deja envoyee, deja payee,
  /// deja archivee par le client. Deux exemplaires du meme numero de facture
  /// pouvaient ne pas dire la meme chose.
  ///
  /// On fige donc au moment de l'emission — et seulement a ce moment : un
  /// brouillon doit continuer de suivre le profil, puisqu'il n'engage encore
  /// personne. Forme : { emetteur: {...}, client: {...} }, la meme que celle
  /// du devis (voir quotes/parties.ts), pour n'avoir qu'un seul format a
  /// relire.
  partiesSnapshot Json?
  /// Jamais rempli a ce jour : le PDF est regenere a la demande a partir de
  /// l'instantane ci-dessus, ce qui donne le meme document a chaque fois sans
  /// imposer un stockage binaire. Le champ reste pour le jour ou l'on
  /// archivera le fichier lui-meme — signature electronique, Factur-X.
  pdfUrl          String?
  issuedAt        DateTime?
  createdAt       DateTime      @default(now())

  inscription      Inscription?      @relation("InscriptionInvoice")
  /// Session dont cette facture est la remuneration du formateur, le cas
  /// echeant. Le sens est inverse de `inscription` : ici l'emetteur est le
  /// formateur et le payeur l'organisme.
  sessionRemuneree FormationSession? @relation("SessionTrainerInvoice")

  @@unique([accountId, number])
  @@index([accountId])
  @@index([payerAccountId])
}

/// GRAND LIVRE DES CRÉDITS : trace chaque variation de solde d'un compte
/// (top-up admin, débit à la réservation d'un atelier). Immuable, append-only.
model Subscription {
  id                   String    @id @default(cuid())
  accountId            String    @unique
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  status               String    @default("pending") // pending | active | past_due | canceled
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// RÉACTIVÉ pour LEX — les crédits ne sont plus une monnaie interne de
/// réservation (ce modèle-là a été abandonné : la mise en relation est
/// gratuite), mais la monnaie de l'assistant IA : un crédit = une
/// génération. Chaque achat de pack passe ici, PENDING à la création de la
/// session Stripe, PAID au webhook — `stripeSessionId @unique` garantit
/// qu'une relivraison ne crédite pas deux fois.
model CreditPurchase {
  id              String               @id @default(cuid())
  accountId       String
  account         Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId          String
  packId          String
  credits         Int
  amountCents     Int
  currency        String               @default("eur")
  stripeSessionId String               @unique
  status          CreditPurchaseStatus @default(PENDING)
  /// Facture Stripe émise au paiement (invoice_creation) et son lien hébergé.
  stripeInvoiceId String?
  factureUrl      String?
  paidAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([accountId])
}

enum CreditPurchaseStatus {
  PENDING
  PAID
  CANCELED
}

/// GRAND LIVRE DES CRÉDITS — et journal des générations.
///
/// `userId` répond à une promesse faite sur /confiance-lex : « qui a généré
/// quoi, quand ». Sans lui, une direction ne pouvait rien vérifier, et la
/// page promettait un export qui n'existait pas.
///
/// Il est NULLABLE et le restera : les écritures antérieures n'ont pas
/// d'auteur connu, et les mouvements automatiques (dotation mensuelle,
/// remboursement, webhook Stripe) n'en ont pas non plus. Le déduire
/// après coup serait inventer une trace, exactement ce qu'un journal de
/// conformité ne doit jamais faire.
///
/// `label` porte le titre de l'écrit quand il y en a un, pour qu'une ligne
/// dise « Rapport de situation — janvier » et non seulement « LEX_ECRIT ».
model CreditLedger {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  delta        Int
  balanceAfter Int
  reason       String
  label        String?
  bookingId    String?
  invoiceId    String?
  createdAt    DateTime @default(now())

  @@index([accountId])
  @@index([accountId, createdAt])
  @@index([userId])
}

/// OBSOLÈTE — le dépôt de fichiers passe désormais par FileAsset et
/// ComplianceDocument. Ce modèle n'est plus qu'effacé lors d'une suppression
/// de compte (RGPD). La table est CONSERVÉE tant que d'anciens comptes
/// peuvent encore y avoir des pièces : la vider serait effacer des documents
/// que des utilisateurs croient déposés.
model Document {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // avatar, diploma, siret, contract...
  /// Ancien mode : adresse web. Vide quand le fichier est déposé (fileId).
  url       String
  fileId    String?
  file      FileAsset? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([userId, kind])
}

/// CATÉGORIE éditable (taxonomie ateliers / missions / articles). Calque du back-office Symfony.
model Category {
  id            String          @id @default(cuid())
  title         String
  slug          String?         @unique
  description   String?
  type          String? // mission, service, article, educatheure...
  parentId      String?
  parent        Category?       @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]      @relation("CategoryParent")
  archived      Boolean         @default(false)
  articles      Article[]
  missionsRef   ReliefMission[] @relation("MissionCategoryRef")
  servicesRef   Service[]       @relation("ServiceCategoryRef")
  formationsRef Formation[]     @relation("FormationCategoryRef")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([type])
}

/// ARTICLE de contenu (blog / actualités). Calque du back-office Symfony.
/// Deux rayons dans l'Édublog : l'actualité (une nouvelle, un retour de
/// terrain, un temps fort) et l'article de fond (une analyse, un guide).
/// Chaque compte écrit dans l'un ou l'autre.
enum ArticleKind {
  ACTUALITE
  ARTICLE
}

model Article {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  kind             ArticleKind   @default(ACTUALITE)
  excerpt          String?
  content          String?
  coverUrl         String?
  status           ArticleStatus @default(DRAFT)
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId         String?
  author           User?         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Compte qui publie (établissement ou intervenant). Null = article éditorial
  /// publié par l'équipe Les Extras depuis le back-office.
  accountId        String?
  account          Account?      @relation("AccountArticles", fields: [accountId], references: [id], onDelete: Cascade)
  /// Consultations de l'article (preuve d'audience pour l'auteur).
  views            Int           @default(0)
  /// Partage LinkedIn : identifiant de la publication et date d'envoi.
  linkedinUrn      String?
  linkedinSharedAt DateTime?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([status, kind, publishedAt])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// JOURNAL D'AUDIT (traçabilité)
// ---------------------------------------------------------------------------

/// JOURNAL D'AUDIT : trace append-only des actions sensibles de la plateforme
/// (validation d'heures pointées, modification d'un document de conformité,
/// modération, changement de statut…). Dans le médico-social, savoir QUI a fait
/// QUOI et QUAND a une vraie valeur probante en cas de litige.
/// Aucune entrée n'est jamais modifiée ni supprimée par le métier.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// Auteur de l'action. Nullable : action système / automatique, ou auteur supprimé.
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Compte (tenant) concerné par l'action. Nullable : action hors contexte de compte.
  accountId  String?
  account    Account? @relation("AuditAccount", fields: [accountId], references: [id], onDelete: SetNull)
  /// Code court et stable de l'action, ex. "booking.time_entry.validated".
  action     String
  /// Type d'entité visée, ex. "TimeEntry", "ComplianceDocument", "Booking".
  entityType String
  /// Identifiant de l'entité visée (nullable pour les actions globales).
  entityId   String?
  /// Résumé lisible en français, affiché tel quel dans le back-office.
  summary    String
  /// Contexte libre (avant/après, motif…). Optionnel.
  metadata   Json?
  /// Adresse IP de l'appelant, si connue.
  ip         String?

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum GlobalRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  VERIFIED
  BANNED
  /// Compte anonymisé à la demande de la personne (droit à l'effacement, RGPD art. 17).
  /// Distinct de BANNED : ce n'est pas une sanction.
  ANONYMIZED
}

enum AccountType {
  ESTABLISHMENT
  FREELANCE
  /// Piloter mon association (association.toulali.fr) : une association qui
  /// pilote son financement et sa conformité. Ni intervenant, ni établissement.
  ASSOCIATION
  /// Piloter mon académie (academie.toulali.fr) : un organisme de formation qui
  /// pilote sa certification Qualiopi, son catalogue et ses apprenants. Une même
  /// personne peut porter une association ET une académie : ce sont deux comptes.
  ACADEMIE
  /// PARTICULIER (09/09/2026) : un parent, un aidant, une personne accompagnee
  /// qui reserve pour elle-meme ou pour son enfant. Il reserve des ateliers et
  /// des formations, voit ses factures et utilise LEX — mais il ne publie
  /// rien, ne recoit aucune candidature et n'a pas d'equipe. Ce n'est ni un
  /// etablissement (pas de renfort, pas de salaries) ni un intervenant.
  PARTICULIER
}

enum AccountRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MissionCategory {
  RENFORT
  REMPLACEMENT
  ATELIER_EDUCATIF
  ATELIER_THERAPEUTIQUE
  FORMATION
  ANALYSE_PRATIQUES
}

enum MissionStatus {
  DRAFT
  PUBLISHED
  FILLED
  CLOSED
  CANCELLED
}

enum MissionVisibility {
  SALARIES
  RESERVED
  PUBLIC
}

/// COMMENT la mission est attribuée. Le choix appartient à l'établissement,
/// mission par mission — les deux modèles ont leur usage.
///
/// AUTOMATIQUE : premier arrivé, premier servi. Le premier intervenant qui
/// accepte a la mission, immédiatement, sans validation. C'est le plus rapide
/// et c'est ce qu'il faut pour un renfort de dernière minute.
///
/// FILE_ENGAGEMENT : l'intervenant s'engage (« je prends la mission »), son
/// profil est présenté à l'établissement qui accepte ou refuse. En cas de
/// refus, le suivant de la file est présenté, et ainsi de suite. Plus lent,
/// mais l'établissement garde la main sur QUI entre dans sa structure — ce qui
/// permet en retour de diffuser BEAUCOUP plus largement sans crainte.
enum ModeAttribution {
  AUTOMATIQUE
  FILE_ENGAGEMENT
}

/// À QUI l'offre est envoyée à la publication. Distinct de `visibility` :
/// la visibilité dit jusqu'où la cascade peut aller, la cible dit qui est
/// nommément destinataire. Toute cible autre que RESEAU VERROUILLE la
/// diffusion : ni élargissement automatique, ni apparition sur la marketplace.
enum CibleDiffusion {
  /// Diffusion normale en cascade (salariés -> réseau réservé -> public).
  RESEAU
  /// Uniquement les intervenants déjà venus ici ou retenus au vivier.
  CONNUS
  /// Uniquement les salariés rattachés à l'unité/service désigné.
  UNITE
  /// Uniquement les personnes explicitement cochées à la publication.
  SELECTION
}

/// Étapes d'un engagement dans la file (mode FILE_ENGAGEMENT).
enum EngagementStatut {
  /// L'intervenant s'est engagé, il attend son tour dans la file.
  EN_ATTENTE
  /// Son profil est actuellement soumis à l'établissement.
  PRESENTE
  /// L'établissement l'a retenu : la mission lui est attribuée.
  ACCEPTE
  /// L'établissement a écarté ce profil ; on passe au suivant.
  REFUSE
  /// L'intervenant s'est retiré de lui-même.
  RETIRE
  /// La mission a été attribuée à quelqu'un d'autre (ou annulée).
  CADUC
}

/// FILE D'ENGAGEMENT — un intervenant a dit « je prends la mission ».
///
/// Ce n'est pas une candidature (Booking REQUESTED) : la candidature est une
/// manifestation d'intérêt, l'engagement est une PRISE de la mission, dans
/// l'ordre d'arrivée. L'établissement ne trie pas un tas de dossiers, il
/// répond oui ou non à une personne à la fois — ce qui est à la fois beaucoup
/// plus rapide pour lui, et beaucoup plus respectueux pour les intervenants,
/// qui savent exactement où ils en sont.
model MissionEngagement {
  id         String           @id @default(cuid())
  missionId  String
  mission    ReliefMission    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// Compte intervenant qui s'engage.
  accountId  String
  account    Account          @relation("EngagementIntervenant", fields: [accountId], references: [id], onDelete: Cascade)
  /// Ordre d'arrivée dans la file. 1 = le premier à s'être engagé.
  rang       Int
  statut     EngagementStatut @default(EN_ATTENTE)
  /// Mot de l'intervenant à l'établissement (facultatif).
  message    String?
  /// Horodatage de la présentation du profil à l'établissement.
  presenteAt DateTime?
  /// Relance envoyée à l'établissement qui n'a pas tranché (une seule fois).
  relanceAt  DateTime?
  /// Horodatage de la décision (acceptation ou refus).
  decideAt   DateTime?
  /// Motif de refus, transmis tel quel à l'intervenant. On dit pourquoi :
  /// un refus sans raison démobilise plus sûrement qu'une mission perdue.
  motifRefus String?
  /// Réservation créée en cas d'acceptation.
  bookingId  String?          @unique
  booking    Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([missionId, accountId])
  @@index([missionId, statut])
  @@index([accountId])
}

enum ServiceCategory {
  ATELIER
  FORMATION
  MEDIATION
  ART_THERAPIE
  PREVENTION
}

/// Le format d'une fiche : à plusieurs, ou pour une seule personne.
enum FormatIntervention {
  /// Un atelier : un groupe, une salle, un nombre de participants.
  COLLECTIF
  /// Un renfort personnalisé : une personne nommée, un objectif, des séances.
  INDIVIDUEL
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// PLANNING / SHIFTS & DISPONIBILITÉS (matching + gestion d'équipe terrain)
// ---------------------------------------------------------------------------

/// GTA — demande de conge/absence d'un membre de l'etablissement,
/// validee par un responsable (OWNER/ADMIN/MANAGER).
model LeaveRequest {
  id         String      @id @default(cuid())
  accountId  String
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  type       LeaveType   @default(CONGE)
  debut      DateTime
  fin        DateTime
  motif      String?
  statut     LeaveStatus @default(EN_ATTENTE)
  decideurId String?
  decideLe   DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([accountId, statut])
  @@index([userId, debut])
}

enum LeaveType {
  CONGE
  RTT
  MALADIE
  SANS_SOLDE
  AUTRE
}

enum LeaveStatus {
  EN_ATTENTE
  APPROUVE
  REFUSE
}

/// Fenêtre de disponibilité d'un intervenant (récurrente hebdo OU date ponctuelle).
model Availability {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int? // 0=dimanche .. 6=samedi (récurrent hebdo)
  date      DateTime? // date précise (ponctuel)
  startTime String // "09:00"
  endTime   String // "17:00"
  type      AvailabilityType @default(AVAILABLE)
  createdAt DateTime         @default(now())

  @@index([userId])
}

/// Créneau planifié (shift) : gestion du planning côté établissement.
model Shift {
  id             String         @id @default(cuid())
  accountId      String
  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  freelanceId    String?
  freelance      User?          @relation("ShiftFreelance", fields: [freelanceId], references: [id], onDelete: SetNull)
  missionId      String?
  mission        ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  /// SERVICE (unité) concerné par le créneau. C'est ce qui permet à un chef
  /// de service de voir son planning et non celui de tout l'établissement.
  /// Renseigné à la main, ou déduit du service auquel l'intervenant est
  /// rattaché quand on ne le précise pas.
  orgUnitId      String?
  orgUnit        OrgUnit?       @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  bookingId      String?        @unique
  booking        Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  title          String
  startAt        DateTime
  endAt          DateTime
  status         ShiftStatus    @default(PLANNED)
  notes          String?
  recurrenceRule String? // RRULE iCal optionnel (récurrence)

  // Dérogation aux plafonds de durée du travail. Renseignée uniquement quand
  // un responsable a choisi de passer outre un constat bloquant : c'est la
  // trace qui le couvre en cas de contrôle URSSAF ou inspection du travail.
  derogationMotif String?
  derogationCodes String[]  @default([])
  derogationLe    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, startAt])
  @@index([freelanceId, startAt])
  @@index([orgUnitId, startAt])
}

enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
}

enum ShiftStatus {
  PLANNED
  CONFIRMED
  DONE
  CANCELLED
}

// ---------------------------------------------------------------------------
// CENTRE DE FORMATION (Qualiopi) — programme / session / inscription (P1)
// ---------------------------------------------------------------------------

/// PROGRAMME de formation. Catalogue ADePA (certifiant) OU interne etablissement.
model Formation {
  id                   String          @id @default(cuid())
  type                 FormationType   @default(CERTIFIANTE)
  ownerAccountId       String
  ownerAccount         Account         @relation("FormationOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  title                String
  slug                 String          @unique
  summary              String?
  objectives           String?
  prerequisites        String?
  program              String?
  targetAudience       String?
  /// PUBLICS VISES, en etiquettes courtes et filtrables.
  ///
  /// `targetAudience` est un paragraphe : il se lit sur la fiche, il ne se
  /// filtre pas. Le catalogue des ateliers, lui, laisse chercher « pour qui »
  /// avant « quoi » — c'est l'entree la plus utilisee du site. Les formations
  /// n'avaient pas l'equivalent, et leurs cartes paraissaient vides a cote de
  /// celles des ateliers. Meme vocabulaire d'un bout a l'autre du catalogue :
  /// une etiquette qui n'existe qu'une fois ne sert a personne.
  publicTargets        String[]        @default([])
  durationHours        Int?
  /// DUREE EN MINUTES, pour ce qui dure moins d'une heure.
  ///
  /// `durationHours` est un entier : une mini-formation de 45 minutes y vaut
  /// soit 0, soit 1 — l'un fait disparaitre la duree de la carte, l'autre
  /// ment. Les deux champs coexistent : les formations Qualiopi comptent en
  /// heures, les mini-formations en minutes, et la carte affiche celui qui est
  /// renseigne.
  durationMinutes      Int?
  categoryId           String?
  categoryRef          Category?       @relation("FormationCategoryRef", fields: [categoryId], references: [id], onDelete: SetNull)
  cpfEligible          Boolean         @default(false)
  certifying           Boolean         @default(false)
  certificationName    String?
  edofRef              String?
  /// Vitrine : sans image ni ville, une formation ne se vend pas en ligne.
  images               String[]        @default([])
  city                 String?
  /// Contenu commercial repris du modèle des fiches atelier.
  methodology          String?
  evaluation           String?
  faq                  Json?
  /// MINI-FORMATION EN LIGNE, GRATUITE ET SANS SESSION.
  ///
  /// Le modele de la fiche formation a ete concu pour une seule chose : vendre
  /// au devis une action Qualiopi, animee en presentiel, a une date. Toute la
  /// fiche en decoule — « Tarif sur devis », « Demander un devis »,
  /// « Prochaines sessions », « Reponse garantie sous 72 h ».
  ///
  /// Une mini-formation gratuite suivie en ligne ne coche AUCUNE de ces cases :
  /// elle n'a pas de date, pas de lieu, pas de devis et pas de prix. Publiee
  /// telle quelle, elle afficherait « Tarif sur devis » pour quelque chose de
  /// gratuit et « Demander un devis » pour quelque chose d'accessible tout de
  /// suite — c'est-a-dire l'exact contraire de la promesse.
  ///
  /// Ce drapeau bascule la fiche dans un second mode : prix affiche « Gratuit »,
  /// bouton unique vers `enrollUrl`, ni session ni formulaire de devis. Il ne
  /// change RIEN aux formations existantes (defaut `false`).
  freeOnline           Boolean         @default(false)
  /// Adresse ou la formation se suit reellement quand elle est en ligne.
  ///
  /// L'hebergement du parcours (video, quiz, suivi d'assiduite) est fait par la
  /// plateforme pedagogique de l'association ; Les Extras porte la fiche
  /// publique, qui est ce que Google indexe et ce qui se partage. Sans cette
  /// adresse, `freeOnline` n'a aucun sens : le seul bouton de la fiche n'aurait
  /// nulle part ou aller.
  enrollUrl            String?
  /// LE PRIX DE L'ATTESTATION DE SUIVI, en centimes — ET L'INTERRUPTEUR DE
  /// LA VENTE.
  ///
  /// ⚠⚠ NULL = RIEN NE SE VEND, et c'est le défaut sur toutes les fiches.
  /// Le bouton d'achat n'apparaît pas, la route publique refuse, et la fiche
  /// se lit exactement comme avant. La vente s'ouvre en posant un montant,
  /// fiche par fiche — c'est un geste d'administration, pas un déploiement.
  ///
  /// ⚠ POURQUOI UN INTERRUPTEUR ET PAS UNE MISE EN LIGNE SÈCHE. Vendre à un
  /// particulier oblige à nommer dans les CGV un médiateur de la consommation
  /// référencé par la CECMC (art. L612-1 c. conso). Tant qu'aucun ne l'est,
  /// la clause serait nulle — donc pire que pas de clause. Le tunnel est
  /// construit, il attend une décision qui n'est pas technique.
  ///
  /// ⚠ CE QUI EST VENDU EST UNE ATTESTATION DE SUIVI, JAMAIS UN CERTIFICAT.
  /// Un certificat désigne une certification enregistrée au RNCP ou au
  /// Répertoire spécifique ; Qualiopi certifie un PROCESSUS et n'autorise à
  /// délivrer aucun titre. Vendre 20 € un document appelé « certificat »
  /// serait une pratique commerciale trompeuse (art. L121-1 c. conso).
  attestationPrixCents Int?
  /// Compteurs de la fiche (preuve sociale et pilotage du funnel).
  views                Int             @default(0)
  requestsCount        Int             @default(0)
  status               FormationStatus @default(DRAFT)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  sessions     FormationSession[]
  attestations DemandeAttestation[]
  /// La formation suivie qui porte cette fiche (Piloter mon académie).
  cours        Cours?               @relation("CoursProgramme")

  @@index([type, status])
  @@index([ownerAccountId])
}

/// UNE ATTESTATION DE SUIVI ACHETÉE — la commande, son paiement, sa délivrance.
///
/// ⚠⚠ LA CLÉ EST UN E-MAIL, PAS UN COMPTE, ET C'EST STRUCTUREL. Les parcours
/// gratuits se suivent sur la plateforme pédagogique de l'association ; on y
/// arrive par le bouton de la fiche publique, sans jamais créer de compte Les
/// Extras. Exiger un compte pour acheter le document qui atteste du parcours
/// qu'on vient de finir ferait abandonner presque tout le monde — et il n'y a
/// rien à rattacher à un compte : l'attestation nomme une personne, elle
/// n'ouvre aucun accès.
///
/// C'est le même choix que les ventes de cours (`VenteCours`) et les
/// réservations d'atelier payées en ligne : une adresse, un nom, un paiement.
model DemandeAttestation {
  id          String    @id @default(cuid())
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  /// L'identité qui S'IMPRIMERA sur le document. Recopiée à la commande et
  /// jamais recalculée : l'attestation atteste de ce qui a été déclaré.
  email  String
  prenom String
  nom    String

  montantCents Int
  statut       StatutAttestation @default(EN_ATTENTE_PAIEMENT)

  /// La session de paiement. ⚠ UNIQUE : c'est la clé d'idempotence du
  /// webhook — une relivraison de Stripe retombe sur la même ligne et ne
  /// délivre pas deux fois.
  stripeSessionId String?   @unique
  payeeLe         DateTime?

  /// RÉTRACTATION — 14 jours, et la seule façon de l'éteindre.
  ///
  /// ⚠ LE DROIT NE S'ÉTEINT QUE SUR DEMANDE EXPRESSE D'EXÉCUTION IMMÉDIATE
  /// (art. L221-25 et L221-28, 1° c. conso). La case est donc DÉCOCHÉE par
  /// défaut, et la cocher est un geste de l'acheteur, jamais un réglage du
  /// vendeur. Sans elle, la délivrance attend la fin des quatorze jours —
  /// c'est `livrableLe` qui porte la date, et l'écran d'administration refuse
  /// de délivrer avant.
  renonciationRetractation Boolean   @default(false)
  livrableLe               DateTime?

  delivreeLe DateTime?
  /// Annulation ou remboursement : on garde la ligne et le motif, jamais on
  /// ne la supprime — une commande payée fait partie de la comptabilité.
  annuleeLe  DateTime?
  motif      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([email])
  @@index([formationId])
}

enum StatutAttestation {
  EN_ATTENTE_PAIEMENT
  PAYEE
  DELIVREE
  ANNULEE
}

/// SESSION : instance datee d'un programme.
model FormationSession {
  id               String        @id @default(cuid())
  formationId      String
  formation        Formation     @relation(fields: [formationId], references: [id], onDelete: Cascade)
  trainerId        String?
  trainer          User?         @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  hostAccountId    String?
  hostAccount      Account?      @relation("SessionHost", fields: [hostAccountId], references: [id], onDelete: SetNull)
  title            String?
  startDate        DateTime
  endDate          DateTime?
  location         String?
  maxSeats         Int?
  priceHt          Decimal?      @db.Decimal(10, 2)
  /// REMUNERATION DU FORMATEUR, hors taxes.
  ///
  /// `priceHt` est ce que l'organisme VEND a l'etablissement ; ce champ-ci est
  /// ce qu'il ACHETE au formateur. Les deux sont independants et n'ont aucune
  /// raison d'etre egaux. Le modele ne connaissait que le prix de vente : rien
  /// dans la base ne savait ce qui etait du au formateur, donc rien ne pouvait
  /// etre facture de son cote.
  ///
  /// Le montant est fixe par l'organisme qui commande la prestation. Le
  /// formateur ne peut pas l'editer : on ne fixe pas, depuis le compte de son
  /// client, le prix que ce client vous paiera (cf. `updateSession`).
  trainerFeeHt     Decimal?      @db.Decimal(10, 2)
  /// Facture emise PAR LE FORMATEUR a l'organisme pour cette session.
  ///
  /// Elle lui appartient : c'est son SIRET qui l'engage, et lui seul l'emet,
  /// depuis son propre compte. La plateforme ne fait que la mettre en forme et
  /// la numeroter dans SA sequence a lui — il n'y a aucun mandat de
  /// facturation, et l'organisme ne peut pas la creer a sa place.
  ///
  /// Une seule par session : le lien unique tient lieu de verrou.
  trainerInvoiceId String?       @unique
  trainerInvoice   Invoice?      @relation("SessionTrainerInvoice", fields: [trainerInvoiceId], references: [id], onDelete: SetNull)
  status           SessionStatus @default(SCHEDULED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  inscriptions   Inscription[]
  emargements    Emargement[]
  qualiopiProofs QualiopiProof[]

  @@index([formationId, startDate])
  @@index([trainerId])
}

/// INSCRIPTION : un apprenant sur une session.
model Inscription {
  id                  String            @id @default(cuid())
  sessionId           String
  session             FormationSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId           String?
  learner             User?             @relation("InscriptionLearner", fields: [learnerId], references: [id], onDelete: SetNull)
  learnerName         String?
  learnerEmail        String?
  payerAccountId      String?
  payerAccount        Account?          @relation("InscriptionPayer", fields: [payerAccountId], references: [id], onDelete: SetNull)
  financing           FinancingType     @default(ESTABLISHMENT)
  status              InscriptionStatus @default(PENDING)
  /// EVALUATION A CHAUD — recueillie en fin de session.
  /// Indicateur 30 du referentiel national qualite : l'organisme recueille les
  /// appreciations des beneficiaires. Le champ existait ; rien ne le remplissait.
  satisfaction        Int?
  satisfactionComment String?
  satisfactionAt      DateTime?
  /// Resultat de l'evaluation des acquis (indicateur 11).
  evalResult          String?
  /// EVALUATION A FROID — recueillie quelques mois apres, sur le terrain.
  /// C'est elle qui distingue un organisme audite d'un organisme qui remplit
  /// des cases : elle mesure ce qui reste une fois la salle quittee.
  coldRating          Int?
  /// Mise en oeuvre des acquis : OUI / PARTIELLEMENT / NON.
  coldTransfer        String?
  coldComment         String?
  coldAt              DateTime?
  attestationUrl      String?
  certificatUrl       String?
  invoiceId           String?           @unique
  invoice             Invoice?          @relation("InscriptionInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  emargements Emargement[]
  tutorat     Tutorat?

  @@index([sessionId, status])
  @@index([learnerId])
}

/// EMARGEMENT : presence signee par apprenant et par creneau.
model Emargement {
  id            String           @id @default(cuid())
  sessionId     String
  session       FormationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inscriptionId String
  inscription   Inscription      @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  slotDate      DateTime
  slot          EmargementSlot   @default(MORNING)
  present       Boolean          @default(false)
  signatureUrl  String?
  signedAt      DateTime?
  createdAt     DateTime         @default(now())

  @@unique([inscriptionId, slotDate, slot])
  @@index([sessionId])
}

enum FormationType {
  CERTIFIANTE
  INTERNE
}

enum FormationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  OPEN
  FULL
  RUNNING
  DONE
  CANCELLED
}

enum InscriptionStatus {
  PENDING
  CONFIRMED
  ATTENDED
  CERTIFIED
  CANCELLED
}

enum FinancingType {
  CPF
  OPCO
  ESTABLISHMENT
  PERSONAL
  POLE_EMPLOI
  INTERNE
}

enum EmargementSlot {
  MORNING
  AFTERNOON
}

// ---------------------------------------------------------------------------
// CONFORMITE QUALIOPI (7 criteres / 32 indicateurs + preuves) — Phase 3
// ---------------------------------------------------------------------------

/// Un des 7 criteres Qualiopi (donnees de reference, seedees).
model QualiopiCriterion {
  id         String              @id @default(cuid())
  number     Int                 @unique
  title      String
  indicators QualiopiIndicator[]
}

/// Un des 32 indicateurs, rattache a un critere (donnees de reference, seedees).
model QualiopiIndicator {
  id          String            @id @default(cuid())
  criterionId String
  criterion   QualiopiCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  number      Int               @unique
  label       String
  proofs      QualiopiProof[]

  @@index([criterionId])
}

/// PREUVE deposee par l'OF (ADePA) pour un indicateur.
model QualiopiProof {
  id          String            @id @default(cuid())
  indicatorId String
  indicator   QualiopiIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  ofAccountId String
  ofAccount   Account           @relation("QualiopiOf", fields: [ofAccountId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     FormationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  label       String?
  documentUrl String?
  status      ProofStatus       @default(TODO)
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([indicatorId, ofAccountId])
  @@index([ofAccountId, status])
}

// ---------------------------------------------------------------------------
// TUTORAT / ACCOMPAGNEMENT (tuteur, entretiens, jalons, projet d'avenir)
// ---------------------------------------------------------------------------

model Tutorat {
  id            String        @id @default(cuid())
  inscriptionId String        @unique
  inscription   Inscription   @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  tutorId       String
  tutor         User          @relation("TutoratTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  projetAvenir  String?
  status        TutoratStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  entretiens Entretien[]
  jalons     Jalon[]

  @@index([tutorId])
}

model Entretien {
  id        String   @id @default(cuid())
  tutoratId String
  tutorat   Tutorat  @relation(fields: [tutoratId], references: [id], onDelete: Cascade)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([tutoratId])
}

model Jalon {
  id        String      @id @default(cuid())
  tutoratId String
  tutorat   Tutorat     @relation(fields: [tutoratId], references: [id], onDelete: Cascade)
  label     String
  dueDate   DateTime?
  status    JalonStatus @default(PENDING)
  createdAt DateTime    @default(now())

  @@index([tutoratId])
}

enum ProofStatus {
  TODO
  UPLOADED
  VALIDATED
  REJECTED
}

enum TutoratStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum JalonStatus {
  PENDING
  DONE
}

// ---------------------------------------------------------------------------
// COFFRE-FORT DE CONFORMITE — pieces obligatoires des intervenants (P3)
// CNI, casier judiciaire (B3), permis, IBAN/RIB, attestation auto-entrepreneur...
// Suivi par compte (etablissement ou freelance) avec statut + echeance.
// ---------------------------------------------------------------------------

/// Piece justificative reglementaire suivie pour un intervenant dans un compte.
model ComplianceDocument {
  id        String            @id @default(cuid())
  /// Le professionnel concerne par la piece.
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Le compte qui suit le dossier (etablissement ou freelance).
  accountId String
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      ComplianceDocType
  label     String?
  status    ComplianceStatus  @default(MISSING)
  /// Ancien mode : adresse web saisie à la main. Conservé pour l'existant.
  fileUrl   String?
  /// Nouveau mode : fichier réellement déposé dans le dépôt privé.
  fileId    String?
  file      FileAsset?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  issuedAt  DateTime?
  expiresAt DateTime?
  notes     String?
  /// Note de pré-contrôle automatique (lecture du fichier) et sa date. Jamais une validation.
  preControle   Json?
  preControleLe DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, accountId, type])
  @@index([accountId])
  @@index([userId])
}

enum ComplianceDocType {
  IDENTITY
  /// Diplôme d'État (DEES, DEME, DEAES, DEEJE...). Pièce la plus regardée
  /// par un établissement : elle conditionne le poste, pas seulement l'accès.
  DIPLOMA
  CRIMINAL_RECORD
  DRIVING_LICENSE
  IBAN
  AUTOENTREPRENEUR
  VITALE
  OTHER
}

enum ComplianceStatus {
  MISSING
  PENDING
  VALID
  EXPIRED
}

/// Diplôme / formation du CV freelance (repris de Symfony : Qualification).
model Qualification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String // Intitulé du diplôme / de la formation
  organization String? // École, organisme
  year         String? // Année d'obtention (texte libre)
  createdAt    DateTime @default(now())

  @@index([userId])
}

/// Expérience professionnelle du CV freelance (repris de Symfony : Experience).
model Experience {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String // Poste / structure
  year        String? // Période (texte libre)
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// Demande de contact publique (repris de Symfony : Contact / NewRequest).
/// MESSAGERIE INTERNE VERS LA PLATEFORME (09/09/2026).
///
/// Jusqu'ici, une personne inscrite qui rencontrait un probleme n'avait que le
/// formulaire de contact public : elle re-saisissait son nom et son adresse,
/// le message arrivait sans savoir de quel compte il venait, et la reponse
/// partait par courriel, hors de toute trace. Un fil rattache au compte reste
/// lisible des deux cotes, garde l'historique, et se retrouve.
model SupportTicket {
  id              String           @id @default(cuid())
  /// Le compte depuis lequel le fil a ete ouvert (un utilisateur peut en avoir
  /// plusieurs). SetNull : la suppression d'un compte n'efface pas l'echange.
  accountId       String?
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  userId          String
  user            User             @relation("SupportAuteur", fields: [userId], references: [id], onDelete: Cascade)
  sujet           String
  categorie       SupportCategorie @default(AUTRE)
  statut          SupportStatut    @default(OUVERT)
  /// Date du dernier message, quel qu'en soit l'auteur : c'est le seul ordre
  /// utile pour une boite de reception.
  dernierAt       DateTime         @default(now())
  /// Deux dates de lecture, une par cote : chacun voit ce qu'il n'a pas lu
  /// sans marquer l'autre comme lu.
  luParPersonneAt DateTime?
  luParEquipeAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        SupportMessage[]

  @@index([statut, dernierAt])
  @@index([userId, dernierAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Nul quand le message vient de l'equipe : c'est Les Extras qui parle, pas
  /// une personne nommee, et la reponse ne doit pas designer un salarie.
  auteurId  String?
  auteur    User?         @relation("SupportMessageAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  parEquipe Boolean       @default(false)
  corps     String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

enum SupportStatut {
  OUVERT
  EN_COURS
  RESOLU
}

enum SupportCategorie {
  PROBLEME_TECHNIQUE
  QUESTION_COMPTE
  RESERVATION
  FACTURATION
  FICHE_ATELIER
  AUTRE
}

model ContactRequest {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  type      String? // Sujet / type de demande
  content   String
  status    ContactRequestStatus @default(NEW)
  /// Origine de la demande : utm_source, sinon domaine référent, sinon "direct".
  source    String?
  createdAt DateTime             @default(now())

  @@index([status, createdAt])
  @@index([source])
}

enum ContactRequestStatus {
  NEW
  HANDLED
}

/// Catégorie fonctionnelle d'un fichier déposé. Sert au contrôle d'accès :
/// une pièce de conformité n'obéit pas aux mêmes règles qu'un avatar.
enum FileKind {
  /// Coffre-fort : CNI, casier, diplôme, URSSAF, RIB, permis. Le plus sensible.
  COMPLIANCE
  /// Pièce jointe d'une mission de renfort (fiche de poste, protocole…).
  MISSION
  /// Photo de profil.
  AVATAR
  /// Support pédagogique, émargement signé, preuve Qualiopi.
  FORMATION
  /// Illustration d'une actualité. Lisible sans authentification :
  /// un article public doit afficher ses images à un visiteur non connecté.
  ARTICLE
  /// Photo d'une fiche atelier / service. Lisible sans authentification, pour
  /// la même raison qu'ARTICLE : le catalogue est public. Ajoutée le 3/09/2026
  /// avec l'obligation d'au moins une image à la création d'un atelier — sans
  /// famille publique, la photo déposée aurait répondu 401 au visiteur.
  SERVICE
  /// Modèle d'écrit déposé pour apprendre une trame maison. Contient de vrais
  /// noms de personnes accompagnées : accès restreint à son déposant et aux
  /// responsables du compte, jamais d'URL publique.
  TRAME
  /// MÉDIATHÈQUE D'UNE FORMATION : la vidéo, l'audio ou le document qui fait
  /// le contenu d'une leçon. Lisible sans authentification, comme ARTICLE et
  /// SERVICE — un apprenant ouvre son cours avec un jeton, pas avec un compte,
  /// et le lecteur vidéo du navigateur ne sait pas présenter d'en-tête.
  /// C'est la famille qui rend l'académie autonome : sans elle, les vidéos
  /// resteraient hébergées chez un prestataire extérieur.
  MEDIA
  /// PIÈCE JOINTE D'UN MESSAGE. Jamais publique : un fil de discussion du
  /// médico-social peut porter des informations sur une personne accompagnée.
  /// L'accès est vérifié fil par fil, participant par participant.
  MESSAGE
  /// DEVIS SIGNÉ déposé par le demandeur. Lisible par les deux parties du
  /// devis (client et intervenant), et par personne d'autre.
  QUOTE
}

/// Un fichier réellement stocké (objet dans le dépôt privé), avec sa fiche
/// d'identité. Aucune URL publique : le téléchargement passe par l'API, qui
/// vérifie les droits à chaque requête.
model FileAsset {
  id           String   @id @default(cuid())
  /// Clé de l'objet dans le dépôt. Jamais devinable (identifiant aléatoire).
  storageKey   String   @unique
  /// Nom tel que déposé par la personne — sert uniquement à l'affichage
  /// et au nom du fichier téléchargé.
  originalName String
  mimeType     String
  /// Taille en octets.
  size         Int
  /// Empreinte SHA-256, pour détecter un doublon ou une altération.
  checksum     String
  kind         FileKind
  /// Qui a déposé le fichier.
  uploaderId   String?
  uploader     User?    @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  /// Compte dans le périmètre duquel le fichier a été déposé.
  accountId    String?
  account      Account? @relation("FileAccount", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  complianceDocuments  ComplianceDocument[]
  tramesMaison         TrameMaison[]         @relation("TrameSource")
  missions             ReliefMission[]
  documents            Document[]
  avatarOf             User[]                @relation("UserAvatar")
  piecesAssociation    PieceAssociation[]    @relation("PieceAssociationFichier")
  documentsAssociation DocumentAssociation[] @relation("DocumentAssociationFichier")
  piecesMessage        MessagePiece[]
  devisSignes          Quote[]               @relation("QuoteSigned")

  @@index([uploaderId])
  @@index([accountId])
  @@index([kind])
}

/// Fiche mise de côté par un utilisateur.
/// Le cœur du site historique : un directeur repère trois ateliers en réunion
/// et y revient plus tard. Stocké côté serveur pour survivre au changement
/// d'appareil, contrairement à un simple stockage navigateur.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
}

/// LE VIVIER D'UN ETABLISSEMENT.
///
/// Ce qu'un chef de service veut d'abord, ce n'est pas trouver quelqu'un :
/// c'est retrouver la personne qui connait deja le groupe, les habitudes de la
/// maison et le prenom des jeunes. Le remplacement le moins couteux est celui
/// qu'on n'a pas a expliquer.
///
/// La plateforme savait deja calculer ce vivier — `intervenantsConnus()` liste
/// les comptes ayant deja travaille pour l'etablissement — mais uniquement en
/// interne, pour decider a qui diffuser une offre. Rien ne l'affichait, rien ne
/// permettait de l'enrichir, et surtout rien ne permettait de rappeler
/// quelqu'un directement.
///
/// Cette table porte la partie choisie du vivier : les intervenants qu'un
/// responsable a explicitement retenus, avec une note de service. Les habitues
/// detectes automatiquement s'y ajoutent a la lecture, sans etre stockes.
///
/// Choix assume : il n'existe PAS de liste noire symetrique. Un registre
/// d'intervenants « a eviter », invisible de l'interesse, serait un fichier de
/// reputation — lourd de consequences pour un professionnel dont c'est le
/// gagne-pain, et redevable du droit d'acces. Ne pas rappeler quelqu'un se
/// fait tres bien sans l'ecrire.
model PoolMember {
  id                   String   @id @default(cuid())
  /// L'etablissement qui tient le vivier.
  accountId            String
  account              Account  @relation("PoolEtablissement", fields: [accountId], references: [id], onDelete: Cascade)
  /// Le compte intervenant retenu.
  intervenantAccountId String
  intervenantAccount   Account  @relation("PoolIntervenant", fields: [intervenantAccountId], references: [id], onDelete: Cascade)
  /// Note de service : « connait le groupe des ados », « dispo le mercredi ».
  /// Visible de l'etablissement seul.
  note                 String?
  /// Qui l'a ajoute : utile quand plusieurs chefs de service partagent le compte.
  addedById            String?
  addedBy              User?    @relation("PoolAjoutePar", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([accountId, intervenantAccountId])
  @@index([accountId])
  @@index([intervenantAccountId])
}

/// LES REGLES DE TEMPS DE TRAVAIL DE L'ETABLISSEMENT.
///
/// Rien de ce qui figure ici n'est impose par la loi, et c'est la raison
/// d'etre de cette table. Dans le secteur social et medico-social, la SEULE
/// majoration legale est celle du 1er mai (article L. 3133-6). La nuit ouvre
/// un repos compensateur obligatoire mais une compensation salariale
/// seulement « le cas echeant » (L. 3122-8) ; le dimanche ne donne lieu a
/// aucune majoration legale, les ESSMS relevant d'une derogation permanente
/// au repos dominical (R. 3132-5) ; les dix feries autres que le 1er mai sont
/// travaillables sans majoration.
///
/// Ecrire ces taux en dur dans le code produirait des chiffrages faux pour
/// tous les etablissements — et faux dans le sens le plus dangereux : un cout
/// annonce qui ne correspond pas a ce qui sera paye. Chaque structure les lit
/// donc dans SA convention et les saisit ici.
model ParametresTemps {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Convention appliquee, a titre documentaire : CCN 51, CCN 66, CHRS, autre.
  convention       String?
  /// Un accord d'entreprise existe-t-il ? Il commute tout le moteur entre la
  /// branche conventionnelle et la branche suppletive.
  accordEntreprise Boolean @default(false)

  // --- Nuit -----------------------------------------------------------------
  /// Plage de nuit. A defaut d'accord, la loi retient 21 h - 6 h (L. 3122-20).
  /// L'accord de branche du 17 avril 2002 demande 9 heures continues a
  /// positionner dans l'amplitude 21 h - 7 h.
  nuitDebutHeure Int     @default(21)
  nuitFinHeure   Int     @default(6)
  /// Majoration de nuit, en pourcentage. Zero par defaut : la loi n'en impose
  /// aucune, et inventer un taux serait pire que ne rien afficher.
  nuitPct        Decimal @default(0) @db.Decimal(5, 2)

  // --- Dimanche et feries ---------------------------------------------------
  dimanchePct          Decimal @default(0) @db.Decimal(5, 2)
  feriePct             Decimal @default(0) @db.Decimal(5, 2)
  /// Cumul dimanche + ferie quand un ferie tombe un dimanche. La CCN 51
  /// l'exclut expressement (annexe III, art. A3.3).
  cumulDimancheEtFerie Boolean @default(false)

  // --- Droit local ----------------------------------------------------------
  /// Moselle, Bas-Rhin, Haut-Rhin : Saint-Etienne le 26 decembre.
  droitLocal    Boolean @default(false)
  /// Le Vendredi saint n'est pas departemental mais COMMUNAL : l'article
  /// L. 3134-13 le reserve aux communes disposant d'un temple protestant ou
  /// d'une eglise mixte. Un simple drapeau Alsace-Moselle serait faux.
  vendrediSaint Boolean @default(false)

  // --- Heures supplementaires -----------------------------------------------
  /// Valeurs SUPPLETIVES (L. 3121-36 et D. 3121-24), pas d'ordre public : un
  /// accord peut les modifier, dans la limite du plancher de 10 % (L. 3121-33).
  majorationHS1Pct Decimal @default(25) @db.Decimal(5, 2)
  majorationHS2Pct Decimal @default(50) @db.Decimal(5, 2)
  seuilBasculeHS   Int     @default(8)
  contingentAnnuel Int     @default(220)

  // --- Annualisation --------------------------------------------------------
  /// Seuil de declenchement des heures supplementaires. 1607 h est un
  /// PLAFOND (L. 3121-41 ; Cass. soc. 11 mai 2016 n° 14-29.512) : un accord
  /// peut descendre en dessous, jamais monter au-dessus.
  seuilDeclenchementHS Int  @default(1607)
  /// Limite hebdomadaire haute de la modulation. L'accord de branche du
  /// 1er avril 1999 retient 44 h. Les heures au-dela sont supplementaires
  /// immediatement et NE sont PAS recomptees en fin de periode (L. 3121-44).
  limiteHebdoHaute     Int?
  /// Limite basse de la modulation. L'accord de 1999 retient 21 h.
  limiteHebdoBasse     Int?
  /// Delai de prevenance d'un changement d'horaire. 7 jours a defaut
  /// d'accord (L. 3121-47).
  delaiPrevenanceJours Int  @default(7)

  // --- Conges du secteur ----------------------------------------------------
  /// Conges trimestriels : 18 jours pour le personnel educatif de la CCN 66,
  /// 9 pour l'administratif, 9 en CHRS. Ils reduisent le volume PLANIFIABLE
  /// sans modifier le seuil de declenchement des heures supplementaires —
  /// c'est la distinction la plus couteuse a rater.
  congesTrimestrielsEducatif Int @default(0)
  congesTrimestrielsAutres   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Types d'écrits professionnels que l'assistant sait produire.
enum AssistantTrame {
  NOTE_OBSERVATION
  RAPPORT_SITUATION
  TRANSMISSION
  /// Écrit libre : la personne donne elle-même le titre du document.
  ECRIT_LIBRE
  SYNTHESE_REUNION
  COMPTE_RENDU_ATELIER
  /// Courrier aux titulaires de l'autorité parentale : demande d'autorisation
  /// (sortie, séjour, soins, droit à l'image) motivée et assortie d'un
  /// coupon-réponse. L'écrit que les équipes repoussent le plus.
  COURRIER_AUTORITE_PARENTALE
  /// Courrier à un partenaire : référent ASE, MDPH, établissement scolaire,
  /// service de soin. Point de situation factuel et daté.
  COURRIER_PARTENAIRE
  /// Bilan de fin d'accompagnement : parcours, acquis, points de vigilance,
  /// relais proposés.
  BILAN_FIN_ACCOMPAGNEMENT
}

/// À qui profite une trame importée.
enum PorteeTrame {
  /// Visible de son seul auteur. Le cas de l'intervenant indépendant.
  PERSONNELLE
  /// Publiée par un responsable : toute l'équipe du compte la voit et
  /// l'utilise. C'est le levier d'homogénéité des écrits d'un établissement.
  ETABLISSEMENT
}

/// LA TRAME MAISON — le modèle d'écrit propre à un professionnel ou à un
/// établissement, appris à partir d'un document réel qu'il a déjà rendu.
///
/// Raison d'être : chaque MECS, chaque IME a ses intitulés, son ordre, ses
/// formules — imposés par la direction, par l'ASE ou par le juge. Un assistant
/// qui rend un texte dans SA structure à lui oblige à tout reprendre pour le
/// faire rentrer dans le modèle de la maison ; autant écrire directement.
/// C'est cette friction-là qui fait qu'un outil est essayé une fois puis
/// abandonné.
///
/// Ce qui est appris est un SQUELETTE : les intitulés de sections, leur ordre,
/// la longueur habituelle de chacune, le registre. Il est extrait du document
/// après pseudonymisation, et il est le seul élément renvoyé au modèle à
/// chaque génération — ce qui le rend court, donc peu coûteux.
model TrameMaison {
  id           String          @id @default(cuid())
  accountId    String
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId     String
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  nom          String
  /// Genre d'écrit auquel la trame se rattache (facultatif : une trame peut
  /// servir à plusieurs genres).
  genre        AssistantTrame?
  portee       PorteeTrame     @default(PERSONNELLE)
  /// Les intitulés et l'ordre des sections, tels qu'appris du modèle.
  squelette    String
  /// Le registre : personne, temps, formules d'usage, longueurs attendues.
  style        String
  /// Court extrait ANONYMISÉ du modèle, pour que le moteur « entende » le ton.
  /// Jamais de nom : la pseudonymisation est passée avant l'extraction.
  extrait      String?
  /// Document d'origine, conservé dans le compte. Il porte de vrais noms :
  /// son accès suit les mêmes règles que le reste du dépôt (jamais d'URL
  /// publique, contrôle des droits à chaque téléchargement).
  sourceFileId String?
  sourceFile   FileAsset?      @relation("TrameSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
  /// Compteur d'usage : sert à trier les trames utiles et à repérer les mortes.
  usages       Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  documents AssistantDocument[]

  @@index([accountId, portee])
  @@index([authorId])
}

/// Écrit professionnel VALIDÉ par son auteur.
/// Volontairement, seul le document final est conservé : les notes brutes
/// dictées par l'éducateur ne sont jamais persistées — c'est la promesse
/// de confidentialité qui rend l'outil acceptable dans ce secteur.
model AssistantDocument {
  id            String         @id @default(cuid())
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  trame         AssistantTrame
  /// Trame maison utilisée pour produire ce document, le cas échéant.
  trameMaisonId String?
  trameMaison   TrameMaison?   @relation(fields: [trameMaisonId], references: [id], onDelete: SetNull)
  title         String
  /// Contenu final, relu et validé par l'auteur (les vrais noms y figurent :
  /// il reste dans le compte de l'établissement, jamais envoyé à un tiers).
  content       String
  /// LES PERSONNES DONT PARLE CE DOCUMENT, EN PSEUDONYMES STABLES.
  ///
  /// « M.D-1 », jamais « Marie Dupont » : ce champ est la clé qui permet à LEX
  /// de retrouver ce qu'il a déjà écrit sur quelqu'un, sans qu'un seul nom réel
  /// ne s'inscrive ici. Les codes viennent de `LexPseudonyme`, qui ne stocke
  /// lui-même qu'une empreinte HMAC salée par le compte.
  ///
  /// ⚠ SANS CE CHAMP, RIEN NE SE CHAÎNE. Le registre des pseudonymes existait
  /// depuis le 25/08/2026 et disait déjà, en commentaire, ce qui manquait :
  /// « un rapport de situation repart de zéro là où il devrait écrire une
  /// évolution ». Il repartait de zéro parce qu'aucun document ne disait de qui
  /// il parlait. C'est ce que ce tableau répare.
  sujets        String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([accountId, createdAt])
  @@index([authorId])
  /// La recherche d'antériorité interroge ce tableau : index GIN, sinon chaque
  /// génération balaie tous les écrits du compte.
  @@index([sujets], type: Gin)
}

/// Retour utilisateur sur une génération (pouce haut/bas + commentaire).
/// C'est ce qui permet d'améliorer les trames, et une preuve de suivi
/// sérieuse à présenter aux directions.
model AssistantFeedback {
  id        String         @id @default(cuid())
  accountId String
  userId    String
  trame     AssistantTrame
  utile     Boolean
  comment   String?
  createdAt DateTime       @default(now())

  @@index([trame, utile])
}

/// LA MEMOIRE DE LEX — CE QU'UNE PERSONNE REPREND A CHAQUE FOIS.
///
/// Rien de sensible ici : un destinataire, un registre, une longueur, des
/// parties. On retient la derniere combinaison retenue, PAR PERSONNE ET PAR
/// GENRE D'ECRIT, pour que le formulaire s'ouvre deja regle. Trois notes
/// d'observation « pour l'equipe, factuel, une page » et la quatrieme s'ouvre
/// ainsi. Un reglage se corrige d'un clic : c'est une proposition, jamais
/// une contrainte.
model LexPreference {
  id            String         @id @default(cuid())
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trame         AssistantTrame
  destinataire  String?
  registre      String?
  longueur      String?
  sections      String[]       @default([])
  /// Trame maison retenue la derniere fois pour ce genre d'ecrit.
  trameMaisonId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, accountId, trame])
}

/// LE LEXIQUE DE LA MAISON.
///
/// Ce que les gens corrigent dans le brouillon en dit plus long qu'un
/// questionnaire : si « usager » devient toujours « personne accompagnee »,
/// c'est le mot de la maison, et LEX doit l'employer. On garde le couple de
/// mots, jamais la phrase ou il apparaissait — un lexique est une liste de
/// vocabulaire, pas une archive de situations.
model LexMot {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Le mot que LEX propose spontanement, normalise (minuscules, sans accent).
  source    String
  /// Le mot retenu par la maison, dans sa forme d'origine.
  retenu    String
  /// Combien de fois la correction a ete observee. Au-dela du seuil elle entre
  /// dans la consigne : une correction isolee ne fait pas une regle.
  vus       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, source])
  @@index([accountId, vus])
}

/// LE REGISTRE DES PSEUDONYMES.
///
/// Aujourd'hui le masque change a chaque envoi : « Marie D. » est
/// [PERSONNE-A] ce matin et [PERSONNE-B] cet apres-midi. Rien ne peut donc se
/// chainer d'un ecrit a l'autre, et un rapport de situation repart de zero au
/// lieu d'ecrire une evolution.
///
/// Un pseudonyme FIXE, propre au compte, regle cela : « M.D-1 » designe la
/// meme personne d'un document a l'autre, et aucun nom reel n'est stocke ni
/// envoye au moteur. C'est la pseudonymisation au sens de l'article 4-5 du
/// RGPD, et c est ce qui se defend devant un controle.
///
/// `empreinte` est un hachage du nom, sale par le compte : on reconnait un nom
/// deja vu, on ne peut pas le reconstituer depuis la base.
model LexPseudonyme {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  empreinte String
  pseudo    String
  createdAt DateTime @default(now())

  @@unique([accountId, empreinte])
  @@unique([accountId, pseudo])
}

/// Motif d'attribution de points de fidélité.
enum PointReason {
  /// Toute première fiche créée par le compte : petit coup de pouce au
  /// démarrage, versé une seule fois dans la vie du compte.
  PREMIERE_FICHE
  /// Une fiche atelier/formation publiée.
  PUBLICATION
  /// Un article publié sur l'Édublog.
  ARTICLE
  /// Une mission ou un atelier réalisé.
  MISSION
  /// Un avis positif reçu (4 ou 5 étoiles).
  AVIS
  /// Une idée retenue dans la boîte à idées.
  IDEE
  /// Une réponse apportée à un pair dans l'Entraide.
  REPONSE
  /// Une réponse désignée comme utile par l'auteur de la question.
  REPONSE_RETENUE
  /// Filleul parraine qui termine sa premiere mission (verse aux deux).
  PARRAINAGE
  /// Ajustement manuel par un administrateur.
  MANUEL
  /// Points dépensés en réduction.
  DEPENSE
}

/// Historique des points : chaque ligne explique un mouvement de solde.
model LoyaltyPoint {
  id        String      @id @default(cuid())
  accountId String
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Positif = gagné, négatif = dépensé.
  amount    Int
  reason    PointReason
  label     String
  createdAt DateTime    @default(now())

  @@index([accountId, createdAt])
}

enum IdeaStatus {
  NEW
  PLANNED
  DONE
  DECLINED
}

/// Boîte à idées : les utilisateurs proposent, votent, l'équipe arbitre.
model Idea {
  id        String     @id @default(cuid())
  accountId String
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId  String
  title     String
  content   String
  status    IdeaStatus @default(NEW)
  /// Réponse publique de l'équipe.
  reply     String?
  votes     IdeaVote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

model IdeaVote {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([ideaId, userId])
}

/// Abonnement d'un navigateur aux notifications push (Web Push).
/// Un utilisateur peut en avoir plusieurs : téléphone, tablette, poste de travail.
model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// URL du service de push du navigateur (Google, Mozilla, Apple…). Identifiant unique de l'appareil.
  endpoint  String    @unique
  /// Clé publique de l'appareil, pour chiffrer le message.
  p256dh    String
  /// Sel d'authentification fourni par le navigateur.
  auth      String
  /// Libellé lisible, pour que la personne reconnaisse son appareil.
  appareil  String?
  /// Dernier envoi réussi : sert à repérer les abonnements morts.
  dernierOk DateTime?
  /// Nombre d'échecs consécutifs. Au-delà d'un seuil, on supprime.
  echecs    Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Réglages techniques persistés (clés VAPID…). Une ligne par clé.
/// Évite de dépendre d'une variable d'environnement à poser à la main.
model Reglage {
  cle    String   @id
  valeur String
  majLe  DateTime @updatedAt
}

/// CONTRAT À DURÉE DÉTERMINÉE.
///
/// Pivot du modèle : l'établissement est l'EMPLOYEUR, la plateforme ne fournit
/// personne. Ce modèle porte le contrat que l'établissement conclut lui-même
/// avec l'intervenant — d'où `accountId` = employeur et `userId` = salarié,
/// sans aucune notion de commission ni de facturation de mission.
model ContratCDD {
  id        String         @id @default(cuid())
  /// Établissement employeur. C'est lui qui signe et qui est responsable.
  accountId String
  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Salarié embauché.
  userId    String
  user      User           @relation("ContratSalarie", fields: [userId], references: [id], onDelete: Cascade)
  /// Besoin de renfort à l'origine du recrutement, si le contrat en vient.
  missionId String?
  mission   ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  // — Mentions obligatoires, art. L. 1242-12 du code du travail —
  motif                        MotifRecoursCDD
  salarieRemplaceNom           String?
  salarieRemplaceQualification String?
  dateDebut                    DateTime
  /// Terme précis. Nul quand le contrat est à terme imprécis.
  dateFin                      DateTime?
  /// Durée minimale, obligatoire quand le terme est imprécis.
  dureeMinimaleJours           Int?
  poste                        String?
  qualification                String?
  /// Le poste figure-t-il sur la liste des postes à risques particuliers ?
  posteARisques                Boolean?
  conventionCollective         String?         @default("CCN 66")
  remunerationBrute            Decimal?        @db.Decimal(10, 2)
  remunerationDetail           String?
  caisseRetraiteComplementaire String?
  organismePrevoyance          String?
  periodeEssaiJours            Int?

  // — Cycle de vie —
  statut           StatutContratCDD @default(BROUILLON)
  /// Déclaration préalable à l'embauche : au plus tôt 8 jours avant.
  dpaeEffectueeLe  DateTime?
  dpaeReference    String?
  /// Transmission au salarié : 2 jours ouvrables (art. L. 1242-13).
  transmisLe       DateTime?
  signeSalarieLe   DateTime?
  signeEmployeurLe DateTime?
  /// Cause de fin, qui décide de l'indemnité de précarité (art. L. 1243-10).
  causeFin         String?
  termineLe        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, dateDebut])
  @@index([userId, dateDebut])
  @@index([statut])
}

enum MotifRecoursCDD {
  REMPLACEMENT_SALARIE_ABSENT
  REMPLACEMENT_ATTENTE_ENTREE
  REMPLACEMENT_POSTE_SUPPRIME
  ACCROISSEMENT_TEMPORAIRE
}

enum StatutContratCDD {
  BROUILLON
  TRANSMIS
  SIGNE
  ACTIF
  TERMINE
  ROMPU
}

/// SIGNATURE ELECTRONIQUE — le faisceau de preuves.
///
/// Ce que produit ce module est une signature electronique SIMPLE au sens du
/// reglement eIDAS, assortie d'un faisceau de preuves. Elle est parfaitement
/// valable : l'article 1367 du code civil reconnait la signature electronique
/// des lors que le procede identifie son auteur et garantit son lien avec
/// l'acte. Ce qu'elle n'est pas, et il faut le dire sans detour : une
/// signature AVANCEE ou QUALIFIEE. La difference ne tient pas a la validite
/// mais a la charge de la preuve — devant un conseil de prud'hommes, c'est
/// celui qui invoque la signature simple qui doit demontrer sa fiabilite.
///
/// D'ou ce que l'on stocke : l'empreinte du document au moment de la demande,
/// un code a usage unique envoye par courriel et verifie, l'horodatage,
/// l'adresse IP, le navigateur, et un journal d'evenements append-only. C'est
/// exactement ce qu'un juge regarde.
///
/// Le champ `prestataire` prepare la delegation a un tiers de confiance
/// (signature avancee) sans rien changer au reste du logiciel : la variable
/// d'environnement SIGNATURE_PRESTATAIRE bascule le module.
model Signature {
  id           String            @id @default(cuid())
  documentType TypeDocumentSigne
  /// Identifiant du document signe : contrat, proposition, devis.
  documentId   String
  /// Compte a l'origine de la demande.
  accountId    String
  account      Account           @relation("SignatureCompte", fields: [accountId], references: [id], onDelete: Cascade)

  /// Le signataire. `userId` est nul quand la personne n'a pas de compte.
  userId          String?
  user            User?   @relation("SignatureSignataire", fields: [userId], references: [id], onDelete: SetNull)
  signataireNom   String
  signataireEmail String

  /// Empreinte SHA-256 du document au moment de la demande. C'est elle qui
  /// prouve qu'on a signe CE texte et pas un autre : toute modification
  /// ulterieure la rend fausse.
  empreinte String

  /// Code a usage unique, stocke HACHE — jamais en clair. Meme un acces a la
  /// base ne permet pas de signer a la place de quelqu'un.
  codeHache    String?
  codeExpireLe DateTime?
  tentatives   Int       @default(0)

  statut     StatutSignature @default(EN_ATTENTE)
  signeLe    DateTime?
  refuseLe   DateTime?
  motifRefus String?

  /// Elements du faisceau de preuves, releves au moment de la signature.
  ip        String?
  userAgent String?

  /// Nul pour la signature interne ; nom du tiers de confiance sinon.
  prestataire    String?
  prestataireRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evenements SignatureEvenement[]

  @@index([documentType, documentId])
  @@index([accountId, statut])
  @@index([signataireEmail])
}

/// Journal d'une signature : append-only, jamais modifie ni supprime.
/// C'est la chronologie que l'on presente en cas de contestation.
model SignatureEvenement {
  id          String    @id @default(cuid())
  signatureId String
  signature   Signature @relation(fields: [signatureId], references: [id], onDelete: Cascade)
  /// DEMANDE, CODE_ENVOYE, CODE_ERRONE, SIGNEE, REFUSEE, EXPIREE, ANNULEE.
  type        String
  detail      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([signatureId, createdAt])
}

enum TypeDocumentSigne {
  CONTRAT_CDD
  PROPOSITION
  DEVIS
}

enum StatutSignature {
  EN_ATTENTE
  SIGNEE
  REFUSEE
  EXPIREE
  ANNULEE
}

/// ENQUÊTE DE SATISFACTION — un retour, une semaine après la première mise en
/// ligne. Demandée par Siham le 3/09/2026 : « on a besoin de feedback pour
/// améliorer l'expérience client et avoir des retours sur problème rapidement ».
///
/// ⚠ TROIS NOTES SÉPARÉES, ET C'EST LE POINT. Une note globale unique dit qu'on
/// plaît ou qu'on déplaît, jamais où ça coince. Les deux autres portent
/// exactement sur ce que Siham veut savoir : le SITE (est-il clair, se
/// trouve-t-on ?) et la PROCÉDURE de dépôt (combien ça coûte de publier sa
/// première fiche). Ce sont deux problèmes distincts, avec deux réponses
/// distinctes.
///
/// ⚠ `probleme` est traité à part de `commentaire`, à dessein : un ennui vécu
/// se traite en quelques heures, un avis se lit quand on a le temps. Mélangés,
/// le premier se perd dans le second.
model RetourExperience {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// D'où vient la sollicitation. PREMIER_ATELIER = l'enquête automatique ;
  /// SPONTANE = quelqu'un a ouvert la page de lui-même.
  source String @default("PREMIER_ATELIER")

  /// De 1 à 5. La note globale est la seule obligatoire : un formulaire qui
  /// exige cinq réponses ne se remplit pas.
  noteGlobale Int
  /// Le site : clarté, navigation, ce qu'on trouve et ce qu'on ne trouve pas.
  noteSite    Int?
  /// La procédure pour proposer ses services : dépôt de fiche, pièces, délais.
  noteDepot   Int?

  /// A rencontré un problème concret. Sépare l'incident de l'opinion.
  probleme    String?
  commentaire String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([accountId])
}

/// LE JOURNAL DES COURRIELS TRANSACTIONNELS.
///
/// ⚠ IL EXISTAIT DÉJÀ, EN MÉMOIRE, ET C'EST POUR ÇA QU'IL NE SERVAIT À RIEN.
/// `MailService` tenait un compteur et un journal dans le processus : remis à
/// zéro à chaque redéploiement, c'est-à-dire plusieurs fois par jour. On ne
/// pouvait donc jamais répondre à « est-ce que mes mails partent ? », qui est
/// la première question qu'on se pose quand un intervenant dit n'avoir rien
/// reçu.
///
/// Une ligne par envoi, réussi ou non, avec la voie empruntée (SMTP direct ou
/// repli Brevo) et le motif d'échec. C'est le minimum pour piloter, et ça ne
/// coûte qu'une écriture par courriel.
model EmailEnvoye {
  id           String   @id @default(cuid())
  destinataire String
  sujet        String
  /// 'smtp' | 'brevo' | 'aucune' : par où c'est parti, ou pourquoi pas.
  voie         String
  ok           Boolean
  /// Motif d'échec, tronqué : de quoi diagnostiquer, pas de quoi noyer l'écran.
  erreur       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([ok, createdAt])
}

/// L'ALERTE DE RECHERCHE — ce qui ramène un établissement qui n'a rien trouvé.
///
/// ⚠ C'EST LA MÉCANIQUE DE RÉTENTION QUI MANQUAIT, et elle vaut plus que
/// n'importe quel filtre supplémentaire. Un directeur cherche « médiation
/// animale, Essonne », ne trouve rien, et il est perdu définitivement : il ne
/// reviendra pas vérifier chaque semaine. Avec une alerte, c'est la plateforme
/// qui revient vers lui le jour où la fiche existe.
///
/// Les critères sont ceux du catalogue, et rien de plus : département,
/// catégorie, public visé, mots-clés, budget. On ne stocke pas une requête
/// libre en base pour la rejouer telle quelle — on stocke des champs, qu'on
/// sait relire, expliquer à la personne et corriger.
model AlerteRecherche {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Le compte au nom duquel l'alerte a été posée. Sert à l'affichage, pas au
  /// filtrage : ce qui est public l'est pour tout le monde.
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// 'atelier' | 'formation' | 'all' — le rayon du catalogue.
  type           String    @default("all")
  /// Codes INSEE. Vide = partout. Voir `common/territoires.ts`.
  departements   String[]  @default([])
  categorie      String?
  publicVise     String?
  recherche      String?
  budgetMax      Decimal?  @db.Decimal(10, 2)
  actif          Boolean   @default(true)
  /// Dernière fois qu'un courriel est parti pour cette alerte. C'est la borne
  /// qui évite de renvoyer deux fois la même fiche.
  dernierEnvoiAt DateTime?
  /// Nombre de fiches déjà signalées, pour la page de gestion.
  signalees      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([actif])
}

/// LA CAPTURE D'ADRESSE SUR UNE FICHE DE PARCOURS GRATUIT — 4/09/2026.
///
/// ⚠ POURQUOI CE MODÈLE EXISTE : les douze parcours sont le meilleur aimant du
/// site, et jusqu'ici la fiche renvoyait vers Teachizy, qui gardait l'adresse.
/// Les Extras ne conservait rien. Ce modèle est la base propre qui remplace la
/// base achetée : chaque ligne porte la DATE du consentement, la fiche demandée
/// et l'origine de la visite. C'est exactement ce qu'un contrôle demande à voir,
/// et exactement ce que la base LE SOCIAL n'avait pas.
///
/// Deux consentements distincts, et il faut les garder distincts :
///  · l'envoi de la fiche récap est le SERVICE demandé — il part toujours ;
///  · `consentTunnel` est un opt-in explicite, case décochée par défaut, pour
///    recevoir la séquence d'accueil (les parcours suivants). Sans cette case,
///    on ne renvoie jamais rien d'autre que la fiche.
///
/// Le désabonnement se fait par le `jeton`, sans compte ni mot de passe : une
/// personne qui n'a pas de compte doit pouvoir se retirer en un clic.
model CaptureFiche {
  id              String    @id @default(cuid())
  email           String
  /// Slug de la formation dont la fiche a été demandée.
  slug            String
  prenom          String?
  /// Opt-in explicite pour la séquence d'accueil. Décoché par défaut.
  consentTunnel   Boolean   @default(false)
  consentAt       DateTime  @default(now())
  /// Attribution première visite, même vocabulaire que Account.source*.
  source          String?
  sourceMedium    String?
  sourceCampaign  String?
  sourceLanding   String?
  /// Même mécanique que User.tunnelEtape : un COMPTEUR scellé avant l'envoi.
  tunnelEtape     Int       @default(0)
  tunnelDernierAt DateTime?
  desabonneAt     DateTime?
  /// Jeton opaque du lien de désabonnement.
  jeton           String    @unique @default(cuid())
  createdAt       DateTime  @default(now())

  @@unique([email, slug])
  @@index([email])
  @@index([source])
  @@index([consentTunnel, desabonneAt, tunnelEtape])
}

/// L'AUDIENCE, SANS TRACEUR — 4/09/2026.
///
/// Une ligne par jour × chemin × origine, et un compteur. Aucun identifiant de
/// personne, aucune adresse IP, aucun cookie : c'est ce qui place cette mesure
/// dans l'exemption de consentement de la CNIL (mesure d'audience strictement
/// nécessaire, sans suivi individuel ni recoupement). Le jour où quelqu'un veut
/// y ajouter un identifiant de visiteur, ce n'est plus le même objet juridique.
///
/// `source`/`medium`/`campagne` viennent de `lib/source.ts` côté web : c'est la
/// PREMIÈRE origine de la visite, la même qui est portée sur Account et sur
/// ContactRequest — les trois se comparent donc directement.
///
/// Chaînes vides plutôt que NULL dans la clé unique : Postgres considère deux
/// NULL comme distincts et l'upsert créerait une ligne par vue.
model VuePage {
  id       String   @id @default(cuid())
  jour     DateTime @db.Date
  chemin   String
  source   String   @default("direct")
  medium   String   @default("")
  campagne String   @default("")
  /// Pages vues.
  vues     Int      @default(0)
  /// Visites : première page d'une session de navigation.
  visites  Int      @default(0)

  @@unique([jour, chemin, source, medium, campagne])
  @@index([jour])
  @@index([source, jour])
}

// =============================================================================
// PILOTER MON ASSOCIATION (association.toulali.fr)
//
// Le poste de pilotage d'une association : son identité (pré-remplie depuis
// les répertoires publics), son classeur de pièces à péremption, ses dossiers
// de financement. Les référentiels (types de pièces, dispositifs, étapes du
// chemin) sont des fichiers versionnés dans apps/api/src/association/ ; la
// base ne garde que ce qui appartient à l'association.
// =============================================================================

/// Taille et organisation, pour révéler les fonctions progressivement.
enum NiveauOrganisation {
  PETITE
  GESTIONNAIRE
  RESEAU
}

/// État d'une pièce du classeur.
/// DEDUITE : prouvée par les données publiques (RNA, SIRENE), rien à déposer.
/// PRESENTE : un fichier a été déposé. A_FOURNIR : rien encore.
enum EtatPiece {
  A_FOURNIR
  DEDUITE
  PRESENTE
}

/// Cycle de vie d'un dossier de financement, du repérage au solde.
enum EtatDossier {
  REPERE
  EN_ECRITURE
  DEPOSE
  ACCORDE
  REFUSE
  SOLDE
}

model Organisation {
  id                  String             @id @default(cuid())
  accountId           String             @unique
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nom                 String
  sigle               String?
  rna                 String?
  siren               String?
  siret               String?
  natureJuridique     String?
  adresse             String?
  codePostal          String?
  commune             String?
  dateCreation        DateTime?
  niveau              NiveauOrganisation @default(PETITE)
  /// Mois de clôture de l'exercice comptable (12 = année civile).
  moisClotureExercice Int                @default(12)
  /// Étapes du chemin cochées « je l'ai fait » (slugs).
  etapesFaites        String[]           @default([])
  /// Le projet en une page : quatre questions, et ce qu'on demande.
  projetPourQui       String?
  projetQuoi          String?
  projetComment       String?
  projetApres         String?
  projetDemande       String?
  /// Vie statutaire : la dernière assemblée générale, la durée des mandats.
  dateDerniereAG      DateTime?
  dureeMandatMois     Int                @default(12)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  pieces     PieceAssociation[]
  dossiers   DossierFinancement[]
  contacts   ContactAssociation[]
  documents  DocumentAssociation[]
  actions    ActionAssociation[]
  mouvements MouvementAssociation[]

  @@index([siren])
  @@index([rna])
}

model PieceAssociation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// Code du référentiel (STATUTS, RIB, ASSURANCE_RC…).
  typeCode       String
  etat           EtatPiece    @default(A_FOURNIR)
  /// Ce que les données publiques prouvent (« Numéro RNA W… »).
  preuve         String?
  fileId         String?
  file           FileAsset?   @relation("PieceAssociationFichier", fields: [fileId], references: [id], onDelete: SetNull)
  dateEmission   DateTime?
  dateExpiration DateTime?
  /// Exercice concerné pour les pièces annuelles (comptes, rapport, budget).
  exercice       Int?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, typeCode])
  @@index([organisationId, dateExpiration])
}

/// Ce qu'on demande : une subvention (on demande de l'aide pour ce qu'on fait
/// déjà) ou un appel à projet (un financeur ouvre un concours, on candidate).
enum NatureDossier {
  SUBVENTION
  APPEL_A_PROJET
}

model DossierFinancement {
  id                  String        @id @default(cuid())
  organisationId      String
  organisation        Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// Code d'un dispositif du référentiel, s'il en vient.
  dispositifCode      String?
  financeur           String
  intitule            String
  /// Une subvention qu'on demande, ou un appel à projet auquel on répond.
  nature              NatureDossier @default(SUBVENTION)
  /// Ce que le financeur demande, recopié de l'appel : à qui il s'adresse, pour quoi.
  description         String?
  /// L'idée de projet qu'on va lui proposer.
  ideeProjet          String?
  /// Le plafond annoncé par le financeur.
  montantMax          Decimal?      @db.Decimal(12, 2)
  etat                EtatDossier   @default(REPERE)
  montantDemande      Decimal?      @db.Decimal(12, 2)
  montantAccorde      Decimal?      @db.Decimal(12, 2)
  dateLimiteDepot     DateTime?
  dateDepot           DateTime?
  dateDecision        DateTime?
  dateCompteRendu     DateTime?
  /// Codes des pièces exigées par ce financeur.
  piecesExigees       String[]      @default([])
  notes               String?
  /// Budget prévisionnel et réalisé : lignes { libelle, montant, sens: 'DEPENSE' | 'RECETTE' }.
  budgetPrevu         Json?
  budgetRealise       Json?
  /// Le compte rendu : ce que l'action a produit, en quelques phrases.
  bilanAction         String?
  nombreBeneficiaires Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([organisationId, etat])
  @@index([organisationId, dateLimiteDepot])
}

/// Un rôle dans l'association ou autour d'elle. Une personne peut en cumuler plusieurs.
enum RoleContact {
  PRESIDENT
  TRESORIER
  SECRETAIRE
  MEMBRE_BUREAU
  MEMBRE
  BENEVOLE
  SALARIE
  PARTENAIRE
  FINANCEUR
  ELU
  /// Mairie, préfecture, CAF, département, école : une institution.
  INSTITUTIONNEL
  AUTRE
}

/// Le répertoire : membres, bénévoles, dirigeants, partenaires et financeurs.
model ContactAssociation {
  id              String        @id @default(cuid())
  organisationId  String
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  prenom          String
  nom             String
  email           String?
  telephone       String?
  /// Pour un partenaire ou un financeur : sa structure (mairie, département…).
  structure       String?
  /// Son poste dans cette structure : chargée de mission, adjoint aux sports…
  poste           String?
  roles           RoleContact[] @default([])
  dateAdhesion    DateTime?
  cotisationAJour Boolean       @default(false)
  mandatDebut     DateTime?
  mandatFin       DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organisationId])
}

/// Les documents libres de l'association (au-delà des pièces du classeur).
model DocumentAssociation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  titre          String
  categorie      String?
  fileId         String?
  file           FileAsset?   @relation("DocumentAssociationFichier", fields: [fileId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
}

/// L'état d'une action : ce qu'on prépare, ce qu'on fait, ce qui est fini.
enum EtatAction {
  PREVUE
  EN_COURS
  TERMINEE
}

/// Les actions de l'association : ce qu'elle fait vraiment sur le terrain.
/// C'est la matière du rapport d'activité et des dossiers de subvention.
model ActionAssociation {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  intitule        String
  /// À quoi ça sert, pour qui, en deux phrases.
  resume          String?
  lieu            String?
  dateDebut       DateTime?
  dateFin         DateTime?
  etat            EtatAction   @default(PREVUE)
  /// Combien de personnes en ont profité.
  beneficiaires   Int?
  /// Combien de bénévoles, et combien d'heures données.
  benevoles       Int?
  heuresBenevoles Int?
  /// Ce que l'action a coûté, en euros.
  cout            Int?
  /// Avec qui : la mairie, une école, une autre association.
  partenaires     String?
  /// Ce qu'on en retient, une fois l'action finie.
  bilan           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organisationId])
}

/// L'argent qui entre, l'argent qui sort.
enum SensMouvement {
  RECETTE
  DEPENSE
}

/// D'où vient l'argent, ou à quoi il part.
enum NatureMouvement {
  DON
  ADHESION
  VENTE
  BILLETTERIE
  SUBVENTION
  MECENAT
  PRESTATION
  AUTRE_RECETTE
  ACHAT
  MATERIEL
  LOCAL
  ASSURANCE
  DEPLACEMENT
  COMMUNICATION
  SALAIRE
  BANQUE
  AUTRE_DEPENSE
}

/// Comment l'argent a circulé.
enum MoyenPaiement {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE
  EN_LIGNE
  AUTRE
}

/// Le cahier de comptes : une ligne par mouvement d'argent.
model MouvementAssociation {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sens           SensMouvement
  nature         NatureMouvement
  libelle        String
  montant        Decimal         @db.Decimal(12, 2)
  date           DateTime
  /// Qui a donné, qui a payé, ou à qui on a payé.
  tiers          String?
  moyen          MoyenPaiement?
  /// Le don a-t-il donné lieu à un reçu fiscal ?
  recuFiscal     Boolean         @default(false)
  /// Rattaché à une subvention ou à un appel à projet.
  dossierId      String?
  /// Rattaché à une action de l'association.
  actionId       String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organisationId, date])
  @@index([organisationId, sens])
}

// ---------------------------------------------------------------------------
// PILOTER MON ACADÉMIE (academie.toulali.fr)
// ---------------------------------------------------------------------------

/// LA FICHE D'UN ORGANISME DE FORMATION.
///
/// Le pendant d'`Organisation` pour l'espace association : une ligne par compte
/// de type ACADEMIE, créée en même temps que le compte, complétée ensuite.
/// Tout le métier — programmes, sessions, inscriptions, émargements, preuves
/// Qualiopi — vit déjà dans les modèles `Formation`, `FormationSession`,
/// `Inscription`, `Emargement` et `QualiopiProof` : on ne les duplique pas.
model Academie {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  nom   String
  sigle String?

  /// Numéro de déclaration d'activité délivré par la DREETS. Non bloquant à
  /// l'ouverture : une académie en cours de déclaration ouvre son espace et le
  /// renseigne le jour où elle l'a.
  nda         String?
  ndaDeposeLe DateTime?
  dreets      String?

  siren String?
  siret String?
  /// 85.59A pour la formation continue d'adultes, quand il est renseigné.
  ape   String?

  adresse    String?
  codePostal String?
  commune    String?
  telephone  String?
  courriel   String?
  siteWeb    String?

  /// Où en est la certification. C'est ce champ qui décide de ce que l'accueil
  /// met en avant le premier jour.
  qualiopi      EtatQualiopi @default(PAS_ENGAGE)
  certificateur String?
  auditPrevuLe  DateTime?
  certifieDu    DateTime?
  certifieAu    DateTime?

  /// Obligation d'affichage du référent handicap (critère 3).
  referentHandicap    String?
  referentPedagogique String?

  /// Ce qu'on affiche en une phrase, et le texte long de la page publique.
  resume       String?
  presentation String?

  /// Les étapes du chemin cochées à la main. Le reste se déduit des données.
  etapesFaites String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  veilles      VeilleEntree[]
  reclamations Reclamation[]

  @@index([qualiopi])
}

enum EtatQualiopi {
  PAS_ENGAGE
  EN_PREPARATION
  AUDIT_PLANIFIE
  CERTIFIE
  SUSPENDU
}

/// LE JOURNAL DE VEILLE — critère 6 du référentiel national qualité.
/// Trois indicateurs en dépendent (veille légale, veille métier, veille
/// handicap) et c'est le motif de non-conformité le plus fréquent en audit :
/// il ne suffit pas de faire la veille, il faut en garder la trace datée.
model VeilleEntree {
  id         String   @id @default(cuid())
  academieId String
  academie   Academie @relation(fields: [academieId], references: [id], onDelete: Cascade)

  type        TypeVeille
  date        DateTime
  titre       String
  source      String?
  lien        String?
  resume      String?
  /// Ce qu'on en a fait : c'est cette colonne que l'auditeur regarde vraiment.
  consequence String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academieId, date])
  @@index([academieId, type])
}

enum TypeVeille {
  LEGALE
  METIER
  HANDICAP
  INNOVATION
  EMPLOI
}

/// LE REGISTRE DES RÉCLAMATIONS — critère 7.
model Reclamation {
  id         String   @id @default(cuid())
  academieId String
  academie   Academie @relation(fields: [academieId], references: [id], onDelete: Cascade)

  recueLe    DateTime
  origine    OrigineReclamation @default(APPRENANT)
  auteur     String?
  objet      String
  detail     String?
  traitement String?
  clotureeLe DateTime?
  statut     StatutReclamation  @default(OUVERTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academieId, statut])
  @@index([academieId, recueLe])
}

enum OrigineReclamation {
  APPRENANT
  ENTREPRISE
  FINANCEUR
  FORMATEUR
  AUTRE
}

enum StatutReclamation {
  OUVERTE
  EN_COURS
  RESOLUE
  CLASSEE
}

// ---------------------------------------------------------------------------
// LES FORMULAIRES — un constructeur libre, dans les deux espaces
// ---------------------------------------------------------------------------

/// UN FORMULAIRE QUE LA STRUCTURE COMPOSE ELLE-MÊME.
///
/// Le principe est celui d'un Google Forms : on ajoute les questions qu'on veut,
/// dans l'ordre qu'on veut, et on publie une adresse à partager. Rien n'est
/// imposé — ni le nombre de questions, ni leur nature.
///
/// Le formulaire appartient à un COMPTE, quel que soit son espace : une
/// association l'utilise pour une adhésion ou une inscription à une sortie, une
/// académie pour un positionnement avant l'entrée en formation ou une enquête
/// de satisfaction (indicateurs Qualiopi 1, 2 et 30).
model Formulaire {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Le titre, tel qu'il s'affiche en haut de la page publique.
  titre        String
  /// Le texte d'introduction, facultatif, au-dessus de la première question.
  introduction String? @db.Text
  /// L'adresse publique : pilote.toulali.fr/f/<slug>. Unique sur tout le site.
  slug         String  @unique

  statut StatutFormulaire @default(BROUILLON)

  /// Les questions, dans l'ordre. Chaque entrée :
  /// { id, type, libelle, aide?, obligatoire, options?: string[], min?, max? }
  /// On garde du JSON : la forme d'un formulaire change à chaque formulaire, et
  /// une table de champs obligerait une migration à chaque nouveau type.
  champs Json @default("[]")

  /// Le mot qu'on affiche une fois la réponse envoyée.
  remerciement String? @db.Text

  /// Une seule réponse par personne connectée, si on le demande.
  reponseUnique Boolean   @default(false)
  /// On demande l'adresse e-mail avant d'ouvrir les questions.
  demanderEmail Boolean   @default(false)
  /// La date après laquelle le formulaire n'accepte plus de réponse.
  fermeLe       DateTime?

  reponses ReponseFormulaire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, statut])
  @@index([accountId, createdAt])
}

/// UNE RÉPONSE ENVOYÉE PAR QUELQU'UN.
///
/// Les valeurs sont rangées par identifiant de question :
/// { "<idChamp>": "texte" | ["choix", "choix"] | 3 | "2026-09-08" }
/// On garde l'e-mail à part : c'est lui qui sert à répondre, à relancer et à
/// éviter les doublons.
model ReponseFormulaire {
  id           String     @id @default(cuid())
  formulaireId String
  formulaire   Formulaire @relation(fields: [formulaireId], references: [id], onDelete: Cascade)

  email   String?
  valeurs Json    @default("{}")

  /// Ce que le navigateur a annoncé : utile pour repérer un envoi automatisé.
  source String?

  createdAt DateTime @default(now())

  @@index([formulaireId, createdAt])
  @@index([formulaireId, email])
}

enum StatutFormulaire {
  BROUILLON
  PUBLIE
  FERME
}

/// ---------------------------------------------------------------------------
/// L'ÉCOLE EN LIGNE D'UNE ACADÉMIE.
///
/// Une académie vend et anime des cours en ligne : un cours porte des
/// chapitres, un chapitre porte des leçons, une leçon peut être une vidéo, un
/// texte, un document, un quiz ou un devoir. Une personne s'inscrit, avance
/// leçon par leçon, et reçoit son attestation à la fin.
///
/// Tout appartient au compte : c'est le même garde-fou que partout ailleurs.
/// Le vocabulaire est français de bout en bout, comme le reste de Piloter, et
/// distinct de `Formation` — qui est la fiche marchande des Extras, pas un
/// parcours pédagogique.
/// ---------------------------------------------------------------------------

model Cours {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation("CoursCompte", fields: [accountId], references: [id], onDelete: Cascade)

  titre       String
  /// L'adresse publique du cours : /ecole/<slug>. Unique sur tout le site.
  slug        String  @unique
  sousTitre   String?
  description String?

  imageUrl        String?
  bandeAnnonceUrl String?

  niveau    NiveauCours @default(TOUS)
  categorie String?
  /// Ce que la personne saura faire à la fin, une ligne par objectif.
  objectifs String[]    @default([])
  prerequis String?
  pourQui   String?

  /// Renseignée à la main, ou calculée depuis les leçons quand elle vaut 0.
  dureeMinutes Int @default(0)

  /// En centimes : on ne stocke jamais un prix en flottant.
  prixCents      Int     @default(0)
  prixBarreCents Int?
  gratuit        Boolean @default(false)
  certificat     Boolean @default(false)

  /// Comment on l'apprend : à son rythme, en salle, en visio, ou les deux.
  /// Le présentiel et la classe virtuelle ne sont pas des écrans à part : ce
  /// sont des options portées par la formation elle-même.
  modalite      ModaliteCours @default(EN_LIGNE)
  /// Où ça se tient, quand il y a une salle.
  lieu          String?
  /// Le lien de la visio, quand il y en a une.
  lienVisio     String?
  /// Comment on accède au lieu en situation de handicap.
  accesHandicap String?

  /// On ne peut ouvrir une leçon qu'après avoir fait la précédente.
  lectureOrdonnee Boolean @default(false)
  /// Le nombre d'inscriptions acceptées. Vide : pas de limite.
  placesMax       Int?

  /// La TVA appliquée au prix, en pour cent. 0 pour un organisme exonéré.
  tvaPourcent Int @default(0)
  /// Le nombre de fois où le prix peut être réglé. 1 : en une fois.
  echeances   Int @default(1)

  /// Ce que lisent les moteurs de recherche, quand on veut autre chose que
  /// le titre et le sous-titre.
  seoTitre       String?
  seoDescription String?

  /// Les apprenants peuvent écrire sous une leçon.
  commentairesActifs Boolean @default(true)

  /// LA FICHE PROGRAMME DE CETTE FORMATION.
  ///
  /// Le contenu (chapitres, leçons) vit ici ; les objectifs évaluables, le
  /// public, les prérequis, la durée en heures et les sessions datées — ce que
  /// lisent un financeur et un auditeur — vivent sur `Formation`. Vue de
  /// l'organisme, c'est une seule formation : le lien les tient ensemble.
  formationId String?    @unique
  programme   Formation? @relation("CoursProgramme", fields: [formationId], references: [id], onDelete: SetNull)

  statut   StatutCours @default(BROUILLON)
  ordre    Int         @default(0)
  publieLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapitres    ChapitreCours[]
  /// Les leçons posées directement dans la formation, sans chapitre.
  leconsRacine LeconCours[]       @relation("LeconRacine")
  inscriptions InscriptionCours[]
  ventes       VenteCours[]
  classes      ClasseVirtuelle[]
  commentaires CommentaireCours[]

  @@index([accountId, statut])
  @@index([accountId, ordre])
  @@index([accountId, modalite])
}

/// COMMENT ON SUIT LA FORMATION.
enum ModaliteCours {
  EN_LIGNE
  PRESENTIEL
  VIRTUEL
  MIXTE
}

enum StatutCours {
  BROUILLON
  PUBLIE
  ARCHIVE
}

enum NiveauCours {
  TOUS
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

model ChapitreCours {
  id      String @id @default(cuid())
  coursId String
  cours   Cours  @relation(fields: [coursId], references: [id], onDelete: Cascade)

  titre          String
  resume         String?
  ordre          Int     @default(0)
  /// Un chapitre en brouillon reste écrit, mais ne se lit pas.
  publie         Boolean @default(true)
  /// Diffusion progressive : le chapitre ne s'ouvre qu'au bout de N jours
  /// comptés depuis l'inscription. Zéro : disponible tout de suite.
  ouvertureJours Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lecons LeconCours[]

  @@index([coursId, ordre])
}

model LeconCours {
  id String @id @default(cuid())

  /// Une leçon s'accroche SOIT à un chapitre, SOIT directement à la formation :
  /// le chapitre est facultatif. Les deux partagent le même « ordre », si bien
  /// qu'un chapitre et une leçon se rangent côte à côte dans la même liste.
  chapitreId String?
  chapitre   ChapitreCours? @relation(fields: [chapitreId], references: [id], onDelete: Cascade)
  coursId    String?
  cours      Cours?         @relation("LeconRacine", fields: [coursId], references: [id], onDelete: Cascade)

  titre      String
  type       TypeLecon @default(TEXTE)
  /// Le texte de la leçon, écrit dans l'atelier. Ancien format : voir « blocs ».
  contenu    String?
  /// L'adresse de la vidéo ou de l'audio hébergé (aucun fichier ici).
  videoUrl   String?
  fichierUrl String?

  /// LA LEÇON EN MORCEAUX, DANS L'ORDRE.
  ///
  /// [{ "id", "type": "titre|texte|video|audio|image|separateur|information|
  ///     fichier|pdf|lien|classe", ... }]
  /// Les leçons écrites avant les blocs sont converties au démarrage.
  blocs Json?

  dureeMinutes   Int     @default(0)
  /// Quand la durée est imposée, la leçon ne peut pas être cochée avant que
  /// ce temps se soit écoulé depuis sa première ouverture.
  dureeImposee   Boolean @default(false)
  /// Une leçon d'aperçu se lit sans avoir acheté le cours.
  apercu         Boolean @default(false)
  /// Une leçon en brouillon reste écrite, mais ne se lit pas.
  publie         Boolean @default(true)
  /// Diffusion progressive : voir ChapitreCours.ouvertureJours.
  ouvertureJours Int     @default(0)

  /// TÂCHES & MISSIONS : [{ "id", "texte" }] — une liste que l'apprenant coche.
  taches   Json?
  /// CONTENU SCORM : l'adresse de l'index d'un paquet déposé ailleurs.
  scormUrl String?

  /// { "noteMinimale": 70, "questions": [{ "id", "enonce", "type", "options", "bonnes", "points" }] }
  quiz Json?

  ordre Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progressions ProgressionLecon[]
  commentaires CommentaireCours[]

  @@index([chapitreId, ordre])
  @@index([coursId, ordre])
}

enum TypeLecon {
  TEXTE
  VIDEO
  AUDIO
  DOCUMENT
  QUIZ
  DEVOIR
  LIVE
  TACHES
  SCORM
}

/// UNE PERSONNE INSCRITE À UN COURS.
///
/// Pas de compte à créer pour apprendre : une adresse e-mail et un jeton
/// personnel suffisent. C'est ce jeton qui ouvre le cours, et lui seul.
model InscriptionCours {
  id      String @id @default(cuid())
  coursId String
  cours   Cours  @relation(fields: [coursId], references: [id], onDelete: Cascade)

  email  String
  nom    String?
  prenom String?

  /// L'adresse personnelle d'accès : /apprendre/<jeton>.
  jeton String @unique

  statut      StatutInscriptionCours @default(ACTIVE)
  /// Pourcentage de leçons faites, recalculé à chaque leçon cochée.
  progression Int                    @default(0)

  termineLe        DateTime?
  certificatEmisLe DateTime?
  derniereVisite   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progressions ProgressionLecon[]
  commentaires CommentaireCours[]

  @@unique([coursId, email])
  @@index([coursId, createdAt])
}

enum StatutInscriptionCours {
  ACTIVE
  SUSPENDUE
  TERMINEE
}

model ProgressionLecon {
  id            String           @id @default(cuid())
  inscriptionId String
  inscription   InscriptionCours @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  leconId       String
  lecon         LeconCours       @relation(fields: [leconId], references: [id], onDelete: Cascade)

  faite     Boolean   @default(false)
  faiteLe   DateTime?
  /// La première ouverture de la leçon : c'est elle qui rend la durée minimum
  /// vérifiable côté serveur, plutôt que de croire le navigateur.
  ouverteLe DateTime?
  /// Les tâches cochées : ["id", "id"…]
  taches    Json?
  /// La note du quiz, sur 100, quand la leçon en portait un.
  score     Int?

  @@unique([inscriptionId, leconId])
  @@index([leconId])
}

/// CE QU'UN APPRENANT ÉCRIT SOUS UNE LEÇON.
///
/// Une question, une remarque, un merci. L'organisme lit, répond, et masque
/// ce qui n'a rien à faire là. Rien n'est publié sans qu'il l'ait vu passer.
model CommentaireCours {
  id      String @id @default(cuid())
  coursId String
  cours   Cours  @relation(fields: [coursId], references: [id], onDelete: Cascade)

  leconId String?
  lecon   LeconCours? @relation(fields: [leconId], references: [id], onDelete: SetNull)

  inscriptionId String?
  inscription   InscriptionCours? @relation(fields: [inscriptionId], references: [id], onDelete: SetNull)

  auteur  String
  email   String?
  message String

  /// La réponse de l'organisme, écrite depuis l'atelier.
  reponse   String?
  reponduLe DateTime?

  masque Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coursId, createdAt])
  @@index([leconId])
}

/// UN PACK : plusieurs cours vendus ensemble, à un prix qui n'est pas la somme.
model PackCours {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  titre       String
  slug        String   @unique
  description String?
  imageUrl    String?
  prixCents   Int      @default(0)
  /// Les cours du pack, dans l'ordre où on les propose.
  coursIds    String[] @default([])

  statut StatutCours @default(BROUILLON)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, statut])
}

model CodePromo {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// À quoi sert ce code : pour s'y retrouver dans la liste.
  description String?

  code   String
  type   TypeRemise @default(POURCENTAGE)
  /// Un pourcentage (1 à 100) ou un montant en centimes, selon le type.
  valeur Int

  /// Vide : le code marche sur tout le catalogue.
  coursIds String[] @default([])

  debuteLe DateTime?
  expireLe DateTime?
  usageMax Int?
  usages   Int       @default(0)
  actif    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, code])
  @@index([accountId, actif])
}

enum TypeRemise {
  POURCENTAGE
  MONTANT
}

model VenteCours {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  coursId String?
  cours   Cours?  @relation(fields: [coursId], references: [id], onDelete: SetNull)
  packId  String?

  email String
  nom   String?

  /// CE QUI A ETE ENCAISSE A CE JOUR, en centimes.
  ///
  /// Sur un reglement en une fois, c'est le prix. Sur un echeancier, ce
  /// montant AVANCE a chaque prelevement reussi : c'est la tresorerie reelle,
  /// pas la promesse. Le prix convenu, lui, est dans `montantTotalCents`.
  montantCents       Int
  /// LE PRIX CONVENU EN ENTIER, quand il est etale.
  ///
  /// Nul sur les ventes d'avant l'echeancier, et sur les reglements en une
  /// fois : `montantCents` dit alors tout. Les deux champs disent deux choses
  /// differentes, et les confondre ferait compter deux fois le meme euro.
  montantTotalCents  Int?
  /// Le nombre d'echeances convenu. 1 = regle en une fois.
  echeances          Int       @default(1)
  /// Combien ont ete reellement encaissees.
  echeancesPayees    Int       @default(1)
  /// L'echeancier chez le prestataire. Unique : deux ventes ne peuvent pas
  /// pointer le meme, et une relivraison de webhook ne cree pas de doublon.
  stripeAbonnementId String?   @unique
  /// UN PRELEVEMENT A ECHOUE. L'acces n'est PAS coupe automatiquement — c'est
  /// l'organisme qui decide, apres avoir relance. Couper l'acces d'un
  /// apprenant sur un incident de carte serait brutal et souvent injuste.
  incidentAt         DateTime?
  incidentMotif      String?
  codePromo          String?
  /// Le code de l'affilié quand la vente vient d'un lien partagé.
  affiliation        String?

  statut          StatutVente @default(PAYEE)
  moyen           String?
  /// La session Stripe qui a payé cette vente. Unique : une relivraison du
  /// webhook retombe dessus et n'inscrit personne deux fois.
  stripeSessionId String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, createdAt])
  @@index([accountId, statut])
}

enum StatutVente {
  EN_ATTENTE
  PAYEE
  REMBOURSEE
  ANNULEE
}

model ClasseVirtuelle {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  coursId   String?
  cours     Cours?  @relation(fields: [coursId], references: [id], onDelete: SetNull)

  titre       String
  description String?
  debut       DateTime
  fin         DateTime?
  /// Le lien de la visio : celui qu'on envoie aux inscrits.
  lien        String?
  placesMax   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, debut])
}

/// LA VITRINE DE L'ÉCOLE : ce que voient les gens avant d'acheter.
model EcoleEnLigne {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  nom          String
  slug         String  @unique
  sousTitre    String?
  presentation String?

  logoUrl     String?
  banniereUrl String?
  faviconUrl  String?

  /// LA COULEUR PRINCIPALE SUFFIT. Les cinq autres se règlent si on veut aller
  /// plus loin ; vides, elles se déduisent de la principale.
  couleur             String  @default("#0F5F3E")
  couleurFond         String?
  couleurTitres       String?
  couleurTextes       String?
  couleurBoutons      String?
  couleurTexteBoutons String?

  /// [{ "reseau": "instagram", "url": "https://..." }]
  liensSociaux Json?

  contactEmail String?
  cgv          String?
  mentions     String?

  /// Le certificat de réussite que l'apprenant édite lui-même à la fin.
  certificatModele  String?
  certificatsActifs Boolean @default(true)

  /// Couper les commentaires d'un coup, sur toutes les formations.
  commentairesActifs Boolean @default(true)

  /// Les codes de suivi posés sur la boutique et l'espace apprenant.
  googleAnalytics String?
  pixelMeta       String?

  publiee Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// UN AFFILIÉ : quelqu'un qui partage un lien et touche une part de la vente.
model Affilie {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  nom   String
  email String
  code  String

  commissionPourcent Int     @default(20)
  ventes             Int     @default(0)
  gainsCents         Int     @default(0)
  /// Ce qui lui a déjà été versé : le reste est ce qu'on lui doit.
  gainsVersesCents   Int     @default(0)
  actif              Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, code])
  @@index([accountId, actif])
}

/**
 * ═══════════════════════════════════════════════════ LA BOUTIQUE ══════
 */

/// LA BOUTIQUE D'UNE ASSOCIATION.
///
/// Une association vend autre chose que des formations : des places, des
/// t-shirts, un livret, un enregistrement. Cette fiche est la vitrine — un
/// nom, une adresse, des couleurs — exactement ce que `EcoleEnLigne` est à
/// l'académie. Les deux sont volontairement séparées : une association peut
/// tenir une boutique sans avoir d'école, et l'inverse.
model Boutique {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  nom          String
  /// L'adresse publique : /boutique/<slug>.
  slug         String  @unique
  sousTitre    String?
  presentation String?

  logoUrl     String?
  banniereUrl String?

  couleur String @default("#0F5F3E")

  contactEmail String?
  cgv          String?
  mentions     String?

  /// Ce qu'on écrit sur la page quand une commande contient un objet à
  /// expédier : délais, points de retrait, ce qui est possible et ce qui ne
  /// l'est pas. Vide, rien ne s'affiche — on n'invente pas de délai.
  livraisonTexte String?

  publiee Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// CE QUI EST VENDU.
///
/// Deux natures, et la différence n'est pas décorative : un objet réel se
/// compte, s'expédie et demande une adresse ; un produit virtuel se remet à
/// l'instant du paiement, sans stock ni port.
model ProduitBoutique {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  titre       String
  /// L'adresse publique : /boutique/<boutique>/<slug>.
  slug        String
  description String?
  imageUrl    String?

  nature NatureProduit @default(REEL)

  /// En centimes : on ne stocke jamais un prix en flottant.
  prixCents      Int  @default(0)
  prixBarreCents Int?
  /// La TVA appliquée au prix, en pour cent. 0 pour un organisme exonéré.
  tvaPourcent    Int  @default(0)

  /// PRODUIT RÉEL — ce qui reste. Vide : on ne compte pas.
  stock          Int?
  /// PRODUIT RÉEL — les frais d'expédition, en centimes. 0 : remise en main
  /// propre, ou port offert.
  livraisonCents Int  @default(0)

  /// PRODUIT VIRTUEL — le fichier remis après le paiement (médiathèque), ou
  /// l'adresse d'un contenu hébergé ailleurs. L'un ou l'autre suffit.
  fichierUrl String?
  lienUrl    String?

  statut StatutProduit @default(BROUILLON)
  ordre  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lignes LigneCommande[]

  @@unique([accountId, slug])
  @@index([accountId, statut])
  @@index([accountId, ordre])
}

enum NatureProduit {
  /// Un objet : il se compte, il s'expédie ou se remet en main propre.
  REEL
  /// Un fichier ou un accès : il se remet au moment du paiement.
  VIRTUEL
}

enum StatutProduit {
  BROUILLON
  PUBLIE
  ARCHIVE
}

/// UNE COMMANDE.
///
/// Rien n'est créé au moment du clic : la commande naît quand le paiement est
/// confirmé, comme pour l'achat d'une formation. `stripeSessionId` est unique,
/// si bien qu'une notification relivrée retombe sur la commande existante et
/// n'en crée pas une deuxième.
model CommandeBoutique {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  email     String
  nom       String?
  telephone String?

  /// L'adresse d'expédition, renseignée seulement si la commande contient un
  /// objet réel.
  adresse    String?
  codePostal String?
  ville      String?
  pays       String?

  totalCents     Int @default(0)
  fraisPortCents Int @default(0)

  statut StatutCommande @default(PAYEE)

  stripeSessionId String? @unique
  /// Ce que l'association note pour elle-même : un numéro de suivi, un
  /// rendez-vous de remise.
  note            String?

  lignes LigneCommande[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, statut])
  @@index([accountId, createdAt])
}

enum StatutCommande {
  PAYEE
  PREPAREE
  EXPEDIEE
  REMISE
  ANNULEE
  REMBOURSEE
}

/// UNE LIGNE DE COMMANDE.
///
/// Le titre et le prix sont recopiés, pas seulement référencés : le jour où le
/// produit change de prix ou disparaît, la commande passée doit rester lisible
/// telle qu'elle a été payée.
model LigneCommande {
  id         String           @id @default(cuid())
  commandeId String
  commande   CommandeBoutique @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  produitId String?
  produit   ProduitBoutique? @relation(fields: [produitId], references: [id], onDelete: SetNull)

  titre     String
  nature    NatureProduit @default(REEL)
  prixCents Int
  quantite  Int           @default(1)
  /// Ce qui a été remis pour un produit virtuel, figé au moment de la vente.
  remisUrl  String?

  @@index([commandeId])
}

/// ═══════════════════════════════════════════════════════════════════════
/// RESERVATION D'ATELIER PAYEE EN LIGNE.
///
/// Volontairement A COTE de `Booking`, pas dedans. Un `Booking` part d'un
/// compte etabli sur la plateforme et se termine en devis puis en facture ;
/// c'est le chemin historique, il marche, et il continue d'exister sans une
/// ligne de changement. Ici, la personne peut n'avoir aucun compte : elle
/// arrive sur la fiche, choisit une date, paie, et c'est tout. Melanger les
/// deux aurait oblige a rendre `Booking.accountId` facultatif, c'est-a-dire a
/// fragiliser le tunnel qui fait vivre la place de marche pour ajouter un
/// chemin neuf. On prefere deux objets clairs a un objet ambigu.
///
/// L'ARGENT NE PASSE PAS PAR LA PLATEFORME. Le paiement est encaisse
/// directement sur le compte Stripe de l'intervenant : c'est lui le vendeur,
/// c'est lui qui delivre la prestation, c'est lui qui rembourse, et c'est lui
/// qui porte une contestation de carte. La plateforme ne retient que sa part,
/// nulle par defaut.
model ReservationAtelier {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Le compte de l'intervenant : celui qui encaisse et qui rendra le service.
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// L'ACHETEUR. Il n'a pas de compte, et on ne lui en impose pas : exiger une
  /// inscription avant de payer, c'est perdre la vente.
  email        String
  nom          String?
  telephone    String?
  organisation String?
  message      String?

  /// Ce qui a ete demande. La date reste un SOUHAIT tant que l'intervenant ne
  /// l'a pas confirmee : la fiche n'a pas d'agenda, et laisser croire a un
  /// creneau reserve serait un mensonge.
  dateSouhaitee DateTime?
  creneau       String?
  participants  Int?

  /// Ce qui a ete paye, en centimes, au moment ou ca l'a ete. Fige : le prix
  /// de la fiche peut changer demain, pas ce qui a ete encaisse hier.
  montantCents        Int
  /// La part retenue par la plateforme sur ce paiement, en centimes.
  partPlateformeCents Int     @default(0)
  /// Le texte des conditions d'annulation TEL QU'AFFICHE au moment de payer.
  /// Recopie ici a dessein : l'intervenant peut le reecrire plus tard, mais
  /// l'acheteur n'a accepte que celui-la.
  annulationTexte     String?

  statut StatutReservationAtelier @default(PAYEE)

  /// La session de paiement, sur le compte de l'intervenant. Unique : c'est la
  /// cle qui empeche d'enregistrer deux fois la meme reservation quand la page
  /// de retour est rechargee.
  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  payeeAt               DateTime?
  rembourseeAt          DateTime?
  montantRembourseCents Int?
  /// Note de l'intervenant sur cette reservation. Jamais montree a l'acheteur.
  noteInterne           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, statut])
  @@index([serviceId])
  @@index([email])
}

enum StatutReservationAtelier {
  PAYEE
  CONFIRMEE
  REALISEE
  ANNULEE
  REMBOURSEE
}

/// UN RENDEZ-VOUS POSE A LA MAIN DANS L'AGENDA.
///
/// L'agenda de Pilote montre surtout des dates QU'ON N'Y SAISIT PAS : une
/// session de formation, la cloture d'un formulaire, l'echeance d'un dossier
/// de subvention. Ces dates vivent dans leurs propres tables et l'agenda va
/// les y lire — les recopier ici les ferait diverger a la premiere
/// modification.
///
/// Reste ce que l'agenda est seul a connaitre : le rendez-vous avec la mairie,
/// la reunion d'equipe, la relance a ne pas oublier. C'est cette table.
///
/// Elle est portee par le COMPTE et non par la personne : toute l'equipe voit
/// le meme agenda, c'est la demande. `creePar` dit seulement qui l'a inscrit.
model RendezVous {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  titre       String
  description String? @db.Text
  lieu        String?
  /// Le lien de visio, quand la rencontre se tient a distance.
  lien        String?

  debut          DateTime
  fin            DateTime?
  /// Une journee entiere : on n'affiche alors aucune heure.
  journeeEntiere Boolean   @default(false)

  categorie CategorieRendezVous @default(RENDEZ_VOUS)

  /// Les personnes attendues, par leur nom. Un agenda d'equipe n'a pas besoin
  /// de comptes utilisateurs pour noter que le tresorier est convie.
  participants String[] @default([])

  /// Un rappel par courriel, ce nombre de minutes avant le debut.
  rappelMinutes Int?
  rappelEnvoye  Boolean @default(false)

  creeParId String?
  creePar   User?   @relation("RendezVousAuteur", fields: [creeParId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, debut])
}

enum CategorieRendezVous {
  RENDEZ_VOUS
  REUNION
  APPEL
  VISITE
  ECHEANCE
  AUTRE
}

/// LA VISIOCONSULTATION — un rendez-vous à distance, et rien d'autre.
///
/// ⚠⚠ CE N'EST PAS DU SOIN, ET LE MODÈLE NE DOIT JAMAIS LE DEVENIR. Ce sont
/// des séances de rééducation et d'éducation spécialisée : guidance, suivi,
/// point avec une équipe ou une enseignante. Aucun champ de ce modèle ne
/// porte, ne doit porter et ne portera de donnée de santé — pas de motif
/// médical, pas de diagnostic, pas de compte rendu clinique. Ce qui se dit
/// pendant la séance reste entre les participants : rien n'est enregistré,
/// ni le flux, ni sa transcription.
///
/// LE MODÈLE TECHNIQUE EST CELUI DE DOCTOLIB, dans ses principes :
///  - une SALLE par rendez-vous, jamais un lien permanent ;
///  - un JETON PAR PARTICIPANT, donc deux liens différents, chacun ne servant
///    qu'à celui à qui on l'a envoyé ;
///  - une FENÊTRE d'ouverture bornée autour de l'heure prévue — un lien qui
///    marche pour toujours finit par circuler ;
///  - le média ne passe JAMAIS par l'API : elle ne signe qu'un jeton d'accès,
///    le flux va du navigateur au serveur média (WebRTC, relais TURN sur 443
///    pour traverser les réseaux d'établissement).
model Visioconsultation {
  id String @id @default(cuid())

  /// La prestation à laquelle ce rendez-vous se rattache. Une visio n'existe
  /// jamais toute seule : elle est un créneau d'une intervention déjà acceptée.
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Le nom de salle côté serveur média. Aléatoire, jamais dérivé d'un nom de
  /// personne ni d'un identifiant devinable.
  salle String @unique

  debutPrevu   DateTime
  dureeMinutes Int      @default(45)

  /// Les deux liens. Distincts, parce qu'ils n'ouvrent pas les mêmes droits :
  /// l'intervenant ouvre la salle, le demandeur y entre.
  jetonIntervenant String @unique
  jetonDemandeur   String @unique

  statut StatutVisio @default(PLANIFIEE)

  /// Première entrée de l'intervenant dans la salle, et fin effective.
  ouverteLe  DateTime?
  termineeLe DateTime?

  /// Motif d'annulation, écrit par qui annule. Pas de motif médical ici.
  annulationMotif String?

  /// Le nom affiché au demandeur, recopié à la planification : il n'a pas de
  /// compte, et on ne va pas lire le profil de l'intervenant depuis une route
  /// publique pour afficher un prénom.
  intervenantAffiche String?
  demandeurAffiche   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([debutPrevu])
  @@index([statut, debutPrevu])
}

enum StatutVisio {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

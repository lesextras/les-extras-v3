// ============================================================================
// LES EXTRAS v3 — Schéma Prisma
// Marketplace médico-social : FREELANCE × ESTABLISHMENT
// Multi-comptes (Account) + sous-comptes (Membership) + invitations
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITÉ & MULTI-COMPTES
// ---------------------------------------------------------------------------

/// Une personne physique (identité de connexion).
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  phone         String?
  avatarUrl     String?
  /// Photo de profil déposée (prioritaire sur avatarUrl quand elle existe).
  avatarFileId  String?
  avatarFile    FileAsset? @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  /// Rôle global plateforme (pas le rôle DANS un compte).
  role          GlobalRole @default(USER)
  status        UserStatus @default(PENDING)
  emailVerified Boolean    @default(false)
  onboardingStep Int       @default(0)
  /// Connexion LinkedIn (partage d'articles). Jeton conservé côté serveur
  /// uniquement, jamais exposé au navigateur.
  linkedinUrn         String?
  linkedinAccessToken String?
  linkedinExpiresAt   DateTime?
  linkedinName        String?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile         Profile?
  memberships     Membership[]
  sentInvitations Invitation[]   @relation("InvitationInviter")
  ownedAccounts   Account[]      @relation("AccountOwner")
  documents       Document[]
  uploadedFiles   FileAsset[]        @relation("FileUploader")
  notifications   Notification[]
  messages        Message[]
  reviewsAuthored Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewTarget")
  availabilities  Availability[]
  shiftsAssigned  Shift[]        @relation("ShiftFreelance")
  authoredArticles Article[]     @relation("ArticleAuthor")
  sessionsTrained  FormationSession[] @relation("SessionTrainer")
  inscriptions     Inscription[]      @relation("InscriptionLearner")
  tutoratsGiven    Tutorat[]          @relation("TutoratTutor")
  complianceDocuments ComplianceDocument[]
  qualifications   Qualification[]
  experiences      Experience[]
  auditLogs        AuditLog[]         @relation("AuditActor")
  /// Rendez-vous hebdomadaire du lundi. Activé par défaut, désactivable en un
  /// clic : un e-mail non désiré coûte plus cher qu'un e-mail non envoyé.
  hebdoOptIn       Boolean            @default(true)
  questionsAsked   Question[]         @relation("QuestionAuthor")
  answersWritten   Answer[]           @relation("AnswerAuthor")
  answerVotes      AnswerVote[]       @relation("AnswerVoter")

  @@index([email])
  @@index([role, status])
  favorites          Favorite[]
  assistantDocuments AssistantDocument[]
  tramesMaison      TrameMaison[]
  pushSubscriptions PushSubscription[]
  leaveRequests    LeaveRequest[] @relation("LeaveUser")
  contratsCDD    ContratCDD[] @relation("ContratSalarie")
  /// Ajouts au vivier effectues par cette personne.
  ajoutsAuVivier PoolMember[] @relation("PoolAjoutePar")
  /// Signatures electroniques apposees par cette personne.
  signatures     Signature[]  @relation("SignatureSignataire")
  /// Demandes de rattachement à un établissement envoyées par cette personne
  /// (compte « salarié » créé en solo, en attente de confirmation).
  attachmentRequestsSent    AttachmentRequest[] @relation("AttachmentRequester")
  /// Demandes de rattachement tranchées (acceptées/refusées) par cette personne.
  attachmentRequestsDecided AttachmentRequest[] @relation("AttachmentDecider")
}

/// Données étendues d'un utilisateur (surtout côté FREELANCE).
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  job         String?   // Éducateur spécialisé, Moniteur-éducateur, EJE, AES...
  skills      String[]  @default([])
  siret       String?
  diplomaUrl  String?
  city        String?
  postalCode  String?
  radiusKm    Int?      @default(30)
  hourlyRate  Decimal?  @db.Decimal(8, 2)
  available   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Un COMPTE (tenant). Soit une organisation ESTABLISHMENT (ex: une MECS),
/// soit le compte individuel d'un FREELANCE. Peut avoir plusieurs membres.
model Account {
  id          String       @id @default(cuid())
  name        String
  type        AccountType
  /// Validation hierarchique : si active, une mission publiee par un MANAGER
  /// attend l'approbation d'un OWNER/ADMIN avant diffusion.
  validationMissions Boolean @default(false)
  /// Parrainage : compte intervenant qui a invite celui-ci (fige a l'inscription).
  parrainAccountId String?
  slug        String       @unique
  /// Attribution — d'où vient ce compte. Renseigné une fois, à l'inscription,
  /// et jamais modifié ensuite : c'est la campagne qui a amené la personne.
  /// utm_source, sinon domaine référent, sinon « direct ».
  source      String?
  /// utm_medium : cpc, social, email, referral...
  sourceMedium String?
  /// utm_campaign : nom de l'annonce, pour comparer deux créations.
  sourceCampaign String?
  /// Page d'arrivée : sait-on vers quoi l'annonce pointait.
  sourceLanding  String?
  // Coordonnées structure
  legalName   String?
  siret       String?
  address     String?
  city        String?
  postalCode  String?
  phone       String?
  /// Mention de TVA à afficher sur les factures émises par ce compte (ex.
  /// « TVA non applicable, art. 293 B du CGI » ou « TVA 20 % — n° FR... »).
  /// Laissé vide, la mention par défaut (non assujetti) reste affichée : elle
  /// est vraie pour la grande majorité des comptes (auto-entrepreneurs en
  /// franchise en base, association ADéPA), mais un émetteur assujetti à la
  /// TVA doit pouvoir la corriger lui-même plutôt que de laisser un taux faux.
  vatMention  String?
  /// Adresse de contact publique du compte. Pour un compte intervenant créé
  /// depuis un poste salarié, c'est OBLIGATOIREMENT un contact personnel : les
  /// sollicitations d'activité indépendante ne doivent jamais arriver sur la
  /// messagerie de l'employeur.
  contactEmail String?
  logoUrl     String?
  // Crédits LEX : un crédit = une génération (voir CreditsService).
  credits     Int          @default(0)
  /// Accès LEX illimité accordé à la main (exonération de crédits).
  isMember    Boolean      @default(false)
  /// Essai Découverte : recharge quotidienne gratuite jusqu'à cette date.
  /// Non nul = l'essai a été utilisé (il ne se réclame qu'une fois).
  lexTrialEndsAt DateTime?
  /// Taux de commission ADéPA appliqué aux prestations externes de ce compte
  /// (null = taux par défaut de la plateforme). Modèle prestataire : ADéPA
  /// facture l'établissement, l'intervenant facture ADéPA.
  commissionRate  Decimal?  @db.Decimal(5, 4)
  /// Solde de points de fidélité (10 points = 1 € de réduction).
  points      Int          @default(0)
  ownerId     String
  owner       User         @relation("AccountOwner", fields: [ownerId], references: [id])
  articles          Article[]        @relation("AccountArticles")
  loyaltyPoints     LoyaltyPoint[]
  ideas             Idea[]
  questions         Question[]       @relation("AccountQuestions")
  answers           Answer[]         @relation("AccountAnswers")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships     Membership[]
  invitations     Invitation[]
  reliefMissions  ReliefMission[]  @relation("MissionAccount")
  leaveRequests   LeaveRequest[]
  services        Service[]        @relation("ServiceAccount")
  bookings        Booking[]
  invoices        Invoice[]
  /// Les factures adressees a ce compte (formation, prestation) sans qu'il en
  /// soit l'emetteur.
  facturesAPayer  Invoice[]        @relation("InvoicePayer")
  creditLedger    CreditLedger[]
  shifts          Shift[]
  formationsOwned  Formation[]        @relation("FormationOwner")
  sessionsHosted   FormationSession[] @relation("SessionHost")
  inscriptionsPaid Inscription[]      @relation("InscriptionPayer")
  qualiopiProofs   QualiopiProof[]    @relation("QualiopiOf")
  complianceDocuments ComplianceDocument[]
  orgUnits         OrgUnit[]
  auditLogs        AuditLog[]         @relation("AuditAccount")
  /// Le vivier de cet etablissement : les intervenants qu'il veut revoir.
  vivier           PoolMember[]       @relation("PoolEtablissement")
  /// Les etablissements qui ont place cet intervenant dans leur vivier.
  vivierDe         PoolMember[]       @relation("PoolIntervenant")
  /// Les regles de temps de travail lues dans SA convention collective.
  parametresTemps  ParametresTemps?
  /// Demandes de signature electronique emises par ce compte.
  signatures       Signature[]        @relation("SignatureCompte")
  /// Les missions que ce compte intervenant s'est engage a prendre.
  engagements      MissionEngagement[] @relation("EngagementIntervenant")
  /// Les modeles d'ecrits appris dans ce compte.
  tramesMaison     TrameMaison[]

  @@index([type])
  @@index([slug])
  @@index([source])
  uploadedFiles FileAsset[]  @relation("FileAccount")
  creditPurchases CreditPurchase[]
  subscription    Subscription?
  quotesAsClient   Quote[] @relation("QuoteClient")
  quotesAsProvider Quote[] @relation("QuoteProvider")
  assistantDocuments AssistantDocument[]
  contratsCDD    ContratCDD[]
  /// Demandes envoyées par CE compte pour se rattacher à un établissement
  /// (compte individuel « salarié » créé en solo, côté freelance en attendant).
  attachmentRequestsAsRequester AttachmentRequest[] @relation("AttachmentRequesterAccount")
  /// Demandes de rattachement reçues par CET établissement (à approuver/refuser).
  attachmentRequestsReceived    AttachmentRequest[] @relation("AttachmentTarget")
}

/// Unité / service d'un établissement (repris de Symfony : Service/unités).
/// Ex. « Internat », « Pôle jour », « SESSAD ». Rattache membres et missions.
model OrgUnit {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  memberships Membership[]
  missions    ReliefMission[]
  shifts      Shift[]
  invitations Invitation[]

  @@index([accountId])
}

/// SOUS-COMPTE : rattachement d'un User à un Account avec un rôle interne.
model Membership {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role       AccountRole   @default(MEMBER)
  status     MembershipStatus @default(ACTIVE)
  orgUnitId  String?
  orgUnit    OrgUnit?      @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, accountId])
  @@index([accountId, role])
}

/// INVITATION à rejoindre un compte (par email), avec rôle cible + token.
model Invitation {
  id         String           @id @default(cuid())
  email      String
  accountId  String
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role       AccountRole      @default(MEMBER)
  /// SERVICE d'affectation, choisi au moment de l'invitation.
  /// Sans lui, un nouvel arrivant n'apparaissait dans le planning d'aucun chef
  /// de service tant qu'un responsable ne pensait pas à le rattacher à la main
  /// — ce que personne ne fait, parce que rien ne le rappelle.
  orgUnitId  String?
  orgUnit    OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  token      String           @unique @default(cuid())
  status     InvitationStatus @default(PENDING)
  invitedById String
  invitedBy  User             @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())

  @@unique([email, accountId])
  @@index([token])
  @@index([status])
}

/// DEMANDE DE RATTACHEMENT : le sens inverse de Invitation. Une personne
/// s'inscrit seule en tant que « salarié » (compte requesterAccount de type
/// FREELANCE, mêmes droits qu'un intervenant tant que rien n'est confirmé),
/// puis demande à rejoindre un établissement qu'elle choisit elle-même.
/// L'établissement voit la demande côté Équipe et l'accepte ou la refuse.
/// À l'acceptation : création d'un Membership (rôle MEMBER) sur le compte
/// établissement — la personne garde aussi son compte individuel, comme pour
/// n'importe quel multi-compte de la plateforme.
model AttachmentRequest {
  id     String @id @default(cuid())

  requesterUserId String
  requesterUser   User   @relation("AttachmentRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  /// Le compte FREELANCE personnel de la personne qui demande — pas un
  /// compte établissement : on ne rattache pas un établissement à un autre.
  requesterAccountId String
  requesterAccount   Account @relation("AttachmentRequesterAccount", fields: [requesterAccountId], references: [id], onDelete: Cascade)

  establishmentAccountId String
  establishmentAccount   Account @relation("AttachmentTarget", fields: [establishmentAccountId], references: [id], onDelete: Cascade)

  /// Mot court, facultatif, affiché à l'établissement (« Je suis moniteur-éducateur à l'internat depuis 2022 »).
  message String?

  status AttachmentRequestStatus @default(PENDING)

  decidedById String?
  decidedBy   User?     @relation("AttachmentDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une demande en attente à la fois vers un même établissement : renvoyer un
  // doublon écrase la précédente plutôt que d'empiler des lignes identiques.
  @@unique([requesterAccountId, establishmentAccountId])
  @@index([establishmentAccountId, status])
  @@index([requesterUserId])
}

enum AttachmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// MARKETPLACE — SOS RENFORT (missions) & ATELIERS (services)
// ---------------------------------------------------------------------------

/// Mission de renfort/remplacement publiée par un ESTABLISHMENT.
model ReliefMission {
  id           String        @id @default(cuid())
  accountId    String
  account      Account       @relation("MissionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  title        String
  description  String
  category     MissionCategory @default(RENFORT)
  categoryId   String?
  categoryRef  Category?      @relation("MissionCategoryRef", fields: [categoryId], references: [id], onDelete: SetNull)
  job          String?        // métier recherché
  startDate    DateTime
  endDate      DateTime?
  startTime    String?        // "09h00"
  endTime      String?        // "17h00"
  city         String?
  postalCode   String?
  /// Coordonnees geocodees depuis le code postal (geo.api.gouv.fr) —
  /// permettent le filtre « a moins de X km » sur la marketplace.
  latitude     Float?
  longitude    Float?
  hourlyRate   Decimal?       @db.Decimal(8, 2)
  headcount    Int            @default(1)
  emergency    Boolean        @default(false)  // mission urgente (renfort de dernière minute)
  attachmentUrl String?                        // ancien mode : adresse web saisie à la main
  attachmentId  String?                        // nouveau mode : fichier déposé
  attachment    FileAsset? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  orgUnitId    String?                          // unité/service concerné
  orgUnit      OrgUnit?       @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  status       MissionStatus  @default(DRAFT)
  /// Validation hierarchique : publication demandee par un MANAGER, en
  /// attente d'approbation par un OWNER/ADMIN du compte.
  attenteValidation Boolean   @default(false)
  /// Mission recurrente : 'HEBDO' -> le planificateur cree et publie
  /// automatiquement l'occurrence de la semaine suivante.
  recurrence   String?
  /// Diffusion en cascade : SALARIES -> RESERVED -> PUBLIC
  visibility   MissionVisibility @default(PUBLIC)
  /// Mode d'attribution choisi par l'établissement à la publication.
  modeAttribution ModeAttribution @default(AUTOMATIQUE)
  /// Destinataires de l'offre. RESEAU = cascade normale ; toute autre valeur
  /// verrouille la diffusion (pas d'élargissement, pas de marketplace).
  cibleDiffusion  CibleDiffusion  @default(RESEAU)
  /// Cible SELECTION : identifiants des SALARIÉS (User.id) désignés.
  destinatairesSalaries String[] @default([])
  /// Cible SELECTION : identifiants des COMPTES intervenants désignés.
  destinatairesIntervenants String[] @default([])
  publishedAt  DateTime?
  /// Diffusion ciblée en vagues (voir MissionsService.broadcastToMatched).
  /// 0 = pas encore diffusée · 1 = les profils les plus proches · 2 = élargie
  /// · 3 = tout le réseau. On sollicite peu de monde à la fois, à dessein :
  /// un envoi de masse dilue la responsabilité et personne ne répond.
  diffusionVague    Int       @default(0)
  /// Horodatage de la dernière vague, pour savoir quand déclencher la suivante.
  derniereVagueAt   DateTime?
  /// « Mission garantie » : date à laquelle l'alerte de relance manuelle a été
  /// envoyée (non nul = déjà alerté, l'alerte ne part qu'une fois).
  alerteNonPourvueAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  bookings     Booking[]
  engagements  MissionEngagement[]
  reviews      Review[]      @relation("MissionReviews")
  conversations Conversation[]
  shifts       Shift[]
  quotes       Quote[]

  @@index([status, visibility])
  @@index([accountId])
  @@index([startDate])
  contratsCDD    ContratCDD[]
}

/// Atelier / service proposé par un FREELANCE.
model Service {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation("ServiceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    ServiceCategory @default(ATELIER)
  categoryId  String?
  categoryRef Category?     @relation("ServiceCategoryRef", fields: [categoryId], references: [id], onDelete: SetNull)
  duration    String?        // "2H" — libellé libre historique
  /// Durée normalisée en minutes (480 = 8 h) — sert au tri et aux filtres.
  durationMinutes Int?
  maxParticipants Int?
  publicTarget String?       // "Adultes en situation de handicap"
  /// Publics visés, en liste (Adolescent, Enfant, Handicap, Sénior…).
  publicTargets String[]     @default([])
  /// Matériel nécessaire et prérequis, tels qu'annoncés à l'établissement.
  material     String?
  prerequisites String?
  /// Contenu pédagogique structuré (modèle des fiches les-extras.fr).
  objectives   String?
  methodology  String?
  evaluation   String?
  /// Questions fréquentes : [{ question, answer }].
  faq          Json?
  /// Galerie : URLs (fichier déposé /api/files/... ou image externe).
  images       String[]      @default([])
  /// Options facturables en supplément : [{ label, price }].
  priceExtras  Json?
  /// Mise en avant sur la marketplace et validation par l'équipe.
  featured    Boolean        @default(false)
  verified    Boolean        @default(false)
  /// Compteur de consultations de la fiche.
  views       Int            @default(0)
  /// Identifiant d'origine (import du catalogue historique) : clé d'idempotence.
  /// Index simple et non unique : une contrainte UNIQUE bloquerait `prisma db push`
  /// au démarrage du conteneur (avertissement de perte de données). L'unicité est
  /// garantie applicativement par le `findFirst` de AdminService.importCatalog().
  sourceId    String?
  /// Repères affichés sur la fiche (modèle les-extras.fr).
  /// Nombre de demandes reçues : sert la preuve sociale « X demandes / semaine ».
  requestsCount Int          @default(0)
  /// Créneaux horaires proposés à la réservation : ["9h-12h", "14h-17h"].
  timeSlots     String[]     @default([])
  /// Formation couverte par la certification Qualiopi d'ADéPA (finançable OPCO).
  qualiopi      Boolean      @default(false)
  price       Decimal?       @db.Decimal(10, 2)
  /// Coût en crédits d'une réservation de cet atelier par un établissement.
  creditCost  Int            @default(1)
  city        String?
  status      ServiceStatus  @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  bookings    Booking[]
  quotes      Quote[]
  reviews     Review[]       @relation("ServiceReviews")

  @@index([status])
  @@index([accountId])
  @@index([sourceId])
  favorites     Favorite[]
}

/// Réservation : relie un FREELANCE à une mission OU un service.
/// Devis : chiffrage d'une prestation (atelier, formation, renfort) demandé
/// par un établissement à un intervenant. Accepté -> réservation + contrat.
model Quote {
  id                String      @id @default(cuid())
  reference         String      @unique
  /// Établissement demandeur.
  clientAccountId   String
  clientAccount     Account     @relation("QuoteClient", fields: [clientAccountId], references: [id], onDelete: Cascade)
  /// Intervenant qui chiffre.
  providerAccountId String
  providerAccount   Account     @relation("QuoteProvider", fields: [providerAccountId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  missionId         String?
  mission           ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  title             String
  /// Besoin exprimé par l'établissement.
  request           String?
  /// Message / conditions de l'intervenant.
  message           String?
  /// Lignes du devis : [{ label, quantity, unitPrice }] (JSON pour rester souple).
  lines             Json?
  amount            Decimal?    @db.Decimal(10, 2)
  status            QuoteStatus @default(REQUESTED)
  /// Date d'intervention souhaitée / retenue.
  scheduledAt       DateTime?
  validUntil        DateTime?
  sentAt            DateTime?
  decidedAt         DateTime?
  refusalReason     String?
  /// Réservation créée à l'acceptation (contrat + facturation en aval).
  bookingId         String?     @unique
  booking           Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([clientAccountId])
  @@index([providerAccountId])
  @@index([status])
}

enum QuoteStatus {
  REQUESTED
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
}

model Booking {
  id            String        @id @default(cuid())
  // Le compte à l'origine de la réservation (établissement ou freelance selon flux)
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  missionId     String?
  mission       ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  status        BookingStatus @default(REQUESTED)
  scheduledAt   DateTime?
  /// Nombre de participants annonce a la demande. L'intervenant en a besoin
  /// pour dire oui ou non : un atelier prevu pour huit ne se tient pas a vingt.
  participants  Int?
  /// Precisions ecrites par le demandeur : public accueilli, objectifs,
  /// contraintes. Sans ce champ, le formulaire les jetait a la poubelle.
  requestNote   String?
  /// Date de fin effective : ouvre la fenetre d'ajustement de 72 h du pointage.
  completedAt   DateTime?
  totalAmount   Decimal?      @db.Decimal(10, 2)
  cancelReason  String?
  // Signature du contrat de mission (double signature établissement + freelance).
  signedFreelanceAt      DateTime?
  signedEstablishmentAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reviews       Review[]
  invoice       Invoice?
  quote         Quote?
  shift         Shift?
  timeEntries   TimeEntry[]
  engagement    MissionEngagement?

  @@index([status])
  @@index([missionId])
  @@index([serviceId])
}

/// Pointage : temps travaillé déclaré par le freelance sur une mission (Booking),
/// validé par l'établissement. Repris de Symfony (entité Period). Base de la facturation.
model TimeEntry {
  id        String          @id @default(cuid())
  bookingId String
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  note      String?
  status    TimeEntryStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([bookingId])
  @@index([status])
}

enum TimeEntryStatus {
  PENDING
  VALIDATED
  REJECTED
}

// ---------------------------------------------------------------------------
// MESSAGERIE / AVIS / NOTIFS / FACTURES / DOCUMENTS
// ---------------------------------------------------------------------------

model Conversation {
  id         String    @id @default(cuid())
  missionId  String?
  mission    ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]

  @@index([missionId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

/// AVIS déposé après une réservation. Chaque partie (établissement ET
/// intervenant) peut déposer le sien : la contrainte d'unicité porte donc sur
/// le couple (réservation, auteur) et non sur la seule réservation.
model Review {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId   String
  target     User     @relation("ReviewTarget", fields: [targetId], references: [id])
  /// Prestation notée, déduite de la réservation à la création de l'avis.
  /// Sur une marketplace, la note portée par l'offre pèse plus dans la décision
  /// d'achat que celle du vendeur : deux ateliers d'un même intervenant ne
  /// doivent pas partager la même note.
  serviceId  String?
  service    Service? @relation("ServiceReviews", fields: [serviceId], references: [id], onDelete: SetNull)
  missionId  String?
  mission    ReliefMission? @relation("MissionReviews", fields: [missionId], references: [id], onDelete: SetNull)
  rating     Int      // 1..5
  comment    String?
  createdAt  DateTime @default(now())

  @@index([targetId])
  @@index([bookingId])
  @@index([serviceId])
  @@index([missionId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, readAt])
}

model Invoice {
  id         String        @id @default(cuid())
  /// L'ÉMETTEUR : le compte qui facture. C'est lui qui apparaît en tête du
  /// document, lui seul peut émettre ou annuler, et c'est son identification
  /// (raison sociale, SIRET) qui engage juridiquement la facture.
  accountId  String
  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// LE PAYEUR, quand il n'est pas déductible de la réservation — cas des
  /// inscriptions en formation, où l'association facture un établissement sans
  /// qu'aucun Booking ne les relie. Sans ce champ, l'établissement ne voyait
  /// jamais la facture qui lui était pourtant adressée, et le bouton « Payer
  /// en ligne » lui restait inatteignable.
  payerAccountId String?
  payer      Account?      @relation("InvoicePayer", fields: [payerAccountId], references: [id], onDelete: SetNull)
  bookingId  String?       @unique
  booking    Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  /// Numéro de séquence, unique PAR ÉMETTEUR (pas globalement) : l'article 242
  /// nonies A de l'annexe II au CGI impose une séquence chronologique continue
  /// et sans rupture PROPRE À CHAQUE ÉMETTEUR. Une séquence globale partagée
  /// entre tous les comptes de la plateforme (ancien comportement) mélangeait
  /// les numéros de personnes morales distinctes — non conforme.
  number     String
  amount     Decimal       @db.Decimal(10, 2)
  status     InvoiceStatus @default(DRAFT)
  pdfUrl     String?
  issuedAt   DateTime?
  createdAt  DateTime      @default(now())

  inscription Inscription? @relation("InscriptionInvoice")

  @@unique([accountId, number])
  @@index([accountId])
  @@index([payerAccountId])
}

/// GRAND LIVRE DES CRÉDITS : trace chaque variation de solde d'un compte
/// (top-up admin, débit à la réservation d'un atelier). Immuable, append-only.
model Subscription {
  id                   String   @id @default(cuid())
  accountId            String   @unique
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  status               String   @default("pending") // pending | active | past_due | canceled
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// RÉACTIVÉ pour LEX — les crédits ne sont plus une monnaie interne de
/// réservation (ce modèle-là a été abandonné : la mise en relation est
/// gratuite), mais la monnaie de l'assistant IA : un crédit = une
/// génération. Chaque achat de pack passe ici, PENDING à la création de la
/// session Stripe, PAID au webhook — `stripeSessionId @unique` garantit
/// qu'une relivraison ne crédite pas deux fois.
model CreditPurchase {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId          String
  packId          String
  credits         Int
  amountCents     Int
  currency        String   @default("eur")
  stripeSessionId String   @unique
  status          CreditPurchaseStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
}

enum CreditPurchaseStatus {
  PENDING
  PAID
  CANCELED
}

model CreditLedger {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  reason       String
  bookingId    String?
  invoiceId    String?
  createdAt    DateTime @default(now())

  @@index([accountId])
}

/// OBSOLÈTE — le dépôt de fichiers passe désormais par FileAsset et
/// ComplianceDocument. Ce modèle n'est plus qu'effacé lors d'une suppression
/// de compte (RGPD). La table est CONSERVÉE tant que d'anciens comptes
/// peuvent encore y avoir des pièces : la vider serait effacer des documents
/// que des utilisateurs croient déposés.
model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String   // avatar, diploma, siret, contract...
  /// Ancien mode : adresse web. Vide quand le fichier est déposé (fileId).
  url        String
  fileId     String?
  file       FileAsset? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([userId, kind])
}

/// CATÉGORIE éditable (taxonomie ateliers / missions / articles). Calque du back-office Symfony.
model Category {
  id          String     @id @default(cuid())
  title       String
  slug        String?    @unique
  description String?
  type        String?    // mission, service, article, educatheure...
  parentId    String?
  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryParent")
  archived    Boolean    @default(false)
  articles    Article[]
  missionsRef ReliefMission[] @relation("MissionCategoryRef")
  servicesRef Service[]       @relation("ServiceCategoryRef")
  formationsRef Formation[]   @relation("FormationCategoryRef")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type])
}

/// ARTICLE de contenu (blog / actualités). Calque du back-office Symfony.
/// Deux rayons dans l'Édublog : l'actualité (une nouvelle, un retour de
/// terrain, un temps fort) et l'article de fond (une analyse, un guide).
/// Chaque compte écrit dans l'un ou l'autre.
enum ArticleKind {
  ACTUALITE
  ARTICLE
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  kind        ArticleKind   @default(ACTUALITE)
  excerpt     String?
  content     String?
  coverUrl    String?
  status      ArticleStatus @default(DRAFT)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId    String?
  author      User?         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Compte qui publie (établissement ou intervenant). Null = article éditorial
  /// publié par l'équipe Les Extras depuis le back-office.
  accountId   String?
  account     Account?      @relation("AccountArticles", fields: [accountId], references: [id], onDelete: Cascade)
  /// Consultations de l'article (preuve d'audience pour l'auteur).
  views       Int           @default(0)
  /// Partage LinkedIn : identifiant de la publication et date d'envoi.
  linkedinUrn      String?
  linkedinSharedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([status, kind, publishedAt])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// JOURNAL D'AUDIT (traçabilité)
// ---------------------------------------------------------------------------

/// JOURNAL D'AUDIT : trace append-only des actions sensibles de la plateforme
/// (validation d'heures pointées, modification d'un document de conformité,
/// modération, changement de statut…). Dans le médico-social, savoir QUI a fait
/// QUOI et QUAND a une vraie valeur probante en cas de litige.
/// Aucune entrée n'est jamais modifiée ni supprimée par le métier.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// Auteur de l'action. Nullable : action système / automatique, ou auteur supprimé.
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Compte (tenant) concerné par l'action. Nullable : action hors contexte de compte.
  accountId  String?
  account    Account? @relation("AuditAccount", fields: [accountId], references: [id], onDelete: SetNull)
  /// Code court et stable de l'action, ex. "booking.time_entry.validated".
  action     String
  /// Type d'entité visée, ex. "TimeEntry", "ComplianceDocument", "Booking".
  entityType String
  /// Identifiant de l'entité visée (nullable pour les actions globales).
  entityId   String?
  /// Résumé lisible en français, affiché tel quel dans le back-office.
  summary    String
  /// Contexte libre (avant/après, motif…). Optionnel.
  metadata   Json?
  /// Adresse IP de l'appelant, si connue.
  ip         String?

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum GlobalRole {
  USER
  ADMIN
}
enum UserStatus {
  PENDING
  VERIFIED
  BANNED
  /// Compte anonymisé à la demande de la personne (droit à l'effacement, RGPD art. 17).
  /// Distinct de BANNED : ce n'est pas une sanction.
  ANONYMIZED
}

enum AccountType {
  ESTABLISHMENT
  FREELANCE
}
enum AccountRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}
enum MembershipStatus {
  ACTIVE
  SUSPENDED
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MissionCategory {
  RENFORT
  REMPLACEMENT
  ATELIER_EDUCATIF
  ATELIER_THERAPEUTIQUE
  FORMATION
  ANALYSE_PRATIQUES
}
enum MissionStatus {
  DRAFT
  PUBLISHED
  FILLED
  CLOSED
  CANCELLED
}
enum MissionVisibility {
  SALARIES
  RESERVED
  PUBLIC
}

/// COMMENT la mission est attribuée. Le choix appartient à l'établissement,
/// mission par mission — les deux modèles ont leur usage.
///
/// AUTOMATIQUE : premier arrivé, premier servi. Le premier intervenant qui
/// accepte a la mission, immédiatement, sans validation. C'est le plus rapide
/// et c'est ce qu'il faut pour un renfort de dernière minute.
///
/// FILE_ENGAGEMENT : l'intervenant s'engage (« je prends la mission »), son
/// profil est présenté à l'établissement qui accepte ou refuse. En cas de
/// refus, le suivant de la file est présenté, et ainsi de suite. Plus lent,
/// mais l'établissement garde la main sur QUI entre dans sa structure — ce qui
/// permet en retour de diffuser BEAUCOUP plus largement sans crainte.
enum ModeAttribution {
  AUTOMATIQUE
  FILE_ENGAGEMENT
}

/// À QUI l'offre est envoyée à la publication. Distinct de `visibility` :
/// la visibilité dit jusqu'où la cascade peut aller, la cible dit qui est
/// nommément destinataire. Toute cible autre que RESEAU VERROUILLE la
/// diffusion : ni élargissement automatique, ni apparition sur la marketplace.
enum CibleDiffusion {
  /// Diffusion normale en cascade (salariés -> réseau réservé -> public).
  RESEAU
  /// Uniquement les intervenants déjà venus ici ou retenus au vivier.
  CONNUS
  /// Uniquement les salariés rattachés à l'unité/service désigné.
  UNITE
  /// Uniquement les personnes explicitement cochées à la publication.
  SELECTION
}

/// Étapes d'un engagement dans la file (mode FILE_ENGAGEMENT).
enum EngagementStatut {
  /// L'intervenant s'est engagé, il attend son tour dans la file.
  EN_ATTENTE
  /// Son profil est actuellement soumis à l'établissement.
  PRESENTE
  /// L'établissement l'a retenu : la mission lui est attribuée.
  ACCEPTE
  /// L'établissement a écarté ce profil ; on passe au suivant.
  REFUSE
  /// L'intervenant s'est retiré de lui-même.
  RETIRE
  /// La mission a été attribuée à quelqu'un d'autre (ou annulée).
  CADUC
}

/// FILE D'ENGAGEMENT — un intervenant a dit « je prends la mission ».
///
/// Ce n'est pas une candidature (Booking REQUESTED) : la candidature est une
/// manifestation d'intérêt, l'engagement est une PRISE de la mission, dans
/// l'ordre d'arrivée. L'établissement ne trie pas un tas de dossiers, il
/// répond oui ou non à une personne à la fois — ce qui est à la fois beaucoup
/// plus rapide pour lui, et beaucoup plus respectueux pour les intervenants,
/// qui savent exactement où ils en sont.
model MissionEngagement {
  id         String        @id @default(cuid())
  missionId  String
  mission    ReliefMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// Compte intervenant qui s'engage.
  accountId  String
  account    Account       @relation("EngagementIntervenant", fields: [accountId], references: [id], onDelete: Cascade)
  /// Ordre d'arrivée dans la file. 1 = le premier à s'être engagé.
  rang       Int
  statut     EngagementStatut @default(EN_ATTENTE)
  /// Mot de l'intervenant à l'établissement (facultatif).
  message    String?
  /// Horodatage de la présentation du profil à l'établissement.
  presenteAt DateTime?
  /// Relance envoyée à l'établissement qui n'a pas tranché (une seule fois).
  relanceAt  DateTime?
  /// Horodatage de la décision (acceptation ou refus).
  decideAt   DateTime?
  /// Motif de refus, transmis tel quel à l'intervenant. On dit pourquoi :
  /// un refus sans raison démobilise plus sûrement qu'une mission perdue.
  motifRefus String?
  /// Réservation créée en cas d'acceptation.
  bookingId  String?       @unique
  booking    Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([missionId, accountId])
  @@index([missionId, statut])
  @@index([accountId])
}

enum ServiceCategory {
  ATELIER
  FORMATION
  MEDIATION
  ART_THERAPIE
  PREVENTION
}
enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// PLANNING / SHIFTS & DISPONIBILITÉS (matching + gestion d'équipe terrain)
// ---------------------------------------------------------------------------

/// GTA — demande de conge/absence d'un membre de l'etablissement,
/// validee par un responsable (OWNER/ADMIN/MANAGER).
model LeaveRequest {
  id         String      @id @default(cuid())
  accountId  String
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  type       LeaveType   @default(CONGE)
  debut      DateTime
  fin        DateTime
  motif      String?
  statut     LeaveStatus @default(EN_ATTENTE)
  decideurId String?
  decideLe   DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([accountId, statut])
  @@index([userId, debut])
}

enum LeaveType {
  CONGE
  RTT
  MALADIE
  SANS_SOLDE
  AUTRE
}

enum LeaveStatus {
  EN_ATTENTE
  APPROUVE
  REFUSE
}

/// Fenêtre de disponibilité d'un intervenant (récurrente hebdo OU date ponctuelle).
model Availability {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int?              // 0=dimanche .. 6=samedi (récurrent hebdo)
  date      DateTime?         // date précise (ponctuel)
  startTime String            // "09:00"
  endTime   String            // "17:00"
  type      AvailabilityType  @default(AVAILABLE)
  createdAt DateTime          @default(now())

  @@index([userId])
}

/// Créneau planifié (shift) : gestion du planning côté établissement.
model Shift {
  id             String      @id @default(cuid())
  accountId      String
  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  freelanceId    String?
  freelance      User?       @relation("ShiftFreelance", fields: [freelanceId], references: [id], onDelete: SetNull)
  missionId      String?
  mission        ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  /// SERVICE (unité) concerné par le créneau. C'est ce qui permet à un chef
  /// de service de voir son planning et non celui de tout l'établissement.
  /// Renseigné à la main, ou déduit du service auquel l'intervenant est
  /// rattaché quand on ne le précise pas.
  orgUnitId      String?
  orgUnit        OrgUnit?    @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  bookingId      String?     @unique
  booking        Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  title          String
  startAt        DateTime
  endAt          DateTime
  status         ShiftStatus @default(PLANNED)
  notes          String?
  recurrenceRule String?     // RRULE iCal optionnel (récurrence)

  // Dérogation aux plafonds de durée du travail. Renseignée uniquement quand
  // un responsable a choisi de passer outre un constat bloquant : c'est la
  // trace qui le couvre en cas de contrôle URSSAF ou inspection du travail.
  derogationMotif String?
  derogationCodes String[]   @default([])
  derogationLe    DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([accountId, startAt])
  @@index([freelanceId, startAt])
  @@index([orgUnitId, startAt])
}

enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
}

enum ShiftStatus {
  PLANNED
  CONFIRMED
  DONE
  CANCELLED
}

// ---------------------------------------------------------------------------
// CENTRE DE FORMATION (Qualiopi) — programme / session / inscription (P1)
// ---------------------------------------------------------------------------

/// PROGRAMME de formation. Catalogue ADePA (certifiant) OU interne etablissement.
model Formation {
  id                String          @id @default(cuid())
  type              FormationType   @default(CERTIFIANTE)
  ownerAccountId    String
  ownerAccount      Account         @relation("FormationOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  title             String
  slug              String          @unique
  summary           String?
  objectives        String?
  prerequisites     String?
  program           String?
  targetAudience    String?
  durationHours     Int?
  categoryId        String?
  categoryRef       Category?       @relation("FormationCategoryRef", fields: [categoryId], references: [id], onDelete: SetNull)
  cpfEligible       Boolean         @default(false)
  certifying        Boolean         @default(false)
  certificationName String?
  edofRef           String?
  /// Vitrine : sans image ni ville, une formation ne se vend pas en ligne.
  images            String[]        @default([])
  city              String?
  /// Contenu commercial repris du modèle des fiches atelier.
  methodology       String?
  evaluation        String?
  faq               Json?
  /// Compteurs de la fiche (preuve sociale et pilotage du funnel).
  views             Int             @default(0)
  requestsCount     Int             @default(0)
  status            FormationStatus @default(DRAFT)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sessions          FormationSession[]

  @@index([type, status])
  @@index([ownerAccountId])
}

/// SESSION : instance datee d'un programme.
model FormationSession {
  id            String        @id @default(cuid())
  formationId   String
  formation     Formation     @relation(fields: [formationId], references: [id], onDelete: Cascade)
  trainerId     String?
  trainer       User?         @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  hostAccountId String?
  hostAccount   Account?      @relation("SessionHost", fields: [hostAccountId], references: [id], onDelete: SetNull)
  title         String?
  startDate     DateTime
  endDate       DateTime?
  location      String?
  maxSeats      Int?
  priceHt       Decimal?      @db.Decimal(10, 2)
  status        SessionStatus @default(SCHEDULED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  inscriptions   Inscription[]
  emargements    Emargement[]
  qualiopiProofs QualiopiProof[]

  @@index([formationId, startDate])
  @@index([trainerId])
}

/// INSCRIPTION : un apprenant sur une session.
model Inscription {
  id             String            @id @default(cuid())
  sessionId      String
  session        FormationSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId      String?
  learner        User?             @relation("InscriptionLearner", fields: [learnerId], references: [id], onDelete: SetNull)
  learnerName    String?
  learnerEmail   String?
  payerAccountId String?
  payerAccount   Account?          @relation("InscriptionPayer", fields: [payerAccountId], references: [id], onDelete: SetNull)
  financing      FinancingType     @default(ESTABLISHMENT)
  status         InscriptionStatus @default(PENDING)
  /// EVALUATION A CHAUD — recueillie en fin de session.
  /// Indicateur 30 du referentiel national qualite : l'organisme recueille les
  /// appreciations des beneficiaires. Le champ existait ; rien ne le remplissait.
  satisfaction   Int?
  satisfactionComment String?
  satisfactionAt DateTime?
  /// Resultat de l'evaluation des acquis (indicateur 11).
  evalResult     String?
  /// EVALUATION A FROID — recueillie quelques mois apres, sur le terrain.
  /// C'est elle qui distingue un organisme audite d'un organisme qui remplit
  /// des cases : elle mesure ce qui reste une fois la salle quittee.
  coldRating     Int?
  /// Mise en oeuvre des acquis : OUI / PARTIELLEMENT / NON.
  coldTransfer   String?
  coldComment    String?
  coldAt         DateTime?
  attestationUrl String?
  certificatUrl  String?
  invoiceId      String?           @unique
  invoice        Invoice?          @relation("InscriptionInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  emargements    Emargement[]
  tutorat        Tutorat?

  @@index([sessionId, status])
  @@index([learnerId])
}

/// EMARGEMENT : presence signee par apprenant et par creneau.
model Emargement {
  id            String           @id @default(cuid())
  sessionId     String
  session       FormationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inscriptionId String
  inscription   Inscription      @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  slotDate      DateTime
  slot          EmargementSlot   @default(MORNING)
  present       Boolean          @default(false)
  signatureUrl  String?
  signedAt      DateTime?
  createdAt     DateTime         @default(now())

  @@unique([inscriptionId, slotDate, slot])
  @@index([sessionId])
}

enum FormationType {
  CERTIFIANTE
  INTERNE
}

enum FormationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  OPEN
  FULL
  RUNNING
  DONE
  CANCELLED
}

enum InscriptionStatus {
  PENDING
  CONFIRMED
  ATTENDED
  CERTIFIED
  CANCELLED
}

enum FinancingType {
  CPF
  OPCO
  ESTABLISHMENT
  PERSONAL
  POLE_EMPLOI
  INTERNE
}

enum EmargementSlot {
  MORNING
  AFTERNOON
}

// ---------------------------------------------------------------------------
// CONFORMITE QUALIOPI (7 criteres / 32 indicateurs + preuves) — Phase 3
// ---------------------------------------------------------------------------

/// Un des 7 criteres Qualiopi (donnees de reference, seedees).
model QualiopiCriterion {
  id         String              @id @default(cuid())
  number     Int                 @unique
  title      String
  indicators QualiopiIndicator[]
}

/// Un des 32 indicateurs, rattache a un critere (donnees de reference, seedees).
model QualiopiIndicator {
  id          String            @id @default(cuid())
  criterionId String
  criterion   QualiopiCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  number      Int               @unique
  label       String
  proofs      QualiopiProof[]

  @@index([criterionId])
}

/// PREUVE deposee par l'OF (ADePA) pour un indicateur.
model QualiopiProof {
  id          String            @id @default(cuid())
  indicatorId String
  indicator   QualiopiIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  ofAccountId String
  ofAccount   Account           @relation("QualiopiOf", fields: [ofAccountId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     FormationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  label       String?
  documentUrl String?
  status      ProofStatus       @default(TODO)
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([indicatorId, ofAccountId])
  @@index([ofAccountId, status])
}

// ---------------------------------------------------------------------------
// TUTORAT / ACCOMPAGNEMENT (tuteur, entretiens, jalons, projet d'avenir)
// ---------------------------------------------------------------------------

model Tutorat {
  id            String        @id @default(cuid())
  inscriptionId String        @unique
  inscription   Inscription   @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  tutorId       String
  tutor         User          @relation("TutoratTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  projetAvenir  String?
  status        TutoratStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  entretiens    Entretien[]
  jalons        Jalon[]

  @@index([tutorId])
}

model Entretien {
  id        String   @id @default(cuid())
  tutoratId String
  tutorat   Tutorat  @relation(fields: [tutoratId], references: [id], onDelete: Cascade)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([tutoratId])
}

model Jalon {
  id        String      @id @default(cuid())
  tutoratId String
  tutorat   Tutorat     @relation(fields: [tutoratId], references: [id], onDelete: Cascade)
  label     String
  dueDate   DateTime?
  status    JalonStatus @default(PENDING)
  createdAt DateTime    @default(now())

  @@index([tutoratId])
}

enum ProofStatus {
  TODO
  UPLOADED
  VALIDATED
  REJECTED
}

enum TutoratStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum JalonStatus {
  PENDING
  DONE
}

// ---------------------------------------------------------------------------
// COFFRE-FORT DE CONFORMITE — pieces obligatoires des intervenants (P3)
// CNI, casier judiciaire (B3), permis, IBAN/RIB, attestation auto-entrepreneur...
// Suivi par compte (etablissement ou freelance) avec statut + echeance.
// ---------------------------------------------------------------------------

/// Piece justificative reglementaire suivie pour un intervenant dans un compte.
model ComplianceDocument {
  id         String            @id @default(cuid())
  /// Le professionnel concerne par la piece.
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Le compte qui suit le dossier (etablissement ou freelance).
  accountId  String
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type       ComplianceDocType
  label      String?
  status     ComplianceStatus  @default(MISSING)
  /// Ancien mode : adresse web saisie à la main. Conservé pour l'existant.
  fileUrl    String?
  /// Nouveau mode : fichier réellement déposé dans le dépôt privé.
  fileId     String?
  file       FileAsset?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  issuedAt   DateTime?
  expiresAt  DateTime?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([userId, accountId, type])
  @@index([accountId])
  @@index([userId])
}

enum ComplianceDocType {
  IDENTITY
  /// Diplôme d'État (DEES, DEME, DEAES, DEEJE...). Pièce la plus regardée
  /// par un établissement : elle conditionne le poste, pas seulement l'accès.
  DIPLOMA
  CRIMINAL_RECORD
  DRIVING_LICENSE
  IBAN
  AUTOENTREPRENEUR
  VITALE
  OTHER
}

enum ComplianceStatus {
  MISSING
  PENDING
  VALID
  EXPIRED
}

/// Diplôme / formation du CV freelance (repris de Symfony : Qualification).
model Qualification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   // Intitulé du diplôme / de la formation
  organization String?  // École, organisme
  year         String?  // Année d'obtention (texte libre)
  createdAt    DateTime @default(now())

  @@index([userId])
}

/// Expérience professionnelle du CV freelance (repris de Symfony : Experience).
model Experience {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   // Poste / structure
  year        String?  // Période (texte libre)
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// Demande de contact publique (repris de Symfony : Contact / NewRequest).
model ContactRequest {
  id        String              @id @default(cuid())
  name      String
  email     String
  phone     String?
  type      String?             // Sujet / type de demande
  content   String
  status    ContactRequestStatus @default(NEW)
  /// Origine de la demande : utm_source, sinon domaine référent, sinon "direct".
  source    String?
  createdAt DateTime            @default(now())

  @@index([status, createdAt])
  @@index([source])
}

enum ContactRequestStatus {
  NEW
  HANDLED
}

/// Catégorie fonctionnelle d'un fichier déposé. Sert au contrôle d'accès :
/// une pièce de conformité n'obéit pas aux mêmes règles qu'un avatar.
enum FileKind {
  /// Coffre-fort : CNI, casier, diplôme, URSSAF, RIB, permis. Le plus sensible.
  COMPLIANCE
  /// Pièce jointe d'une mission de renfort (fiche de poste, protocole…).
  MISSION
  /// Photo de profil.
  AVATAR
  /// Support pédagogique, émargement signé, preuve Qualiopi.
  FORMATION
  /// Illustration d'une actualité. Seule famille lisible sans authentification :
  /// un article public doit afficher ses images à un visiteur non connecté.
  ARTICLE
  /// Modèle d'écrit déposé pour apprendre une trame maison. Contient de vrais
  /// noms de personnes accompagnées : accès restreint à son déposant et aux
  /// responsables du compte, jamais d'URL publique.
  TRAME
}

/// Un fichier réellement stocké (objet dans le dépôt privé), avec sa fiche
/// d'identité. Aucune URL publique : le téléchargement passe par l'API, qui
/// vérifie les droits à chaque requête.
model FileAsset {
  id           String    @id @default(cuid())
  /// Clé de l'objet dans le dépôt. Jamais devinable (identifiant aléatoire).
  storageKey   String    @unique
  /// Nom tel que déposé par la personne — sert uniquement à l'affichage
  /// et au nom du fichier téléchargé.
  originalName String
  mimeType     String
  /// Taille en octets.
  size         Int
  /// Empreinte SHA-256, pour détecter un doublon ou une altération.
  checksum     String
  kind         FileKind
  /// Qui a déposé le fichier.
  uploaderId   String?
  uploader     User?     @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  /// Compte dans le périmètre duquel le fichier a été déposé.
  accountId    String?
  account      Account?  @relation("FileAccount", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  complianceDocuments ComplianceDocument[]
  tramesMaison        TrameMaison[]        @relation("TrameSource")
  missions            ReliefMission[]
  documents           Document[]
  avatarOf            User[]               @relation("UserAvatar")

  @@index([uploaderId])
  @@index([accountId])
  @@index([kind])
}


/// Fiche mise de côté par un utilisateur.
/// Le cœur du site historique : un directeur repère trois ateliers en réunion
/// et y revient plus tard. Stocké côté serveur pour survivre au changement
/// d'appareil, contrairement à un simple stockage navigateur.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
}

/// LE VIVIER D'UN ETABLISSEMENT.
///
/// Ce qu'un chef de service veut d'abord, ce n'est pas trouver quelqu'un :
/// c'est retrouver la personne qui connait deja le groupe, les habitudes de la
/// maison et le prenom des jeunes. Le remplacement le moins couteux est celui
/// qu'on n'a pas a expliquer.
///
/// La plateforme savait deja calculer ce vivier — `intervenantsConnus()` liste
/// les comptes ayant deja travaille pour l'etablissement — mais uniquement en
/// interne, pour decider a qui diffuser une offre. Rien ne l'affichait, rien ne
/// permettait de l'enrichir, et surtout rien ne permettait de rappeler
/// quelqu'un directement.
///
/// Cette table porte la partie choisie du vivier : les intervenants qu'un
/// responsable a explicitement retenus, avec une note de service. Les habitues
/// detectes automatiquement s'y ajoutent a la lecture, sans etre stockes.
///
/// Choix assume : il n'existe PAS de liste noire symetrique. Un registre
/// d'intervenants « a eviter », invisible de l'interesse, serait un fichier de
/// reputation — lourd de consequences pour un professionnel dont c'est le
/// gagne-pain, et redevable du droit d'acces. Ne pas rappeler quelqu'un se
/// fait tres bien sans l'ecrire.
model PoolMember {
  id                   String   @id @default(cuid())
  /// L'etablissement qui tient le vivier.
  accountId            String
  account              Account  @relation("PoolEtablissement", fields: [accountId], references: [id], onDelete: Cascade)
  /// Le compte intervenant retenu.
  intervenantAccountId String
  intervenantAccount   Account  @relation("PoolIntervenant", fields: [intervenantAccountId], references: [id], onDelete: Cascade)
  /// Note de service : « connait le groupe des ados », « dispo le mercredi ».
  /// Visible de l'etablissement seul.
  note                 String?
  /// Qui l'a ajoute : utile quand plusieurs chefs de service partagent le compte.
  addedById            String?
  addedBy              User?    @relation("PoolAjoutePar", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([accountId, intervenantAccountId])
  @@index([accountId])
  @@index([intervenantAccountId])
}

/// LES REGLES DE TEMPS DE TRAVAIL DE L'ETABLISSEMENT.
///
/// Rien de ce qui figure ici n'est impose par la loi, et c'est la raison
/// d'etre de cette table. Dans le secteur social et medico-social, la SEULE
/// majoration legale est celle du 1er mai (article L. 3133-6). La nuit ouvre
/// un repos compensateur obligatoire mais une compensation salariale
/// seulement « le cas echeant » (L. 3122-8) ; le dimanche ne donne lieu a
/// aucune majoration legale, les ESSMS relevant d'une derogation permanente
/// au repos dominical (R. 3132-5) ; les dix feries autres que le 1er mai sont
/// travaillables sans majoration.
///
/// Ecrire ces taux en dur dans le code produirait des chiffrages faux pour
/// tous les etablissements — et faux dans le sens le plus dangereux : un cout
/// annonce qui ne correspond pas a ce qui sera paye. Chaque structure les lit
/// donc dans SA convention et les saisit ici.
model ParametresTemps {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Convention appliquee, a titre documentaire : CCN 51, CCN 66, CHRS, autre.
  convention String?
  /// Un accord d'entreprise existe-t-il ? Il commute tout le moteur entre la
  /// branche conventionnelle et la branche suppletive.
  accordEntreprise Boolean @default(false)

  // --- Nuit -----------------------------------------------------------------
  /// Plage de nuit. A defaut d'accord, la loi retient 21 h - 6 h (L. 3122-20).
  /// L'accord de branche du 17 avril 2002 demande 9 heures continues a
  /// positionner dans l'amplitude 21 h - 7 h.
  nuitDebutHeure Int @default(21)
  nuitFinHeure   Int @default(6)
  /// Majoration de nuit, en pourcentage. Zero par defaut : la loi n'en impose
  /// aucune, et inventer un taux serait pire que ne rien afficher.
  nuitPct        Decimal @default(0) @db.Decimal(5, 2)

  // --- Dimanche et feries ---------------------------------------------------
  dimanchePct Decimal @default(0) @db.Decimal(5, 2)
  feriePct    Decimal @default(0) @db.Decimal(5, 2)
  /// Cumul dimanche + ferie quand un ferie tombe un dimanche. La CCN 51
  /// l'exclut expressement (annexe III, art. A3.3).
  cumulDimancheEtFerie Boolean @default(false)

  // --- Droit local ----------------------------------------------------------
  /// Moselle, Bas-Rhin, Haut-Rhin : Saint-Etienne le 26 decembre.
  droitLocal Boolean @default(false)
  /// Le Vendredi saint n'est pas departemental mais COMMUNAL : l'article
  /// L. 3134-13 le reserve aux communes disposant d'un temple protestant ou
  /// d'une eglise mixte. Un simple drapeau Alsace-Moselle serait faux.
  vendrediSaint Boolean @default(false)

  // --- Heures supplementaires -----------------------------------------------
  /// Valeurs SUPPLETIVES (L. 3121-36 et D. 3121-24), pas d'ordre public : un
  /// accord peut les modifier, dans la limite du plancher de 10 % (L. 3121-33).
  majorationHS1Pct Decimal @default(25) @db.Decimal(5, 2)
  majorationHS2Pct Decimal @default(50) @db.Decimal(5, 2)
  seuilBasculeHS   Int     @default(8)
  contingentAnnuel Int     @default(220)

  // --- Annualisation --------------------------------------------------------
  /// Seuil de declenchement des heures supplementaires. 1607 h est un
  /// PLAFOND (L. 3121-41 ; Cass. soc. 11 mai 2016 n° 14-29.512) : un accord
  /// peut descendre en dessous, jamais monter au-dessus.
  seuilDeclenchementHS Int  @default(1607)
  /// Limite hebdomadaire haute de la modulation. L'accord de branche du
  /// 1er avril 1999 retient 44 h. Les heures au-dela sont supplementaires
  /// immediatement et NE sont PAS recomptees en fin de periode (L. 3121-44).
  limiteHebdoHaute Int?
  /// Limite basse de la modulation. L'accord de 1999 retient 21 h.
  limiteHebdoBasse Int?
  /// Delai de prevenance d'un changement d'horaire. 7 jours a defaut
  /// d'accord (L. 3121-47).
  delaiPrevenanceJours Int @default(7)

  // --- Conges du secteur ----------------------------------------------------
  /// Conges trimestriels : 18 jours pour le personnel educatif de la CCN 66,
  /// 9 pour l'administratif, 9 en CHRS. Ils reduisent le volume PLANIFIABLE
  /// sans modifier le seuil de declenchement des heures supplementaires —
  /// c'est la distinction la plus couteuse a rater.
  congesTrimestrielsEducatif Int @default(0)
  congesTrimestrielsAutres   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


/// Types d'écrits professionnels que l'assistant sait produire.
enum AssistantTrame {
  NOTE_OBSERVATION
  RAPPORT_SITUATION
  TRANSMISSION
  SYNTHESE_REUNION
  COMPTE_RENDU_ATELIER
  /// Courrier aux titulaires de l'autorité parentale : demande d'autorisation
  /// (sortie, séjour, soins, droit à l'image) motivée et assortie d'un
  /// coupon-réponse. L'écrit que les équipes repoussent le plus.
  COURRIER_AUTORITE_PARENTALE
  /// Courrier à un partenaire : référent ASE, MDPH, établissement scolaire,
  /// service de soin. Point de situation factuel et daté.
  COURRIER_PARTENAIRE
  /// Bilan de fin d'accompagnement : parcours, acquis, points de vigilance,
  /// relais proposés.
  BILAN_FIN_ACCOMPAGNEMENT
}

/// À qui profite une trame importée.
enum PorteeTrame {
  /// Visible de son seul auteur. Le cas de l'intervenant indépendant.
  PERSONNELLE
  /// Publiée par un responsable : toute l'équipe du compte la voit et
  /// l'utilise. C'est le levier d'homogénéité des écrits d'un établissement.
  ETABLISSEMENT
}

/// LA TRAME MAISON — le modèle d'écrit propre à un professionnel ou à un
/// établissement, appris à partir d'un document réel qu'il a déjà rendu.
///
/// Raison d'être : chaque MECS, chaque IME a ses intitulés, son ordre, ses
/// formules — imposés par la direction, par l'ASE ou par le juge. Un assistant
/// qui rend un texte dans SA structure à lui oblige à tout reprendre pour le
/// faire rentrer dans le modèle de la maison ; autant écrire directement.
/// C'est cette friction-là qui fait qu'un outil est essayé une fois puis
/// abandonné.
///
/// Ce qui est appris est un SQUELETTE : les intitulés de sections, leur ordre,
/// la longueur habituelle de chacune, le registre. Il est extrait du document
/// après pseudonymisation, et il est le seul élément renvoyé au modèle à
/// chaque génération — ce qui le rend court, donc peu coûteux.
model TrameMaison {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  nom       String
  /// Genre d'écrit auquel la trame se rattache (facultatif : une trame peut
  /// servir à plusieurs genres).
  genre     AssistantTrame?
  portee    PorteeTrame     @default(PERSONNELLE)
  /// Les intitulés et l'ordre des sections, tels qu'appris du modèle.
  squelette String
  /// Le registre : personne, temps, formules d'usage, longueurs attendues.
  style     String
  /// Court extrait ANONYMISÉ du modèle, pour que le moteur « entende » le ton.
  /// Jamais de nom : la pseudonymisation est passée avant l'extraction.
  extrait   String?
  /// Document d'origine, conservé dans le compte. Il porte de vrais noms :
  /// son accès suit les mêmes règles que le reste du dépôt (jamais d'URL
  /// publique, contrôle des droits à chaque téléchargement).
  sourceFileId String?
  sourceFile   FileAsset? @relation("TrameSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
  /// Compteur d'usage : sert à trier les trames utiles et à repérer les mortes.
  usages    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents AssistantDocument[]

  @@index([accountId, portee])
  @@index([authorId])
}

/// Écrit professionnel VALIDÉ par son auteur.
/// Volontairement, seul le document final est conservé : les notes brutes
/// dictées par l'éducateur ne sont jamais persistées — c'est la promesse
/// de confidentialité qui rend l'outil acceptable dans ce secteur.
model AssistantDocument {
  id        String         @id @default(cuid())
  accountId String
  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  trame     AssistantTrame
  /// Trame maison utilisée pour produire ce document, le cas échéant.
  trameMaisonId String?
  trameMaison   TrameMaison? @relation(fields: [trameMaisonId], references: [id], onDelete: SetNull)
  title     String
  /// Contenu final, relu et validé par l'auteur (les vrais noms y figurent :
  /// il reste dans le compte de l'établissement, jamais envoyé à un tiers).
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([accountId, createdAt])
  @@index([authorId])
}

/// Retour utilisateur sur une génération (pouce haut/bas + commentaire).
/// C'est ce qui permet d'améliorer les trames, et une preuve de suivi
/// sérieuse à présenter aux directions.
model AssistantFeedback {
  id        String   @id @default(cuid())
  accountId String
  userId    String
  trame     AssistantTrame
  utile     Boolean
  comment   String?
  createdAt DateTime @default(now())

  @@index([trame, utile])
}

/// Motif d'attribution de points de fidélité.
enum PointReason {
  /// Toute première fiche créée par le compte : petit coup de pouce au
  /// démarrage, versé une seule fois dans la vie du compte.
  PREMIERE_FICHE
  /// Une fiche atelier/formation publiée.
  PUBLICATION
  /// Un article publié sur l'Édublog.
  ARTICLE
  /// Une mission ou un atelier réalisé.
  MISSION
  /// Un avis positif reçu (4 ou 5 étoiles).
  AVIS
  /// Une idée retenue dans la boîte à idées.
  IDEE
  /// Une réponse apportée à un pair dans l'Entraide.
  REPONSE
  /// Une réponse désignée comme utile par l'auteur de la question.
  REPONSE_RETENUE
  /// Filleul parraine qui termine sa premiere mission (verse aux deux).
  PARRAINAGE
  /// Ajustement manuel par un administrateur.
  MANUEL
  /// Points dépensés en réduction.
  DEPENSE
}

/// Historique des points : chaque ligne explique un mouvement de solde.
model LoyaltyPoint {
  id        String      @id @default(cuid())
  accountId String
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Positif = gagné, négatif = dépensé.
  amount    Int
  reason    PointReason
  label     String
  createdAt DateTime    @default(now())

  @@index([accountId, createdAt])
}

enum IdeaStatus {
  NEW
  PLANNED
  DONE
  DECLINED
}

/// Boîte à idées : les utilisateurs proposent, votent, l'équipe arbitre.
model Idea {
  id        String     @id @default(cuid())
  accountId String
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId  String
  title     String
  content   String
  status    IdeaStatus @default(NEW)
  /// Réponse publique de l'équipe.
  reply     String?
  votes     IdeaVote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

model IdeaVote {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([ideaId, userId])
}


/// ─────────────────────────────────────────────────────────────────────────
/// ENTRAIDE — questions de terrain entre professionnels, par métier.
///
/// Une question n'est pas un sujet, c'est une SITUATION : ce qui se passe,
/// et ce qui a déjà été tenté. Les prénoms sont masqués à l'enregistrement :
/// on parle de personnes accompagnées réelles.
/// ─────────────────────────────────────────────────────────────────────────

enum QuestionStatus {
  /// En attente de réponses.
  OUVERTE
  /// L'auteur a désigné une réponse comme utile.
  RESOLUE
  /// Fermée par l'auteur ou l'équipe (hors sujet, doublon).
  FERMEE
}

model Question {
  id          String         @id @default(cuid())
  /// La situation, formulée en « comment faites-vous quand… ».
  title       String
  /// Le contexte détaillé : ce qui se passe, depuis quand, avec qui.
  situation   String
  /// Ce que le professionnel a déjà tenté — évite les réponses évidentes.
  tente       String?
  /// Métier de l'auteur (éducateur spécialisé, AES, psychologue…).
  metier      String
  /// Public accompagné (enfance protégée, handicap, grand âge…).
  publicVise  String
  /// Publication sous pseudonyme : le nom du compte n'est pas affiché.
  anonyme     Boolean        @default(true)
  status      QuestionStatus @default(OUVERTE)
  views       Int            @default(0)

  accountId   String
  account     Account        @relation("AccountQuestions", fields: [accountId], references: [id], onDelete: Cascade)
  authorId    String
  author      User           @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  answers     Answer[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([metier])
  @@index([publicVise])
}

model Answer {
  id          String    @id @default(cuid())
  questionId  String
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content     String
  anonyme     Boolean   @default(true)
  /// Désignée comme utile par l'auteur de la question.
  retenue     Boolean   @default(false)

  accountId   String
  account     Account   @relation("AccountAnswers", fields: [accountId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  votes       AnswerVote[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([questionId])
}

model AnswerVote {
  id        String   @id @default(cuid())
  answerId  String
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("AnswerVoter", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([answerId, userId])
}

/// Abonnement d'un navigateur aux notifications push (Web Push).
/// Un utilisateur peut en avoir plusieurs : téléphone, tablette, poste de travail.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// URL du service de push du navigateur (Google, Mozilla, Apple…). Identifiant unique de l'appareil.
  endpoint  String   @unique
  /// Clé publique de l'appareil, pour chiffrer le message.
  p256dh    String
  /// Sel d'authentification fourni par le navigateur.
  auth      String
  /// Libellé lisible, pour que la personne reconnaisse son appareil.
  appareil  String?
  /// Dernier envoi réussi : sert à repérer les abonnements morts.
  dernierOk DateTime?
  /// Nombre d'échecs consécutifs. Au-delà d'un seuil, on supprime.
  echecs    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Réglages techniques persistés (clés VAPID…). Une ligne par clé.
/// Évite de dépendre d'une variable d'environnement à poser à la main.
model Reglage {
  cle       String   @id
  valeur    String
  majLe     DateTime @updatedAt
}

/// CONTRAT À DURÉE DÉTERMINÉE.
///
/// Pivot du modèle : l'établissement est l'EMPLOYEUR, la plateforme ne fournit
/// personne. Ce modèle porte le contrat que l'établissement conclut lui-même
/// avec l'intervenant — d'où `accountId` = employeur et `userId` = salarié,
/// sans aucune notion de commission ni de facturation de mission.
model ContratCDD {
  id                          String   @id @default(cuid())
  /// Établissement employeur. C'est lui qui signe et qui est responsable.
  accountId                   String
  account                     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Salarié embauché.
  userId                      String
  user                        User     @relation("ContratSalarie", fields: [userId], references: [id], onDelete: Cascade)
  /// Besoin de renfort à l'origine du recrutement, si le contrat en vient.
  missionId                   String?
  mission                     ReliefMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  // — Mentions obligatoires, art. L. 1242-12 du code du travail —
  motif                       MotifRecoursCDD
  salarieRemplaceNom          String?
  salarieRemplaceQualification String?
  dateDebut                   DateTime
  /// Terme précis. Nul quand le contrat est à terme imprécis.
  dateFin                     DateTime?
  /// Durée minimale, obligatoire quand le terme est imprécis.
  dureeMinimaleJours          Int?
  poste                       String?
  qualification               String?
  /// Le poste figure-t-il sur la liste des postes à risques particuliers ?
  posteARisques               Boolean?
  conventionCollective        String?  @default("CCN 66")
  remunerationBrute           Decimal? @db.Decimal(10, 2)
  remunerationDetail          String?
  caisseRetraiteComplementaire String?
  organismePrevoyance         String?
  periodeEssaiJours           Int?

  // — Cycle de vie —
  statut                      StatutContratCDD @default(BROUILLON)
  /// Déclaration préalable à l'embauche : au plus tôt 8 jours avant.
  dpaeEffectueeLe             DateTime?
  dpaeReference               String?
  /// Transmission au salarié : 2 jours ouvrables (art. L. 1242-13).
  transmisLe                  DateTime?
  signeSalarieLe              DateTime?
  signeEmployeurLe            DateTime?
  /// Cause de fin, qui décide de l'indemnité de précarité (art. L. 1243-10).
  causeFin                    String?
  termineLe                   DateTime?

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([accountId, dateDebut])
  @@index([userId, dateDebut])
  @@index([statut])
}

enum MotifRecoursCDD {
  REMPLACEMENT_SALARIE_ABSENT
  REMPLACEMENT_ATTENTE_ENTREE
  REMPLACEMENT_POSTE_SUPPRIME
  ACCROISSEMENT_TEMPORAIRE
}

enum StatutContratCDD {
  BROUILLON
  TRANSMIS
  SIGNE
  ACTIF
  TERMINE
  ROMPU
}


/// SIGNATURE ELECTRONIQUE — le faisceau de preuves.
///
/// Ce que produit ce module est une signature electronique SIMPLE au sens du
/// reglement eIDAS, assortie d'un faisceau de preuves. Elle est parfaitement
/// valable : l'article 1367 du code civil reconnait la signature electronique
/// des lors que le procede identifie son auteur et garantit son lien avec
/// l'acte. Ce qu'elle n'est pas, et il faut le dire sans detour : une
/// signature AVANCEE ou QUALIFIEE. La difference ne tient pas a la validite
/// mais a la charge de la preuve — devant un conseil de prud'hommes, c'est
/// celui qui invoque la signature simple qui doit demontrer sa fiabilite.
///
/// D'ou ce que l'on stocke : l'empreinte du document au moment de la demande,
/// un code a usage unique envoye par courriel et verifie, l'horodatage,
/// l'adresse IP, le navigateur, et un journal d'evenements append-only. C'est
/// exactement ce qu'un juge regarde.
///
/// Le champ `prestataire` prepare la delegation a un tiers de confiance
/// (signature avancee) sans rien changer au reste du logiciel : la variable
/// d'environnement SIGNATURE_PRESTATAIRE bascule le module.
model Signature {
  id           String            @id @default(cuid())
  documentType TypeDocumentSigne
  /// Identifiant du document signe : contrat, proposition, devis.
  documentId   String
  /// Compte a l'origine de la demande.
  accountId    String
  account      Account           @relation("SignatureCompte", fields: [accountId], references: [id], onDelete: Cascade)

  /// Le signataire. `userId` est nul quand la personne n'a pas de compte.
  userId          String?
  user            User?    @relation("SignatureSignataire", fields: [userId], references: [id], onDelete: SetNull)
  signataireNom   String
  signataireEmail String

  /// Empreinte SHA-256 du document au moment de la demande. C'est elle qui
  /// prouve qu'on a signe CE texte et pas un autre : toute modification
  /// ulterieure la rend fausse.
  empreinte String

  /// Code a usage unique, stocke HACHE — jamais en clair. Meme un acces a la
  /// base ne permet pas de signer a la place de quelqu'un.
  codeHache    String?
  codeExpireLe DateTime?
  tentatives   Int       @default(0)

  statut  StatutSignature @default(EN_ATTENTE)
  signeLe DateTime?
  refuseLe DateTime?
  motifRefus String?

  /// Elements du faisceau de preuves, releves au moment de la signature.
  ip        String?
  userAgent String?

  /// Nul pour la signature interne ; nom du tiers de confiance sinon.
  prestataire    String?
  prestataireRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evenements SignatureEvenement[]

  @@index([documentType, documentId])
  @@index([accountId, statut])
  @@index([signataireEmail])
}

/// Journal d'une signature : append-only, jamais modifie ni supprime.
/// C'est la chronologie que l'on presente en cas de contestation.
model SignatureEvenement {
  id          String    @id @default(cuid())
  signatureId String
  signature   Signature @relation(fields: [signatureId], references: [id], onDelete: Cascade)
  /// DEMANDE, CODE_ENVOYE, CODE_ERRONE, SIGNEE, REFUSEE, EXPIREE, ANNULEE.
  type        String
  detail      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([signatureId, createdAt])
}

enum TypeDocumentSigne {
  CONTRAT_CDD
  PROPOSITION
  DEVIS
}

enum StatutSignature {
  EN_ATTENTE
  SIGNEE
  REFUSEE
  EXPIREE
  ANNULEE
}

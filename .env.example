# --- Base de données ---
DATABASE_URL="postgresql://lesextras:lesextras@localhost:5432/lesextras?schema=public"
# --- Auth ---
JWT_SECRET="change-me-in-prod"
SESSION_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="7d"
# --- API ---
API_PORT=3001
API_BASE_URL="http://localhost:3001/api"
# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
WEB_PORT=3000
# --- Mail (invitations, notifications) ---
MAIL_DSN="smtp://user:pass@smtp.hostinger.com:587"
MAIL_FROM="LES EXTRAS <no-reply@les-extras.fr>"
# --- Uploads ---
UPLOAD_DIR="./uploads"
# --- Mesure des campagnes publicitaires (facultatif) ---
# Tant que NEXT_PUBLIC_GOOGLE_ADS_ID est vide, AUCUN traceur n'est chargé :
# le bandeau cookies reste une simple information et la page /legal/cookies
# affiche « aucun traceur publicitaire ». Dès que l'identifiant est posé, le
# bandeau devient un vrai gestionnaire de consentement (Accepter / Refuser,
# refus par défaut, choix révocable) et le tag n'est chargé qu'après un oui.
# Les deux valeurs se lisent dans Google Ads → Objectifs → Conversions.
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_INSCRIPTION=""
